---
import Layout from "../layouts/Layout.astro";

const stack = [
  "Astro",
  "TypeScript",
  "Tailwind CSS",
  "Markdown / MDX",
  "Git",
  "Nginx",
];

const interests = [
  {
    index: "01",
    title: "Web Development",
    description:
      "持续学习现代 Web 开发，关注页面体验、工程结构与性能。",
  },
  {
    index: "02",
    title: "Projects",
    description:
      "通过真实项目验证想法，把学习过程变成可以长期维护的作品。",
  },
  {
    index: "03",
    title: "Writing",
    description:
      "把技术、项目与思考整理成文章，让零散经验变得更清晰。",
  },
];

const timeline = [
  {
    label: "START",
    title: "开始建立个人博客",
    description:
      "使用 Astro 搭建自己的内容空间，并逐步完善文章、分类、标签与归档。",
  },
  {
    label: "BUILD",
    title: "持续完善工程与部署",
    description:
      "补充 SEO、RSS、Sitemap、HTTPS、Nginx 静态部署以及跨设备兼容。",
  },
  {
    label: "NOW",
    title: "Anime Soft Tech",
    description:
      "正在继续升级博客的视觉表现，让技术感、二次元氛围和阅读体验自然融合。",
  },
];
---

<Layout
  title="关于"
  description="关于 FJK，以及这个博客正在记录的事情。"
>
  <section class="about-hero">
    <div
      class="hero-background"
      aria-hidden="true"
    >
      <picture>
        <source
          media="(max-width: 700px)"
          srcset="/images/anime/hero/hero-800.webp"
        />

        <source
          media="(max-width: 1200px)"
          srcset="/images/anime/hero/hero-1200.webp"
        />

        <img
          src="/images/anime/hero/hero-1600.webp"
          alt=""
        />
      </picture>

      <div class="hero-tint"></div>
      <div class="hero-fade"></div>

      <div
        class="hero-holo"
        aria-hidden="true"
      ></div>
    </div>

    <div class="about-hero-inner">
      <div class="hero-copy">
        <div class="hero-badge">
          <span
            class="badge-dot"
            aria-hidden="true"
          ></span>

          <span>
            ABOUT FJK
          </span>
        </div>

        <p class="hero-kicker">
          Hello again.
        </p>

        <h1>
          关于我，
          <span>
            也关于这个空间。
          </span>
        </h1>

        <p class="hero-description">
          我是 FJK。这里是我的个人博客，
          用来记录技术学习、项目实践、工具使用，
          以及一些值得长期留下来的内容。
        </p>

        <div class="hero-actions">
          <a
            class="primary-action"
            href="/blog"
          >
            阅读文章

            <span aria-hidden="true">
              →
            </span>
          </a>

          <a
            class="secondary-action"
            href="/projects"
          >
            查看项目
          </a>
        </div>
      </div>

      <div
        class="identity-area"
        aria-hidden="true"
      >
        <div class="identity-orbit orbit-one"></div>
        <div class="identity-orbit orbit-two"></div>

        <div class="identity-card">
          <div class="identity-holo"></div>

          <div class="identity-card-top">
            <span>
              PROFILE
            </span>

            <span>
              2026
            </span>
          </div>

          <div class="identity-avatar">
            <span>
              F
            </span>
          </div>

          <div class="identity-name">
            <strong>
              FJK
            </strong>

            <span>
              Developer / Creator
            </span>
          </div>

          <div class="identity-grid">
            <div>
              <span>
                FOCUS
              </span>

              <strong>
                WEB
              </strong>
            </div>

            <div>
              <span>
                STYLE
              </span>

              <strong>
                SOFT TECH
              </strong>
            </div>

            <div>
              <span>
                BLOG
              </span>

              <strong>
                FJKSP.CN
              </strong>
            </div>

            <div>
              <span>
                STATUS
              </span>

              <strong>
                BUILDING
              </strong>
            </div>
          </div>
        </div>

        <span class="identity-star star-one">
          ✦
        </span>

        <span class="identity-star star-two">
          ✧
        </span>
      </div>
    </div>
  </section>

  <section class="about-section intro-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          WHO I AM
        </p>

        <h2>
          一个持续学习和构建的人
        </h2>
      </div>
    </div>

    <div class="intro-grid">
      <div class="intro-main">
        <p class="intro-lead">
          我喜欢通过实际项目学习新东西。
        </p>

        <p>
          相比只把知识停留在笔记里，
          我更希望把它们真正做出来：
          写成页面、完成一个功能、部署到服务器，
          然后不断修正和完善。
        </p>

        <p>
          FJK Blog 也是这个过程的一部分。
          它既是一个内容网站，也是一个长期维护的个人项目。
        </p>
      </div>

      <div class="intro-note">
        <span class="note-mark">
          ✦
        </span>

        <p>
          “记录不是结束，
          而是把一次学习变成下一次进步的起点。”
        </p>

        <small>
          FJK BLOG / NOTE
        </small>
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          INTERESTS
        </p>

        <h2>
          我正在关注的方向
        </h2>

        <p class="section-description">
          目前博客里的内容，也基本围绕这些方向展开。
        </p>
      </div>
    </div>

    <div class="interest-grid">
      {
        interests.map((item) => (
          <article class="interest-card">
            <div
              class="card-holo"
              aria-hidden="true"
            ></div>

            <div class="interest-index">
              {item.index}
            </div>

            <div>
              <h3>
                {item.title}
              </h3>

              <p>
                {item.description}
              </p>
            </div>

            <span
              class="interest-arrow"
              aria-hidden="true"
            >
              ↗
            </span>
          </article>
        ))
      }
    </div>
  </section>

  <section class="about-section">
    <div class="stack-panel">
      <div
        class="stack-glow"
        aria-hidden="true"
      ></div>

      <div class="stack-copy">
        <p class="section-eyebrow">
          CURRENT STACK
        </p>

        <h2>
          目前使用的技术
        </h2>

        <p>
          这个博客本身就是主要的实验场，
          我会尽量保持结构简单、可维护，
          同时逐步尝试新的 Web 技术。
        </p>
      </div>

      <div class="stack-list">
        {
          stack.map(
            (item, index) => (
              <div class="stack-item">
                <span>
                  {String(
                    index + 1
                  ).padStart(
                    2,
                    "0"
                  )}
                </span>

                <strong>
                  {item}
                </strong>
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          JOURNEY
        </p>

        <h2>
          博客正在发生的事情
        </h2>
      </div>
    </div>

    <div class="timeline">
      {
        timeline.map(
          (item, index) => (
            <article class="timeline-item">
              <div class="timeline-rail">
                <span class="timeline-dot"></span>

                {
                  index !==
                    timeline.length -
                      1 && (
                    <i></i>
                  )
                }
              </div>

              <div class="timeline-card">
                <span class="timeline-label">
                  {item.label}
                </span>

                <h3>
                  {item.title}
                </h3>

                <p>
                  {item.description}
                </p>
              </div>
            </article>
          )
        )
      }
    </div>
  </section>

  <section class="about-section">
    <div class="closing-card">
      <div
        class="closing-holo"
        aria-hidden="true"
      ></div>

      <div class="closing-copy">
        <p class="section-eyebrow">
          KEEP BUILDING
        </p>

        <h2>
          这个博客还会继续变化。
        </h2>

        <p>
          新文章、新项目和新的想法都会慢慢加入。
          不追求一次完成，而是持续把它变得更好。
        </p>
      </div>

      <div class="closing-actions">
        <a
          class="primary-action"
          href="/blog"
        >
          去看看文章

          <span aria-hidden="true">
            →
          </span>
        </a>

        <a
          class="secondary-action"
          href="/projects"
        >
          查看项目
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    position: relative;

    min-height: 680px;

    margin:
      0 calc(
        50% - 50vw
      );

    overflow: hidden;

    border-bottom:
      1px solid
      var(--border);

    isolation: isolate;
  }

  .hero-background {
    position: absolute;

    z-index: -3;

    inset: 0;

    overflow: hidden;

    pointer-events: none;
  }

  .hero-background picture,
  .hero-background img {
    width: 100%;
    height: 100%;

    display: block;
  }

  .hero-background img {
    object-fit: cover;

    object-position:
      center 43%;

    transform:
      scale(1.03);

    filter:
      saturate(0.88)
      brightness(1.02);
  }

  .hero-tint,
  .hero-fade,
  .hero-holo {
    position: absolute;

    inset: 0;

    pointer-events: none;
  }

  .hero-tint {
    z-index: 1;

    background:
      linear-gradient(
        110deg,
        color-mix(
          in srgb,
          var(--background) 94%,
          transparent
        ) 0%,
        color-mix(
          in srgb,
          var(--background) 77%,
          transparent
        ) 38%,
        color-mix(
          in srgb,
          var(--background) 24%,
          transparent
        ) 78%,
        transparent 100%
      );
  }

  .hero-fade {
    z-index: 2;

    background:
      linear-gradient(
        180deg,
        transparent 42%,
        color-mix(
          in srgb,
          var(--background) 30%,
          transparent
        ) 69%,
        var(--background) 100%
      );
  }

  .hero-holo {
    z-index: 3;

    background-image:
      url(
        "/images/anime/effects/holo.webp"
      );

    background-position: center;
    background-size: cover;

    mix-blend-mode:
      soft-light;

    opacity: 0.035;
  }

  :global(html.dark)
  .hero-background img {
    filter:
      brightness(0.55)
      saturate(0.76);
  }

  :global(html.dark)
  .hero-tint {
    background:
      linear-gradient(
        110deg,
        rgba(
          16,
          17,
          26,
          0.97
        ) 0%,
        rgba(
          16,
          17,
          26,
          0.86
        ) 40%,
        rgba(
          16,
          17,
          26,
          0.35
        ) 80%,
        transparent 100%
      );
  }

  .about-hero-inner {
    width:
      min(
        calc(
          100% - 48px
        ),
        1180px
      );

    min-height: 680px;

    margin:
      0 auto;

    padding:
      84px 0 88px;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(330px, 0.72fr);

    align-items: center;

    gap: 72px;
  }

  .about-hero-inner > * {
    min-width: 0;
  }

  .hero-copy {
    position: relative;

    z-index: 4;
  }

  .hero-badge {
    width: fit-content;

    padding:
      7px 11px;

    display: inline-flex;

    align-items: center;

    gap: 8px;

    border:
      1px solid
      var(--border);

    border-radius: 999px;

    background:
      color-mix(
        in srgb,
        var(--color-surface) 76%,
        transparent
      );

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    backdrop-filter:
      blur(12px);

    -webkit-backdrop-filter:
      blur(12px);

    font-size: 10px;
    font-weight: 800;

    letter-spacing:
      0.14em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        var(--color-cyan) 15%,
        transparent
      );
  }

  .hero-kicker {
    margin:
      24px 0 0;

    color:
      var(--color-primary);

    font-size: 14px;
    font-weight: 700;
  }

  .hero-copy h1 {
    max-width: 720px;

    margin:
      13px 0 0;

    font-size:
      clamp(
        50px,
        7vw,
        80px
      );

    line-height: 1.04;

    letter-spacing:
      -0.06em;

    word-break: keep-all;
  }

  .hero-copy h1 span {
    display: block;

    background:
      linear-gradient(
        100deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color: transparent;
  }

  .hero-description {
    max-width: 610px;

    margin:
      25px 0 0;

    color:
      var(--text-secondary);

    font-size: 16px;
    line-height: 1.9;
  }

  .hero-actions,
  .closing-actions {
    margin-top: 31px;

    display: flex;
    flex-wrap: wrap;

    gap: 11px;
  }

  .primary-action,
  .secondary-action {
    min-height: 46px;

    padding:
      0 18px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 10px;

    border-radius: 13px;

    font-size: 12px;
    font-weight: 650;

    transition:
      transform
        var(--transition-fast),
      border-color
        var(--transition-fast),
      box-shadow
        var(--transition-fast);
  }

  .primary-action {
    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-primary) 48%,
        transparent
      );

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary)
      );

    color: #ffffff;

    box-shadow:
      0 12px 26px
      color-mix(
        in srgb,
        var(--color-primary) 22%,
        transparent
      );
  }

  .primary-action:hover {
    color: #ffffff;

    transform:
      translateY(-2px);

    box-shadow:
      0 17px 34px
      color-mix(
        in srgb,
        var(--color-primary) 29%,
        transparent
      );
  }

  .secondary-action {
    border:
      1px solid
      var(--border);

    background:
      color-mix(
        in srgb,
        var(--color-surface) 80%,
        transparent
      );

    color:
      var(--text-primary);

    backdrop-filter:
      blur(10px);
  }

  .secondary-action:hover {
    color:
      var(--color-primary);

    transform:
      translateY(-2px);

    border-color:
      var(--border-strong);
  }

  /* =========================
     Identity
     ========================= */

  .identity-area {
    position: relative;

    z-index: 4;

    min-height: 440px;

    display: flex;

    align-items: center;
    justify-content: center;
  }

  .identity-card {
    position: relative;

    z-index: 3;

    width:
      min(
        100%,
        355px
      );

    padding: 22px;

    overflow: hidden;

    border:
      1px solid
      var(--glass-border);

    border-radius: 27px;

    background:
      color-mix(
        in srgb,
        var(--glass-background) 86%,
        transparent
      );

    box-shadow:
      0 28px 78px
      rgba(
        20,
        20,
        50,
        0.18
      );

    backdrop-filter:
      blur(18px);

    -webkit-backdrop-filter:
      blur(18px);

    transform:
      rotate(2deg);
  }

  .identity-holo {
    position: absolute;

    inset: 0;

    background-image:
      url(
        "/images/anime/effects/holo.webp"
      );

    background-size: cover;

    mix-blend-mode:
      soft-light;

    opacity: 0.07;

    pointer-events: none;
  }

  .identity-card-top {
    position: relative;

    z-index: 2;

    display: flex;

    align-items: center;
    justify-content: space-between;

    color:
      var(--text-muted);

    font-size: 8px;
    font-weight: 800;

    letter-spacing:
      0.13em;
  }

  .identity-avatar {
    position: relative;

    z-index: 2;

    width: 92px;
    height: 92px;

    margin:
      34px auto 0;

    padding: 5px;

    border:
      1px solid
      var(--border);

    border-radius: 30px;

    background:
      var(--color-primary-soft);
  }

  .identity-avatar span {
    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 24px;

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    color: #ffffff;

    font-size: 36px;
    font-weight: 800;
  }

  .identity-name {
    position: relative;

    z-index: 2;

    margin-top: 16px;

    display: flex;

    align-items: center;

    flex-direction: column;

    gap: 4px;
  }

  .identity-name strong {
    font-size: 25px;
  }

  .identity-name span {
    color:
      var(--text-secondary);

    font-size: 9px;

    letter-spacing:
      0.09em;
  }

  .identity-grid {
    position: relative;

    z-index: 2;

    margin-top: 29px;

    display: grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap: 8px;
  }

  .identity-grid div {
    min-width: 0;

    padding: 11px;

    display: flex;

    flex-direction: column;

    gap: 4px;

    border:
      1px solid
      var(--border);

    border-radius: 12px;

    background:
      color-mix(
        in srgb,
        var(--color-surface) 70%,
        transparent
      );
  }

  .identity-grid span {
    color:
      var(--text-muted);

    font-size: 7px;
  }

  .identity-grid strong {
    font-size: 9px;
  }

  .identity-orbit {
    position: absolute;

    border:
      1px dashed
      color-mix(
        in srgb,
        var(--color-primary) 27%,
        transparent
      );

    border-radius: 50%;
  }

  .orbit-one {
    width: 390px;
    height: 390px;

    transform:
      rotate(20deg);
  }

  .orbit-two {
    width: 310px;
    height: 310px;

    transform:
      rotate(-26deg);
  }

  .identity-star {
    position: absolute;

    z-index: 5;

    color:
      var(--color-primary);
  }

  .star-one {
    right: 4px;
    top: 72px;

    font-size: 24px;
  }

  .star-two {
    left: 12px;
    bottom: 75px;

    color:
      var(--color-pink);

    font-size: 19px;
  }

  /* =========================
     Sections
     ========================= */

  .about-section {
    min-width: 0;

    padding:
      82px 0;

    border-bottom:
      1px solid
      var(--border);
  }

  .about-section:last-child {
    border-bottom: 0;
  }

  .section-eyebrow {
    margin:
      0 0 9px;

    color:
      var(--color-primary);

    font-size: 10px;
    font-weight: 800;

    letter-spacing:
      0.15em;
  }

  .section-heading h2,
  .stack-copy h2,
  .closing-copy h2 {
    margin: 0;

    font-size:
      clamp(
        30px,
        4vw,
        42px
      );

    letter-spacing:
      -0.045em;
  }

  .section-description {
    margin:
      11px 0 0;

    color:
      var(--text-secondary);

    line-height: 1.75;
  }

  /* =========================
     Intro
     ========================= */

  .intro-grid {
    margin-top: 34px;

    display: grid;

    grid-template-columns:
      minmax(0, 1.25fr)
      minmax(300px, 0.75fr);

    align-items: start;

    gap: 48px;
  }

  .intro-main {
    min-width: 0;

    color:
      var(--text-secondary);

    font-size: 15px;
    line-height: 1.95;
  }

  .intro-main p {
    margin:
      0 0 19px;
  }

  .intro-lead {
    color:
      var(--text-primary);

    font-size: 22px;
    font-weight: 650;

    line-height: 1.6;
  }

  .intro-note {
    position: relative;

    padding: 26px;

    overflow: hidden;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-primary) 18%,
        var(--border)
      );

    border-radius: 20px;

    background:
      linear-gradient(
        135deg,
        var(--color-primary-soft),
        color-mix(
          in srgb,
          var(--color-pink) 5%,
          var(--color-surface)
        )
      );

    box-shadow:
      var(--shadow-sm);
  }

  .note-mark {
    color:
      var(--color-primary);

    font-size: 20px;
  }

  .intro-note p {
    margin:
      17px 0 0;

    color:
      var(--text-primary);

    font-size: 16px;
    line-height: 1.8;
  }

