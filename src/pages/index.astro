---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const latestPosts = posts.slice(0, 4);
---

<Layout>
  <section class="hero">
    <p class="eyebrow">PERSONAL BLOG</p>

    <h1>你好，我是 FJK。</h1>

    <p class="description">
      这里记录我的技术学习、项目实践、工具使用，
      以及一些值得留下来的想法。
    </p>

    <div class="actions">
      <a class="primary" href="/blog">阅读文章</a>
      <a class="secondary" href="/about">关于我</a>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">BLOG</p>

        <h2>最新文章</h2>

        <p class="description">
          技术笔记、项目记录和学习过程都会整理在这里。
        </p>
      </div>

      <a href="/blog">查看全部 →</a>
    </div>

    <div class="post-grid">
      {
        latestPosts.map((post) => (
          <article class="post-card">
            <a href={`/blog/${post.id}/`}>
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("zh-CN")}
                </time>

                <span>{post.data.category}</span>
              </div>

              <h3>{post.data.title}</h3>

              <p>{post.data.description}</p>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section projects">
    <p class="eyebrow">PROJECTS</p>

    <h2>项目</h2>

    <p class="description">
      一些我正在开发或者已经完成的项目。
    </p>

    <a class="project-card" href="/projects">
      <div>
        <small>Featured Project</small>

        <h3>Personal Blog</h3>

        <p>
          使用 Astro、TypeScript 和 Tailwind CSS 构建的个人博客。
        </p>
      </div>

      <span>→</span>
    </a>
  </section>
</Layout>

<style>
  .hero {
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(48px, 8vw, 82px);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .description {
    max-width: 620px;
    margin: 20px 0 0;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .hero .description {
    margin-top: 28px;
    font-size: 18px;
  }

  .actions {
    margin-top: 34px;
    display: flex;
    gap: 12px;
  }

  .primary,
  .secondary {
    min-height: 44px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
  }

  .primary {
    background: var(--text-primary);
    color: white;
  }

  .secondary {
    border: 1px solid var(--border);
  }

  .section {
    padding: 72px 0;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .section h2 {
    margin: 0;
    font-size: 28px;
    letter-spacing: -0.03em;
  }

  .post-grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .post-card {
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .post-card > a {
    height: 100%;
    padding: 28px;
    display: block;
  }

  .post-meta {
    display: flex;
    gap: 12px;
    color: var(--text-secondary);
    font-size: 12px;
  }

  .post-card h3 {
    margin: 12px 0 8px;
    font-size: 20px;
  }

  .post-card p {
    margin: 0;
    color: var(--text-secondary);
  }

  .projects {
    border-top: 1px solid var(--border);
  }

  .project-card {
    margin-top: 36px;
    padding: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-radius: 12px;
    background: var(--surface);
  }

  .project-card small,
  .project-card p {
    color: var(--text-secondary);
  }

  .project-card h3 {
    margin: 8px 0;
    font-size: 24px;
  }

  .project-card p {
    margin: 0;
  }

  .project-card > span {
    font-size: 26px;
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 440px;
    }

    .hero h1 {
      font-size: clamp(44px, 14vw, 64px);
    }

    .section-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>