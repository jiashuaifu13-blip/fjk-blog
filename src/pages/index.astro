    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        var(--color-cyan)
          15%,
        transparent
      );
  }

  .hero-kicker {
    margin:
      24px 0 0;

    color:
      var(--color-primary);

    font-size:
      14px;

    font-weight:
      700;

    letter-spacing:
      0.04em;
  }

  .hero h1 {
    max-width:
      700px;

    margin:
      14px 0 0;

    font-size:
      clamp(
        52px,
        7vw,
        84px
      );

    line-height:
      1.03;

    letter-spacing:
      -0.06em;
  }

  .hero h1 span {
    display:
      block;

    background:
      linear-gradient(
        100deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;
  }

  .hero-description {
    max-width:
      620px;

    margin:
      26px 0 0;

    color:
      var(--text-secondary);

    font-size:
      17px;

    line-height:
      1.9;
  }

  .hero-actions {
    margin-top:
      34px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      12px;
  }

  .hero-primary,
  .hero-secondary {
    min-height:
      48px;

    padding:
      0 20px;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      12px;

    border-radius:
      14px;

    font-size:
      14px;

    font-weight:
      650;

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      background-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .hero-primary {
    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-primary)
          55%,
        transparent
      );

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary)
      );

    color:
      #ffffff;

    box-shadow:
      0 12px 28px
      color-mix(
        in srgb,
        var(--color-primary)
          24%,
        transparent
      );
  }

  .hero-primary:hover {
    color:
      #ffffff;

    transform:
      translateY(-3px);

    box-shadow:
      0 18px 36px
      color-mix(
        in srgb,
        var(--color-primary)
          32%,
        transparent
      );
  }

  .button-arrow {
    transition:
      transform
        var(--transition-fast);
  }

  .hero-primary:hover
  .button-arrow {
    transform:
      translateX(3px);
  }

  .hero-secondary {
    border:
      1px solid
      var(--border);

    background:
      var(--color-surface);

    color:
      var(--text-primary);

    box-shadow:
      var(--shadow-sm);
  }

  .hero-secondary:hover {
    color:
      var(--color-primary);

    border-color:
      var(--border-strong);

    background:
      var(--color-surface-elevated);

    transform:
      translateY(-3px);
  }

  .hero-meta {
    margin-top:
      42px;

    padding-top:
      26px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      34px;

    border-top:
      1px solid
      var(--border);
  }

  .hero-meta div {
    display:
      flex;

    flex-direction:
      column;

    gap:
      3px;
  }

  .hero-meta strong {
    font-size:
      15px;

    font-weight:
      700;
  }

  .hero-meta span {
    color:
      var(--text-muted);

    font-size:
      11px;

    text-transform:
      uppercase;

    letter-spacing:
      0.08em;
  }

  .hero-visual {
    position:
      relative;

    min-height:
      470px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;
  }

  .visual-card {
    position:
      relative;

    z-index:
      3;

    width:
      min(
        100%,
        420px
      );

    padding:
      24px;

    overflow:
      hidden;

    border:
      1px solid
      var(--glass-border);

    border-radius:
      28px;

    background:
      linear-gradient(
        145deg,
        color-mix(
          in srgb,
          var(--glass-background)
            92%,
          var(--color-primary)
            8%
        ),
        var(--glass-background)
      );

    box-shadow:
      0 30px 80px
      color-mix(
        in srgb,
        var(--color-primary)
          16%,
        transparent
      );

    backdrop-filter:
      blur(
        var(--glass-blur)
      );

    -webkit-backdrop-filter:
      blur(
        var(--glass-blur)
      );

    transform:
      rotate(-2deg);
  }

  .visual-card::before {
    content: "";

    position:
      absolute;

    width:
      230px;

    height:
      230px;

    top:
      -110px;

    right:
      -80px;

    border-radius:
      50%;

    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--color-pink)
            32%,
          transparent
        ),
        transparent 68%
      );
  }

  .visual-card::after {
    content: "";

    position:
      absolute;

    width:
      240px;

    height:
      240px;

    bottom:
      -130px;

    left:
      -100px;

    border-radius:
      50%;

    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--color-cyan)
            28%,
          transparent
        ),
        transparent 68%
      );
  }

  .visual-card-top {
    position:
      relative;

    z-index:
      2;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;
  }

  .visual-status {
    padding:
      5px 8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    color:
      var(--color-primary);

    font-size:
      9px;

    font-weight:
      800;

    letter-spacing:
      0.12em;
  }

  .visual-code {
    color:
      var(--text-muted);

    font-size:
      10px;

    letter-spacing:
      0.1em;
  }

  .visual-center {
    position:
      relative;

    z-index:
      2;

    min-height:
      210px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    flex-direction:
      column;

    gap:
      18px;
  }

  .visual-avatar {
    width:
      96px;

    height:
      96px;

    padding:
      5px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      30px;

    background:
      linear-gradient(
        135deg,
        var(--color-primary-soft),
        color-mix(
          in srgb,
          var(--color-pink)
            18%,
          transparent
        )
      );

    box-shadow:
      inset
      0 1px 0
      rgba(
        255,
        255,
        255,
        0.3
      );
  }

  .visual-avatar span {
    width:
      100%;

    height:
      100%;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border-radius:
      24px;

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    color:
      #ffffff;

    font-size:
      38px;

    font-weight:
      800;

    box-shadow:
      0 14px 30px
      color-mix(
        in srgb,
        var(--color-primary)
          28%,
        transparent
      );
  }

  .visual-title {
    display:
      flex;

    align-items:
      center;

    flex-direction:
      column;

    gap:
      4px;
  }

  .visual-title span {
    font-size:
      26px;

    font-weight:
      800;

    letter-spacing:
      -0.04em;
  }

  .visual-title small {
    color:
      var(--text-secondary);

    font-size:
      10px;

    letter-spacing:
      0.12em;

    text-transform:
      uppercase;
  }

  .visual-grid {
    position:
      relative;

    z-index:
      2;

    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      8px;
  }

  .visual-grid div {
    padding:
      12px;

    display:
      flex;

    flex-direction:
      column;

    gap:
      5px;

    border:
      1px solid
      var(--border);

    border-radius:
      13px;

    background:
      color-mix(
        in srgb,
        var(--color-surface)
          72%,
        transparent
      );
  }

  .visual-grid span {
    color:
      var(--text-muted);

    font-size:
      8px;

    letter-spacing:
      0.12em;
  }

  .visual-grid strong {
    color:
      var(--text-primary);

    font-size:
      10px;

    letter-spacing:
      0.04em;
  }

  .visual-orbit {
    position:
      absolute;

    border:
      1px dashed
      color-mix(
        in srgb,
        var(--color-primary)
          24%,
        transparent
      );

    border-radius:
      50%;
  }

  .orbit-one {
    width:
      420px;

    height:
      420px;

    transform:
      rotate(18deg);
  }

  .orbit-two {
    width:
      330px;

    height:
      330px;

    transform:
      rotate(-28deg);
  }

  .visual-star {
    position:
      absolute;

    z-index:
      4;

    color:
      var(--color-primary);

    text-shadow:
      0 0 20px
      color-mix(
        in srgb,
        var(--color-primary)
          60%,
        transparent
      );
  }

  .star-one {
    top:
      46px;

    right:
      20px;

    font-size:
      26px;
  }

  .star-two {
    bottom:
      50px;

