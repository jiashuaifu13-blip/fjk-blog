---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow">
        PERSONAL BLOG
      </p>

      <h1>
        你好，我是 FJK。
      </h1>

      <p class="hero-description">
        这里记录我的技术学习、项目实践、工具使用，
        以及一些值得留下来的想法。
      </p>

      <div class="hero-actions">
        <a class="primary-button" href="/blog">
          阅读文章
        </a>

        <a class="secondary-button" href="/about">
          关于我
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="section-label">
          BLOG
        </p>

        <h2 class="section-title">
          最新文章
        </h2>

        <p class="section-description">
          技术笔记、项目记录和学习过程都会整理在这里。
        </p>
      </div>

      <a class="section-link" href="/blog">
        查看全部 →
      </a>
    </div>

    <div class="post-grid">
      <article class="post-card">
        <p class="post-meta">
          即将发布
        </p>

        <h3>
          我的第一篇博客文章
        </h3>

        <p>
          博客文章系统将在下一阶段完成。
        </p>
      </article>

      <article class="post-card">
        <p class="post-meta">
          即将发布
        </p>

        <h3>
          Astro 博客开发记录
        </h3>

        <p>
          记录这个个人博客从零开始构建的完整过程。
        </p>
      </article>
    </div>
  </section>

  <section class="section project-section">
    <div>
      <p class="section-label">
        PROJECTS
      </p>

      <h2 class="section-title">
        项目
      </h2>

      <p class="section-description">
        一些我正在开发或者已经完成的项目。
      </p>
    </div>

    <a class="project-preview" href="/projects">
      <div>
        <p class="project-type">
          Featured Project
        </p>

        <h3>
          Personal Blog
        </h3>

        <p>
          使用 Astro、TypeScript 和 Tailwind CSS
          构建的个人博客。
        </p>
      </div>

      <span>
        →
      </span>
    </a>
  </section>
</Layout>

<style>
  .hero {
    min-height: 520px;

    display: flex;

    align-items: center;

    border-bottom: 1px solid var(--border);
  }

  .hero-content {
    max-width: 760px;
  }

  .hero-eyebrow,
  .section-label {
    margin: 0 0 14px;

    color: var(--text-secondary);

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 0.14em;
  }

  .hero h1 {
    max-width: 720px;

    margin: 0;

    font-size: clamp(48px, 8vw, 82px);

    line-height: 1;

    letter-spacing: -0.055em;
  }

  .hero-description {
    max-width: 620px;

    margin: 28px 0 0;

    color: var(--text-secondary);

    font-size: 18px;

    line-height: 1.8;
  }

  .hero-actions {
    margin-top: 34px;

    display: flex;

    flex-wrap: wrap;

    gap: 12px;
  }

  .primary-button,
  .secondary-button {
    min-height: 44px;

    padding: 0 18px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    border-radius: 8px;

    font-size: 14px;

    font-weight: 600;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .primary-button {
    background: var(--text-primary);

    color: white;
  }

  .primary-button:hover {
    transform: translateY(-1px);
  }

  .secondary-button {
    border: 1px solid var(--border);

    background: white;
  }

  .secondary-button:hover {
    background: var(--surface);
  }

  .section-heading {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 32px;
  }

  .section-link {
    flex-shrink: 0;

    color: var(--text-secondary);

    font-size: 14px;
  }

  .section-link:hover {
    color: var(--text-primary);
  }

  .post-grid {
    margin-top: 36px;

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 18px;
  }

  .post-card {
    padding: 28px;

    border: 1px solid var(--border);

    border-radius: 12px;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-2px);

    border-color: #c9c9c9;
  }

  .post-meta {
    margin: 0;

    color: var(--text-secondary);

    font-size: 12px;
  }

  .post-card h3 {
    margin: 12px 0 8px;

    font-size: 20px;

    letter-spacing: -0.02em;
  }

  .post-card > p:last-child {
    margin: 0;

    color: var(--text-secondary);
  }

  .project-section {
    border-top: 1px solid var(--border);
  }

  .project-preview {
    margin-top: 36px;

    padding: 32px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 32px;

    border-radius: 12px;

    background: var(--surface);

    transition: transform 0.2s ease;
  }

  .project-preview:hover {
    transform: translateY(-2px);
  }

  .project-preview h3 {
    margin: 8px 0;

    font-size: 24px;
  }

  .project-preview p {
    margin: 0;

    color: var(--text-secondary);
  }

  .project-preview span {
    font-size: 26px;
  }

  .project-type {
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 440px;
    }

    .hero h1 {
      font-size: clamp(44px, 14vw, 64px);
    }

    .hero-description {
      font-size: 16px;
    }

    .section-heading {
      align-items: flex-start;

      flex-direction: column;

      gap: 18px;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }

    .project-preview {
      padding: 24px;
    }
  }
</style>