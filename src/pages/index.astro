---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );

const latestPosts = posts.slice(0, 4);

const featuredPost = latestPosts[0];

const secondaryPosts = latestPosts.slice(1);

const categoryMap = new Map<string, number>();

for (const post of posts) {
  categoryMap.set(
    post.data.category,
    (categoryMap.get(post.data.category) ?? 0) + 1
  );
}

const categories = Array.from(
  categoryMap.entries()
).map(([name, count]) => ({
  name,
  count,
}));
---

<Layout
  title="首页"
  description="FJK 的个人博客，记录技术、项目、学习与生活。"
>
  <section class="hero">
    <div
      class="hero-art"
      aria-hidden="true"
    >
      <picture>
        <source
          media="(max-width: 700px)"
          srcset="/images/anime/hero/hero-800.webp"
        />

        <source
          media="(max-width: 1100px)"
          srcset="/images/anime/hero/hero-1200.webp"
        />

        <source
          media="(max-width: 1600px)"
          srcset="/images/anime/hero/hero-1600.webp"
        />

        <img
          src="/images/anime/hero/hero-1920.webp"
          alt=""
          loading="eager"
          fetchpriority="high"
        />
      </picture>

      <div class="hero-art-tint"></div>
      <div class="hero-art-fade"></div>
      <div class="hero-art-bottom"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-badge">
          <span
            class="badge-dot"
            aria-hidden="true"
          ></span>

          <span>
            PERSONAL BLOG
          </span>
        </div>

        <p class="hero-kicker">
          Hello, I'm FJK
        </p>

        <h1>
          记录代码，
          <span>
            也记录生活。
          </span>
        </h1>

        <p class="hero-description">
          这里记录我的技术学习、项目实践、
          工具使用，以及一些值得长期留下来的想法。
        </p>

        <div class="hero-actions">
          <a
            class="hero-primary"
            href="/blog"
          >
            <span>
              阅读文章
            </span>

            <span
              class="button-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>

          <a
            class="hero-secondary"
            href="/about"
          >
            关于我
          </a>
        </div>

        <div class="hero-meta">
          <div>
            <strong>
              {posts.length}
            </strong>

            <span>
              篇文章
            </span>
          </div>

          <div>
            <strong>
              {categories.length}
            </strong>

            <span>
              个分类
            </span>
          </div>

          <div>
            <strong>
              Astro
            </strong>

            <span>
              Powered
            </span>
          </div>
        </div>
      </div>

      <div
        class="hero-visual"
        aria-hidden="true"
      >
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>

        <div class="visual-star star-one">
          ✦
        </div>

        <div class="visual-star star-two">
          ✧
        </div>

        <div class="visual-card">
          <div class="visual-card-shine"></div>

          <div class="visual-card-top">
            <span class="visual-status">
              ONLINE
            </span>

            <span class="visual-code">
              2026
            </span>
          </div>

          <div class="visual-center">
            <div class="visual-avatar">
              <span>
                F
              </span>
            </div>

            <div class="visual-title">
              <span>
                FJK
              </span>

              <small>
                Anime Soft Tech
              </small>
            </div>
          </div>

          <div class="visual-grid">
            <div>
              <span>
                MODE
              </span>

              <strong>
                CREATIVE
              </strong>
            </div>

            <div>
              <span>
                STACK
              </span>

              <strong>
                ASTRO
              </strong>
            </div>

            <div>
              <span>
                STATUS
              </span>

              <strong>
                BUILDING
              </strong>
            </div>

            <div>
              <span>
                SPACE
              </span>

              <strong>
                FJKSP.CN
              </strong>
            </div>
          </div>
        </div>

        <div class="visual-label visual-label-left">
          BLOG / DEV
        </div>

        <div class="visual-label visual-label-right">
          ✦ KEEP CREATING
        </div>
      </div>
    </div>

    <div
      class="hero-scroll-hint"
      aria-hidden="true"
    >
      <span>
        SCROLL
      </span>

      <i></i>
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          LATEST STORIES
        </p>

        <h2>
          最近更新
        </h2>

        <p class="section-description">
          技术笔记、项目记录和学习过程，
          都会慢慢整理在这里。
        </p>
      </div>

      <a
        class="section-link"
        href="/blog"
      >
        全部文章

        <span aria-hidden="true">
          →
        </span>
      </a>
    </div>

    {
      featuredPost && (
        <article class="featured-post">
          <div
            class="card-holo card-holo-featured"
            aria-hidden="true"
          ></div>

          <a
            class="featured-post-link"
            href={`/blog/${featuredPost.id}/`}
          >
            <div class="featured-cover">
              {
                featuredPost.data.cover ? (
                  <img
                    src={featuredPost.data.cover}
                    alt={
                      featuredPost.data.coverAlt ??
                      featuredPost.data.title
                    }
                  />
                ) : (
                  <div class="cover-placeholder">
                    <span>
                      FJK
                    </span>
                  </div>
                )
              }

              <div class="featured-cover-shade"></div>

              <div class="featured-cover-badge">
                FEATURED
              </div>
            </div>

            <div class="featured-content">
              <div class="post-meta">
                <time
                  datetime={
                    featuredPost.data.date.toISOString()
                  }
                >
                  {
                    featuredPost.data.date.toLocaleDateString(
                      "zh-CN"
                    )
                  }
                </time>

                <span class="meta-dot">
                  ·
                </span>

                <span>
                  {featuredPost.data.category}
                </span>
              </div>

              <h3>
                {featuredPost.data.title}
              </h3>

              <p>
                {featuredPost.data.description}
              </p>

              {
                featuredPost.data.tags.length > 0 && (
                  <div class="tag-list">
                    {
                      featuredPost.data.tags
                        .slice(0, 4)
                        .map((tag) => (
                          <span>
                            #{tag}
                          </span>
                        ))
                    }
                  </div>
                )
              }

              <div class="featured-read">
                <span>
                  阅读文章
                </span>

                <span
                  class="featured-arrow"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>
            </div>
          </a>
        </article>
      )
    }

    {
      secondaryPosts.length > 0 && (
        <div class="post-grid">
          {
            secondaryPosts.map((post) => (
              <article class="post-card">
                <div
                  class="card-holo"
                  aria-hidden="true"
                ></div>

                <a
                  href={`/blog/${post.id}/`}
                >
                  {
                    post.data.cover && (
                      <div class="post-cover-wrapper">
                        <img
                          class="post-cover"
                          src={post.data.cover}
                          alt={
                            post.data.coverAlt ??
                            post.data.title
                          }
                          loading="lazy"
                        />

                        <div class="post-cover-shade"></div>
                      </div>
                    )
                  }

                  <div class="post-card-content">
                    <div class="post-meta">
                      <time
                        datetime={
                          post.data.date.toISOString()
                        }
                      >
                        {
                          post.data.date.toLocaleDateString(
                            "zh-CN"
                          )
                        }
                      </time>

                      <span class="meta-dot">
                        ·
                      </span>

                      <span>
                        {post.data.category}
                      </span>
                    </div>

                    <h3>
                      {post.data.title}
                    </h3>

                    <p>
                      {post.data.description}
                    </p>

                    {
                      post.data.tags.length > 0 && (
                        <div class="tag-list">
                          {
                            post.data.tags
                              .slice(0, 3)
                              .map((tag) => (
                                <span>
                                  #{tag}
                                </span>
                              ))
                          }
                        </div>
                      )
                    }
                  </div>
                </a>
              </article>
            ))
          }
        </div>
      )
    }
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          EXPLORE
        </p>

        <h2>
          分类探索
        </h2>

        <p class="section-description">
          从不同方向找到感兴趣的内容。
        </p>
      </div>
    </div>

    <div class="category-grid">
      {
        categories.map((category, index) => (
          <a
            class="category-card"
            href={`/blog/category/${encodeURIComponent(
              category.name
            )}/`}
          >
            <div
              class="category-holo"
              aria-hidden="true"
            ></div>

            <div class="category-index">
              {String(index + 1).padStart(2, "0")}
            </div>

            <div class="category-copy">
              <h3>
                {category.name}
              </h3>

              <p>
                {category.count}
                {" "}
                篇文章
              </p>
            </div>

            <span
              class="category-arrow"
              aria-hidden="true"
            >
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <div class="project-showcase">
      <div
        class="project-holo"
        aria-hidden="true"
      ></div>

      <div
        class="project-glow"
        aria-hidden="true"
      ></div>

      <div class="project-copy">
        <p class="section-eyebrow">
          FEATURED PROJECT
        </p>

        <h2>
          FJK Blog
        </h2>

        <p>
          从零开始构建并持续维护的个人博客。
          使用 Astro、TypeScript 和 Tailwind CSS，
          记录技术、项目、学习与生活。
        </p>

        <div class="project-stack">
          <span>
            Astro 7
          </span>

          <span>
            TypeScript
          </span>

          <span>
            Tailwind CSS 4
          </span>

          <span>
            Nginx
          </span>
        </div>

        <div class="project-actions">
          <a
            class="project-primary"
            href="/projects"
          >
            查看项目
          </a>

          <a
            class="project-secondary"
            href="https://github.com/jiashuaifu13-blip/fjk-blog"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        </div>
      </div>

      <div
        class="project-panel"
        aria-hidden="true"
      >
        <div class="project-window">
          <div class="project-window-shine"></div>

          <div class="project-window-bar">
            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <span>
              fjk-blog
            </span>
          </div>

          <div class="project-code">
            <p>
              <span class="code-muted">
                $
              </span>
              npm run build
            </p>

            <p class="code-success">
              ✓ Astro static build
            </p>

            <p class="code-success">
              ✓ RSS / Sitemap
            </p>

            <p class="code-success">
              ✓ Anime Soft Tech
            </p>

            <p>
              <span class="code-accent">
                https://
              </span>
              fjksp.cn
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position:
      relative;

    min-height:
      720px;

    margin:
      0 calc(
        50% - 50vw
      );

    overflow:
      hidden;

    border-bottom:
      1px solid
      var(--border);

    isolation:
      isolate;
  }

  .hero-art {
    position:
      absolute;

    z-index:
      -4;

    inset:
      0;

    overflow:
      hidden;

    pointer-events:
      none;
  }

  .hero-art picture,
  .hero-art img {
    width:
      100%;

    height:
      100%;

    display:
      block;
  }

  .hero-art img {
    object-fit:
      cover;

    object-position:
      center 43%;

    transform:
      scale(1.025);

    filter:
      saturate(0.92)
      contrast(0.98)
      brightness(1.04);
  }

  .hero-art-tint,
  .hero-art-fade,
  .hero-art-bottom {
    position:
      absolute;

    inset:
      0;

    pointer-events:
      none;
  }

  .hero-art-tint {
    z-index:
      1;

    background:
      linear-gradient(
        120deg,
        color-mix(
          in srgb,
          var(--background)
            72%,
          transparent
        )
          0%,
        color-mix(
          in srgb,
          var(--background)
            54%,
          transparent
        )
          38%,
        color-mix(
          in srgb,
          var(--color-primary)
            8%,
          transparent
        )
          72%,
        color-mix(
          in srgb,
          var(--color-pink)
            7%,
          transparent
        )
          100%
      );
  }

  .hero-art-fade {
    z-index:
      2;

    background:
      linear-gradient(
        90deg,
        color-mix(
          in srgb,
          var(--background)
            96%,
          transparent
        )
          0%,
        color-mix(
          in srgb,
          var(--background)
            87%,
          transparent
        )
          25%,
        color-mix(
          in srgb,
          var(--background)
            52%,
          transparent
        )
          52%,
        color-mix(
          in srgb,
          var(--background)
            10%,
          transparent
        )
          78%,
        transparent
          100%
      );
  }

  .hero-art-bottom {
    z-index:
      3;

    background:
      linear-gradient(
        180deg,
        transparent
          48%,
        color-mix(
          in srgb,
          var(--background)
            20%,
          transparent
        )
          72%,
        color-mix(
          in srgb,
          var(--background)
            88%,
          transparent
        )
          100%
      );
  }

  :global(html.dark)
  .hero-art img {
    filter:
      brightness(0.58)
      saturate(0.78)
      contrast(1.04);
  }

  :global(html.dark)
  .hero-art-tint {
    background:
      linear-gradient(
        120deg,
        rgba(
          16,
          17,
          26,
          0.94
        )
          0%,
        rgba(
          16,
          17,
          26,
          0.78
        )
          34%,
        rgba(
          34,
          29,
          61,
          0.42
        )
          67%,
        rgba(
          79,
          47,
          83,
          0.23
        )
          100%
      );
  }

  :global(html.dark)
  .hero-art-fade {
    background:
      linear-gradient(
        90deg,
        rgba(
          16,
          17,
          26,
          0.98
        )
          0%,
        rgba(
          16,
          17,
          26,
          0.92
        )
          29%,
        rgba(
          16,
          17,
          26,
          0.63
        )
          55%,
        rgba(
          16,
          17,
          26,
          0.16
        )
          82%,
        transparent
          100%
      );
  }

  .hero-inner {
    width:
      min(
        calc(
          100% - 48px
        ),
        1180px
      );

    min-height:
      720px;

    margin:
      0 auto;

    padding:
      72px 0 88px;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(330px, 0.75fr);

    align-items:
      center;

    gap:
      72px;
  }

  .hero-inner > * {
    min-width:
      0;
  }

  .hero-copy {
    position:
      relative;

    z-index:
      4;

    min-width:
      0;
  }

  .hero-badge {
    width:
      fit-content;

    padding:
      7px 11px;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--border)
          72%,
        rgba(
          255,
          255,
          255,
          0.3
        )
      );

    border-radius:
      999px;

    background:
      color-mix(
        in srgb,
        var(--color-surface)
          74%,
        transparent
      );

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    backdrop-filter:
      blur(12px);

    -webkit-backdrop-filter:
      blur(12px);

    font-size:
      10px;

    font-weight:
      700;

    letter-spacing:
      0.14em;
  }

  .badge-dot {
    width:
      6px;

    height:
      6px;

    flex-shrink:
      0;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        var(--color-cyan)
          15%,
        transparent
      );
  }

  .hero-kicker {
    margin:
      24px 0 0;

    color:
      var(--color-primary);

    font-size:
      14px;

    font-weight:
      700;

    letter-spacing:
      0.04em;

    word-break:
      normal;
  }

  .hero h1 {
    max-width:
      700px;

    margin:
      14px 0 0;

    font-size:
      clamp(
        52px,
        7vw,
        84px
      );

    line-height:
      1.03;

    letter-spacing:
      -0.06em;

    word-break:
      keep-all;

    text-shadow:
      0 2px 20px
      color-mix(
        in srgb,
        var(--background)
          38%,
        transparent
      );
  }

  .hero h1 span {
    display:
      block;

    background:
      linear-gradient(
        100deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;
  }

  .hero-description {
    max-width:
      610px;

    margin:
      26px 0 0;

    color:
      var(--text-secondary);

    font-size:
      17px;

    line-height:
      1.9;
  }

  .hero-actions {
    margin-top:
      34px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      12px;
  }

  .hero-primary,
  .hero-secondary {
    min-height:
      48px;

    padding:
      0 20px;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      12px;

    border-radius:
      14px;

    font-size:
      14px;

    font-weight:
      650;

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      background-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .hero-primary {
    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-primary)
          55%,
        transparent
      );

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary)
      );

    color:
      #ffffff;

    box-shadow:
      0 12px 28px
      color-mix(
        in srgb,
        var(--color-primary)
          24%,
        transparent
      );
  }

  .hero-primary:hover {
    color:
      #ffffff;

    transform:
      translateY(-3px);

    box-shadow:
      0 18px 36px
      color-mix(
        in srgb,
        var(--color-primary)
          32%,
        transparent
      );
  }

  .button-arrow {
    transition:
      transform
        var(--transition-fast);
  }

  .hero-primary:hover
  .button-arrow {
    transform:
      translateX(3px);
  }

  .hero-secondary {
    border:
      1px solid
      color-mix(
        in srgb,
        var(--border)
          80%,
        rgba(
          255,
          255,
          255,
          0.3
        )
      );

    background:
      color-mix(
        in srgb,
        var(--color-surface)
          76%,
        transparent
      );

    color:
      var(--text-primary);

    box-shadow:
      var(--shadow-sm);

    backdrop-filter:
      blur(12px);

    -webkit-backdrop-filter:
      blur(12px);
  }

  .hero-secondary:hover {
    color:
      var(--color-primary);

    border-color:
      var(--border-strong);

    transform:
      translateY(-3px);
  }

  .hero-meta {
    margin-top:
      42px;

    padding-top:
      26px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      34px;

    border-top:
      1px solid
      color-mix(
        in srgb,
        var(--border)
          80%,
        transparent
      );
  }

  .hero-meta div {
    min-width:
      0;

    display:
      flex;

    flex-direction:
      column;

    gap:
      3px;
  }

  .hero-meta strong {
    font-size:
      15px;

    font-weight:
      700;
  }

  .hero-meta span {
    color:
      var(--text-muted);

    font-size:
      11px;

    text-transform:
      uppercase;

    letter-spacing:
      0.08em;
  }

  .hero-visual {
    position:
      relative;

    z-index:
      4;

    min-width:
      0;

    min-height:
      470px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;
  }

  .visual-card {
    position:
      relative;

    z-index:
      3;

    width:
      min(
        100%,
        365px
      );

    min-width:
      0;

    padding:
      22px;

    overflow:
      hidden;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--glass-border)
          82%,
        rgba(
          255,
          255,
          255,
          0.28
        )
      );

    border-radius:
      27px;

    background:
      linear-gradient(
        145deg,
        color-mix(
          in srgb,
          var(--glass-background)
            80%,
          var(--color-primary)
            8%
        ),
        color-mix(
          in srgb,
          var(--glass-background)
            86%,
          transparent
        )
      );

    box-shadow:
      0 30px 80px
      rgba(
        20,
        20,
        50,
        0.2
      );

    backdrop-filter:
      blur(18px);

    -webkit-backdrop-filter:
      blur(18px);

    transform:
      translateY(36px)
      rotate(-2deg);
  }

  .visual-card-shine {
    position:
      absolute;

    inset:
      0;

    z-index:
      -1;

    background-image:
      url(
        "/images/anime/effects/holo.webp"
      );

    background-size:
      cover;

    background-position:
      center;

    mix-blend-mode:
      soft-light;

    opacity:
      0.08;

    pointer-events:
      none;
  }

  .visual-card::before,
  .visual-card::after {
    content:
      "";

    position:
      absolute;

    border-radius:
      50%;
  }

  .visual-card::before {
    width:
      230px;

    height:
      230px;

    top:
      -110px;

    right:
      -80px;

    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--color-pink)
            32%,
          transparent
        ),
        transparent 68%
      );
  }

  .visual-card::after {
    width:
      240px;

    height:
      240px;

    bottom:
      -130px;

    left:
      -100px;

    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--color-cyan)
            28%,
          transparent
        ),
        transparent 68%
      );
  }

  .visual-card-top {
    position:
      relative;

    z-index:
      2;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;
  }

  .visual-status {
    padding:
      5px 8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    color:
      var(--color-primary);

    font-size:
      9px;

    font-weight:
      800;

    letter-spacing:
      0.12em;
  }

  .visual-code {
    color:
      var(--text-muted);

    font-size:
      10px;
  }

  .visual-center {
    position:
      relative;

    z-index:
      2;

    min-height:
      190px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    flex-direction:
      column;

    gap:
      16px;
  }

  .visual-avatar {
    width:
      88px;

    height:
      88px;

    padding:
      5px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      29px;

    background:
      linear-gradient(
        135deg,
        var(--color-primary-soft),
        color-mix(
          in srgb,
          var(--color-pink)
            18%,
          transparent
        )
      );
  }

  .visual-avatar span {
    width:
      100%;

    height:
      100%;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border-radius:
      23px;

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    color:
      #ffffff;

    font-size:
      34px;

    font-weight:
      800;
  }

  .visual-title {
    display:
      flex;

    align-items:
      center;

    flex-direction:
      column;

    gap:
      4px;
  }

  .visual-title span {
    font-size:
      24px;

    font-weight:
      800;
  }

  .visual-title small {
    color:
      var(--text-secondary);

    font-size:
      9px;

    letter-spacing:
      0.12em;
  }

  .visual-grid {
    position:
      relative;

    z-index:
      2;

    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      8px;
  }

  .visual-grid div {
    min-width:
      0;

    padding:
      11px;

    display:
      flex;

    flex-direction:
      column;

    gap:
      5px;

    border:
      1px solid
      var(--border);

    border-radius:
      13px;

    background:
      color-mix(
        in srgb,
        var(--color-surface)
          68%,
        transparent
      );
  }

  .visual-grid span {
    color:
      var(--text-muted);

    font-size:
      8px;
  }

  .visual-grid strong {
    font-size:
      10px;
  }

  .visual-orbit {
    position:
      absolute;

    border:
      1px dashed
      color-mix(
        in srgb,
        var(--color-primary)
          30%,
        transparent
      );

    border-radius:
      50%;
  }

  .orbit-one {
    width:
      390px;

    height:
      390px;

    transform:
      translateY(34px)
      rotate(18deg);
  }

  .orbit-two {
    width:
      305px;

    height:
      305px;

    transform:
      translateY(34px)
      rotate(-28deg);
  }

  .visual-star {
    position:
      absolute;

    z-index:
      4;

    color:
      var(--color-primary);
  }

  .star-one {
    top:
      58px;

    right:
      8px;

    font-size:
      24px;
  }

  .star-two {
    bottom:
      42px;

    left:
      18px;

    color:
      var(--color-pink);

    font-size:
      19px;
  }

  .visual-label {
    position:
      absolute;

    z-index:
      5;

    padding:
      8px 10px;

    border:
      1px solid
      var(--border);

    border-radius:
      10px;

    background:
      color-mix(
        in srgb,
        var(--color-surface-elevated)
          82%,
        transparent
      );

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    backdrop-filter:
      blur(10px);

    font-size:
      9px;

    font-weight:
      700;
  }

  .visual-label-left {
    left:
      0;

    top:
      116px;

    transform:
      rotate(-7deg);
  }

  .visual-label-right {
    right:
      -2px;

    bottom:
      82px;

    transform:
      rotate(6deg);
  }

  .hero-scroll-hint {
    position:
      absolute;

    z-index:
      5;

    left:
      50%;

    bottom:
      18px;

    display:
      flex;

    align-items:
      center;

    gap:
      9px;

    transform:
      translateX(-50%);

    color:
      var(--text-muted);

    font-size:
      8px;

    letter-spacing:
      0.14em;
  }

  .hero-scroll-hint i {
    width:
      34px;

    height:
      1px;

    display:
      block;

    background:
      linear-gradient(
        90deg,
        var(--color-primary),
        transparent
      );
  }

  .home-section {
    min-width:
      0;

    padding:
      88px 0;

    border-bottom:
      1px solid
      var(--border);
  }

  .home-section:last-child {
    border-bottom:
      0;
  }

  .section-heading {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap:
      32px;
  }

  .section-heading > * {
    min-width:
      0;
  }

  .section-eyebrow {
    margin:
      0 0 10px;

    color:
      var(--color-primary);

    font-size:
      10px;

    font-weight:
      800;

    letter-spacing:
      0.16em;
  }

  .section-heading h2,
  .project-copy h2 {
    margin:
      0;

    font-size:
      clamp(
        30px,
        4vw,
        42px
      );

    letter-spacing:
      -0.045em;
  }

  .section-description {
    max-width:
      580px;

    margin:
      12px 0 0;

    color:
      var(--text-secondary);

    line-height:
      1.8;
  }

  .section-link {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      7px;

    color:
      var(--text-secondary);

    font-size:
      13px;

    font-weight:
      600;
  }

  /* =========================
     Shared holo layer
     ========================= */

  .card-holo,
  .category-holo,
  .project-holo {
    position:
      absolute;

    inset:
      0;

    z-index:
      1;

    background-image:
      url(
        "/images/anime/effects/holo.webp"
      );

    background-size:
      cover;

    background-position:
      center;

    mix-blend-mode:
      soft-light;

    opacity:
      0;

    pointer-events:
      none;

    transition:
      opacity
        320ms ease,
      transform
        520ms ease;
  }

  /* =========================
     Featured
     ========================= */

  .featured-post {
    position:
      relative;

    min-width:
      0;

    margin-top:
      38px;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-card);

    isolation:
      isolate;

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .featured-post:hover {
    transform:
      translateY(-5px);

    border-color:
      color-mix(
        in srgb,
        var(--color-primary)
          36%,
        var(--border)
      );

    box-shadow:
      0 28px 70px
      color-mix(
        in srgb,
        var(--color-primary)
          13%,
        transparent
      );
  }

  .featured-post:hover
  .card-holo {
    opacity:
      0.11;

    transform:
      scale(1.04)
      rotate(1deg);
  }

  .featured-post-link {
    position:
      relative;

    z-index:
      2;

    min-width:
      0;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(320px, 0.9fr);

    min-height:
      390px;
  }

  .featured-cover {
    position:
      relative;

    min-width:
      0;

    min-height:
      100%;

    overflow:
      hidden;

    background:
      var(--color-primary-soft);
  }

  .featured-cover img {
    width:
      100%;

    height:
      100%;

    min-height:
      390px;

    object-fit:
      cover;

    transition:
      transform
        650ms
        cubic-bezier(
          0.2,
          0.8,
          0.2,
          1
        ),
      filter
        500ms ease;
  }

  .featured-post:hover
  .featured-cover img {
    transform:
      scale(1.035);

    filter:
      saturate(1.04);
  }

  .featured-cover-shade {
    position:
      absolute;

    inset:
      0;

    background:
      linear-gradient(
        180deg,
        transparent
          48%,
        rgba(
          16,
          18,
          35,
          0.18
        )
          100%
      );

    pointer-events:
      none;
  }

  .featured-cover-badge {
    position:
      absolute;

    z-index:
      2;

    top:
      18px;

    left:
      18px;

    padding:
      7px 9px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.22
      );

    border-radius:
      999px;

    background:
      rgba(
        17,
        20,
        34,
        0.62
      );

    color:
      #ffffff;

    backdrop-filter:
      blur(9px);

    font-size:
      9px;

    font-weight:
      800;
  }

  .cover-placeholder {
    width:
      100%;

    height:
      100%;

    min-height:
      390px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    background:
      linear-gradient(
        135deg,
        var(--color-primary-soft),
        color-mix(
          in srgb,
          var(--color-pink)
            18%,
          transparent
        )
      );
  }

  .featured-content {
    min-width:
      0;

    padding:
      42px;

    display:
      flex;

    flex-direction:
      column;

    justify-content:
      center;
  }

  .post-meta {
    display:
      flex;

    align-items:
      center;

    flex-wrap:
      wrap;

    gap:
      7px;

    color:
      var(--text-muted);

    font-size:
      11px;
  }

  .featured-content h3 {
    margin:
      16px 0 12px;

    font-size:
      clamp(
        28px,
        3vw,
        38px
      );

    line-height:
      1.25;
  }

  .featured-content > p {
    margin:
      0;

    color:
      var(--text-secondary);

    line-height:
      1.8;
  }

  .tag-list {
    margin-top:
      22px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      7px;
  }

  .tag-list span {
    padding:
      5px 8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size:
      10px;

    font-weight:
      600;
  }

  .featured-read {
    margin-top:
      30px;

    padding-top:
      20px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    border-top:
      1px solid
      var(--border);

    color:
      var(--text-secondary);

    font-size:
      12px;

    font-weight:
      650;
  }

  .featured-arrow {
    transition:
      transform
        var(--transition-fast),
      color
        var(--transition-fast);
  }

  .featured-post:hover
  .featured-arrow {
    color:
      var(--color-primary);

    transform:
      translate(
        3px,
        -3px
      );
  }

  /* =========================
     Post cards
     ========================= */

  .post-grid {
    min-width:
      0;

    margin-top:
      20px;

    display:
      grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap:
      18px;
  }

  .post-card {
    position:
      relative;

    min-width:
      0;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-lg);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-sm);

    isolation:
      isolate;

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .post-card:hover {
    transform:
      translateY(-5px);

    border-color:
      color-mix(
        in srgb,
        var(--color-primary)
          32%,
        var(--border)
      );

    box-shadow:
      0 20px 48px
      color-mix(
        in srgb,
        var(--color-primary)
          11%,
        transparent
      );
  }

  .post-card:hover
  .card-holo {
    opacity:
      0.09;

    transform:
      scale(1.06)
      rotate(-1deg);
  }

  .post-card > a {
    position:
      relative;

    z-index:
      2;

    height:
      100%;

    display:
      flex;

    flex-direction:
      column;
  }

  .post-cover-wrapper {
    position:
      relative;

    width:
      100%;

    aspect-ratio:
      16 / 9;

    overflow:
      hidden;
  }

  .post-cover {
    width:
      100%;

    height:
      100%;

    object-fit:
      cover;

    transition:
      transform
        620ms
        cubic-bezier(
          0.2,
          0.8,
          0.2,
          1
        ),
      filter
        400ms ease;
  }

  .post-card:hover
  .post-cover {
    transform:
      scale(1.055);

    filter:
      saturate(1.06);
  }

  .post-cover-shade {
    position:
      absolute;

    inset:
      0;

    background:
      linear-gradient(
        180deg,
        transparent 55%,
        rgba(
          15,
          18,
          35,
          0.14
        )
      );
  }

  .post-card-content {
    min-width:
      0;

    flex:
      1;

    padding:
      20px;

    display:
      flex;

    flex-direction:
      column;
  }

  .post-card h3 {
    margin:
      11px 0 8px;

    font-size:
      18px;

    line-height:
      1.4;
  }

  .post-card p {
    margin:
      0;

    color:
      var(--text-secondary);

    font-size:
      13px;

    line-height:
      1.75;
  }

  .post-card .tag-list {
    margin-top:
      auto;

    padding-top:
      18px;
  }

  /* =========================
     Category cards
     ========================= */

  .category-grid {
    min-width:
      0;

    margin-top:
      34px;

    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      14px;
  }

  .category-card {
    position:
      relative;

    min-width:
      0;

    min-height:
      100px;

    padding:
      20px;

    display:
      grid;

    grid-template-columns:
      auto
      minmax(0, 1fr)
      auto;

    align-items:
      center;

    gap:
      18px;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-lg);

    background:
      linear-gradient(
        135deg,
        var(--color-surface),
        color-mix(
          in srgb,
          var(--color-primary-soft)
            15%,
          var(--color-surface)
        )
      );

    box-shadow:
      var(--shadow-sm);

    isolation:
      isolate;

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .category-card > *:not(
    .category-holo
  ) {
    position:
      relative;

    z-index:
      2;
  }

  .category-card:hover {
    transform:
      translateY(-4px);

    border-color:
      color-mix(
        in srgb,
        var(--color-primary)
          32%,
        var(--border)
      );

    box-shadow:
      0 18px 40px
      color-mix(
        in srgb,
        var(--color-primary)
          10%,
        transparent
      );
  }

  .category-card:hover
  .category-holo {
    opacity:
      0.08;

    transform:
      scale(1.12)
      rotate(2deg);
  }

  .category-index {
    width:
      40px;

    height:
      40px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-primary)
          20%,
        var(--border)
      );

    border-radius:
      12px;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size:
      10px;

    font-weight:
      800;

    transition:
      transform
        var(--transition-normal);
  }

  .category-card:hover
  .category-index {
    transform:
      rotate(-4deg)
      scale(1.04);
  }

  .category-copy {
    min-width:
      0;
  }

  .category-card h3 {
    margin:
      0;

    font-size:
      16px;
  }

  .category-card p {
    margin:
      4px 0 0;

    color:
      var(--text-secondary);

    font-size:
      11px;
  }

  .category-arrow {
    width:
      34px;

    height:
      34px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      10px;

    color:
      var(--text-muted);

    transition:
      transform
        var(--transition-fast),
      color
        var(--transition-fast),
      border-color
        var(--transition-fast);
  }

  .category-card:hover
  .category-arrow {
    color:
      var(--color-primary);

    border-color:
      color-mix(
        in srgb,
        var(--color-primary)
          38%,
        var(--border)
      );

    transform:
      translate(
        2px,
        -2px
      );
  }

  /* =========================
     Project showcase
     ========================= */

  .project-showcase {
    position:
      relative;

    min-width:
      0;

    padding:
      42px;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(360px, 0.9fr);

    align-items:
      center;

    gap:
      56px;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-xl);

    background:
      linear-gradient(
        135deg,
        var(--color-surface),
        color-mix(
          in srgb,
          var(--color-primary-soft)
            50%,
          var(--color-surface)
        )
