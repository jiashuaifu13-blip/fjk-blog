---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );

const latestPosts = posts.slice(0, 4);

const featuredPost =
  latestPosts[0];

const secondaryPosts =
  latestPosts.slice(1);

const categoryMap =
  new Map<string, number>();

for (const post of posts) {
  categoryMap.set(
    post.data.category,
    (categoryMap.get(
      post.data.category
    ) ?? 0) + 1
  );
}

const categories =
  Array.from(
    categoryMap.entries()
  ).map(
    ([name, count]) => ({
      name,
      count,
    })
  );
---

<Layout
  title="首页"
  description="FJK 的个人博客，记录技术、项目、学习与生活。"
>
  <section class="hero">
    <div class="hero-copy">
      <div class="hero-badge">
        <span
          class="badge-dot"
          aria-hidden="true"
        ></span>

        <span>
          PERSONAL BLOG
        </span>
      </div>

      <p class="hero-kicker">
        Hello, I'm FJK
      </p>

      <h1>
        记录代码，
        <span>
          也记录生活。
        </span>
      </h1>

      <p class="hero-description">
        这里记录我的技术学习、项目实践、
        工具使用，以及一些值得长期留下来的想法。
      </p>

      <div class="hero-actions">
        <a
          class="hero-primary"
          href="/blog"
        >
          <span>
            阅读文章
          </span>

          <span
            class="button-arrow"
            aria-hidden="true"
          >
            →
          </span>
        </a>

        <a
          class="hero-secondary"
          href="/about"
        >
          关于我
        </a>
      </div>

      <div class="hero-meta">
        <div>
          <strong>
            {posts.length}
          </strong>

          <span>
            篇文章
          </span>
        </div>

        <div>
          <strong>
            {categories.length}
          </strong>

          <span>
            个分类
          </span>
        </div>

        <div>
          <strong>
            Astro
          </strong>

          <span>
            Powered
          </span>
        </div>
      </div>
    </div>

    <div
      class="hero-visual"
      aria-hidden="true"
    >
      <div class="visual-orbit orbit-one"></div>
      <div class="visual-orbit orbit-two"></div>

      <div class="visual-star star-one">
        ✦
      </div>

      <div class="visual-star star-two">
        ✧
      </div>

      <div class="visual-card">
        <div class="visual-card-top">
          <span class="visual-status">
            ONLINE
          </span>

          <span class="visual-code">
            2026
          </span>
        </div>

        <div class="visual-center">
          <div class="visual-avatar">
            <span>
              F
            </span>
          </div>

          <div class="visual-title">
            <span>
              FJK
            </span>

            <small>
              Anime Soft Tech
            </small>
          </div>
        </div>

        <div class="visual-grid">
          <div>
            <span>
              MODE
            </span>

            <strong>
              CREATIVE
            </strong>
          </div>

          <div>
            <span>
              STACK
            </span>

            <strong>
              ASTRO
            </strong>
          </div>

          <div>
            <span>
              STATUS
            </span>

            <strong>
              BUILDING
            </strong>
          </div>

          <div>
            <span>
              SPACE
            </span>

            <strong>
              FJKSP.CN
            </strong>
          </div>
        </div>
      </div>

      <div class="visual-label visual-label-left">
        BLOG / DEV
      </div>

      <div class="visual-label visual-label-right">
        ✦ KEEP CREATING
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          LATEST STORIES
        </p>

        <h2>
          最近更新
        </h2>

        <p class="section-description">
          技术笔记、项目记录和学习过程，
          都会慢慢整理在这里。
        </p>
      </div>

      <a
        class="section-link"
        href="/blog"
      >
        全部文章

        <span
          aria-hidden="true"
        >
          →
        </span>
      </a>
    </div>

    {
      featuredPost && (
        <article class="featured-post">
          <a
            class="featured-post-link"
            href={`/blog/${featuredPost.id}/`}
          >
            <div class="featured-cover">
              {
                featuredPost.data.cover ? (
                  <img
                    src={featuredPost.data.cover}
                    alt={
                      featuredPost.data.coverAlt ??
                      featuredPost.data.title
                    }
                  />
                ) : (
                  <div class="cover-placeholder">
                    <span>
                      FJK
                    </span>
                  </div>
                )
              }

              <div class="featured-cover-badge">
                FEATURED
              </div>
            </div>

            <div class="featured-content">
              <div class="post-meta">
                <time
                  datetime={
                    featuredPost.data.date.toISOString()
                  }
                >
                  {
                    featuredPost.data.date.toLocaleDateString(
                      "zh-CN"
                    )
                  }
                </time>

                <span class="meta-dot">
                  ·
                </span>

                <span>
                  {featuredPost.data.category}
                </span>
              </div>

              <h3>
                {featuredPost.data.title}
              </h3>

              <p>
                {featuredPost.data.description}
              </p>

              {
                featuredPost.data.tags.length >
                  0 && (
                  <div class="tag-list">
                    {
                      featuredPost.data.tags
                        .slice(0, 4)
                        .map(
                          (tag) => (
                            <span>
                              #{tag}
                            </span>
                          )
                        )
                    }
                  </div>
                )
              }

              <div class="featured-read">
                <span>
                  阅读文章
                </span>

                <span
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>
            </div>
          </a>
        </article>
      )
    }

    {
      secondaryPosts.length > 0 && (
        <div class="post-grid">
          {
            secondaryPosts.map(
              (post) => (
                <article class="post-card">
                  <a
                    href={`/blog/${post.id}/`}
                  >
                    {
                      post.data.cover && (
                        <div class="post-cover-wrapper">
                          <img
                            class="post-cover"
                            src={post.data.cover}
                            alt={
                              post.data.coverAlt ??
                              post.data.title
                            }
                            loading="lazy"
                          />
                        </div>
                      )
                    }

                    <div class="post-card-content">
                      <div class="post-meta">
                        <time
                          datetime={
                            post.data.date.toISOString()
                          }
                        >
                          {
                            post.data.date.toLocaleDateString(
                              "zh-CN"
                            )
                          }
                        </time>

                        <span class="meta-dot">
                          ·
                        </span>

                        <span>
                          {post.data.category}
                        </span>
                      </div>

                      <h3>
                        {post.data.title}
                      </h3>

                      <p>
                        {post.data.description}
                      </p>

                      {
                        post.data.tags.length >
                          0 && (
                          <div class="tag-list">
                            {
                              post.data.tags
                                .slice(0, 3)
                                .map(
                                  (tag) => (
                                    <span>
                                      #{tag}
                                    </span>
                                  )
                                )
                            }
                          </div>
                        )
                      }
                    </div>
                  </a>
                </article>
              )
            )
          }
        </div>
      )
    }
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          EXPLORE
        </p>

        <h2>
          分类探索
        </h2>

        <p class="section-description">
          从不同方向找到感兴趣的内容。
        </p>
      </div>
    </div>

    <div class="category-grid">
      {
        categories.map(
          (category, index) => (
            <a
              class="category-card"
              href={`/blog/category/${encodeURIComponent(
                category.name
              )}/`}
            >
              <div class="category-index">
                {String(
                  index + 1
                ).padStart(
                  2,
                  "0"
                )}
              </div>

              <div>
                <h3>
                  {category.name}
                </h3>

                <p>
                  {category.count}
                  {" "}
                  篇文章
                </p>
              </div>

              <span
                class="category-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          )
        )
      }
    </div>
  </section>

  <section class="home-section">
    <div class="project-showcase">
      <div class="project-copy">
        <p class="section-eyebrow">
          FEATURED PROJECT
        </p>

        <h2>
          FJK Blog
        </h2>

        <p>
          从零开始构建并持续维护的个人博客。
          使用 Astro、TypeScript 和 Tailwind CSS，
          记录技术、项目、学习与生活。
        </p>

        <div class="project-stack">
          <span>
            Astro 7
          </span>

          <span>
            TypeScript
          </span>

          <span>
            Tailwind CSS 4
          </span>

          <span>
            Nginx
          </span>
        </div>

        <div class="project-actions">
          <a
            class="project-primary"
            href="/projects"
          >
            查看项目
          </a>

          <a
            class="project-secondary"
            href="https://github.com/jiashuaifu13-blip/fjk-blog"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        </div>
      </div>

      <div
        class="project-panel"
        aria-hidden="true"
      >
        <div class="project-window">
          <div class="project-window-bar">
            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <span>
              fjk-blog
            </span>
          </div>

          <div class="project-code">
            <p>
              <span class="code-muted">
                $
              </span>
              npm run build
            </p>

            <p class="code-success">
              ✓ Astro static build
            </p>

            <p class="code-success">
              ✓ RSS / Sitemap
            </p>

            <p class="code-success">
              ✓ Anime Soft Tech
            </p>

            <p>
              <span class="code-accent">
                https://
              </span>
              fjksp.cn
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    min-height: 690px;

    padding:
      72px 0 88px;

    display: grid;

    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(360px, 0.95fr);

    align-items:
      center;

    gap:
      72px;

    border-bottom:
      1px solid
      var(--border);
  }

  .hero-copy {
    position:
      relative;

    z-index:
      2;
  }

  .hero-badge {
    width:
      fit-content;

    padding:
      7px 11px;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    font-size:
      10px;

    font-weight:
      700;

    letter-spacing:
      0.14em;
  }

  .badge-dot {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
