---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="页面不存在"
  description="你访问的页面不存在。"
>
  <section class="error-page">
    <div class="error-content">
      <p class="error-code">
        404
      </p>

      <h1>
        页面不存在
      </h1>

      <p class="error-description">
        你访问的页面可能已经被移动、
        删除，或者地址输入有误。
      </p>

      <div class="error-actions">
        <a
          class="primary-button"
          href="/"
        >
          返回首页
        </a>

        <a
          class="secondary-button"
          href="/blog"
        >
          浏览文章
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-page {
    min-height:
      calc(100vh - 200px);

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 72px 0;
  }

  .error-content {
    max-width: 680px;

    text-align: center;
  }

  .error-code {
    margin: 0;

    color: var(--text-secondary);

    font-size: 14px;

    font-weight: 700;

    letter-spacing: 0.2em;
  }

  .error-content h1 {
    margin: 18px 0 0;

    font-size: clamp(
      44px,
      8vw,
      72px
    );

    line-height: 1;

    letter-spacing: -0.055em;
  }

  .error-description {
    max-width: 520px;

    margin: 24px auto 0;

    color: var(--text-secondary);

    font-size: 17px;

    line-height: 1.8;
  }

  .error-actions {
    margin-top: 32px;

    display: flex;

    justify-content: center;

    flex-wrap: wrap;

    gap: 12px;
  }

  .primary-button,
  .secondary-button {
    min-height: 44px;

    padding: 0 18px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    border-radius: 8px;

    font-size: 14px;

    font-weight: 600;
  }

  .primary-button {
    background: var(--text-primary);

    color: var(--background);
  }

  .secondary-button {
    border: 1px solid var(--border);
  }
</style>