---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="页面不存在"
  description="这个页面暂时不存在，也许它只是迷路了。"
  noindex={true}
>
  <section class="not-found">
    <div
      class="not-found-background"
      aria-hidden="true"
    >
      <picture>
        <source
          media="(max-width: 700px)"
          srcset="/images/anime/hero/hero-800.webp"
        />

        <source
          media="(max-width: 1200px)"
          srcset="/images/anime/hero/hero-1200.webp"
        />

        <img
          src="/images/anime/hero/hero-1600.webp"
          alt=""
        />
      </picture>

      <div class="background-tint"></div>
      <div class="background-fade"></div>

      <div
        class="background-holo"
        aria-hidden="true"
      ></div>
    </div>

    <div class="not-found-inner">
      <div class="error-copy">
        <div class="error-badge">
          <span
            class="badge-dot"
            aria-hidden="true"
          ></span>

          <span>
            PAGE NOT FOUND
          </span>
        </div>

        <div
          class="error-code"
          aria-label="404"
        >
          <span>4</span>

          <div class="error-zero">
            <span class="zero-ring"></span>

            <strong>
              0
            </strong>

            <span
              class="zero-star"
              aria-hidden="true"
            >
              ✦
            </span>
          </div>

          <span>4</span>
        </div>

        <p class="error-kicker">
          Looks like this page got lost.
        </p>

        <h1>
          好像走到了
          <span>
            不存在的地方。
          </span>
        </h1>

        <p class="error-description">
          这个页面可能已经移动、删除，
          或者地址里出现了一点小偏差。
          不过没关系，可以从熟悉的地方重新开始。
        </p>

        <div class="error-actions">
          <a
            class="primary-action"
            href="/"
          >
            返回首页

            <span aria-hidden="true">
              →
            </span>
          </a>

          <a
            class="secondary-action"
            href="/blog"
          >
            浏览文章
          </a>
        </div>
      </div>

      <div
        class="lost-panel"
        aria-hidden="true"
      >
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>

        <div class="lost-card">
          <div class="lost-holo"></div>

          <div class="lost-card-top">
            <span>
              SYSTEM
            </span>

            <span>
              ERROR_404
            </span>
          </div>

          <div class="lost-icon">
            <span>
              ?
            </span>
          </div>

          <div class="lost-message">
            <strong>
              TARGET LOST
            </strong>

            <span>
              Route not found
            </span>
          </div>

          <div class="lost-data">
            <div>
              <span>
                STATUS
              </span>

              <strong>
                404
              </strong>
            </div>

            <div>
              <span>
                ACTION
              </span>

              <strong>
                RETURN
              </strong>
            </div>
          </div>
        </div>

        <span class="panel-star panel-star-one">
          ✦
        </span>

        <span class="panel-star panel-star-two">
          ✧
        </span>
      </div>
    </div>

    <div
      class="bottom-note"
      aria-hidden="true"
    >
      <span>
        FJK BLOG
      </span>

      <i></i>

      <span>
        KEEP EXPLORING
      </span>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    position: relative;

    min-height:
      calc(
        100svh - 76px
      );

    margin:
      0 calc(
        50% - 50vw
      );

    display: flex;

    align-items: center;

    overflow: hidden;

    border-bottom:
      1px solid
      var(--border);

    isolation: isolate;
  }

  .not-found-background {
    position: absolute;

    z-index: -4;

    inset: 0;

    overflow: hidden;

    pointer-events: none;
  }

  .not-found-background picture,
  .not-found-background img {
    width: 100%;
    height: 100%;

    display: block;
  }

  .not-found-background img {
    object-fit: cover;

    object-position:
      center 43%;

    transform:
      scale(1.035);

    filter:
      saturate(0.86)
      brightness(1.02);
  }

  .background-tint,
  .background-fade,
  .background-holo {
    position: absolute;

    inset: 0;

    pointer-events: none;
  }

  .background-tint {
    z-index: 1;

    background:
      linear-gradient(
        105deg,
        color-mix(
          in srgb,
          var(--background) 96%,
          transparent
        ) 0%,
        color-mix(
          in srgb,
          var(--background) 83%,
          transparent
        ) 37%,
        color-mix(
          in srgb,
          var(--background) 32%,
          transparent
        ) 77%,
        transparent 100%
      );
  }

  .background-fade {
    z-index: 2;

    background:
      linear-gradient(
        180deg,
        color-mix(
          in srgb,
          var(--background) 10%,
          transparent
        ) 0%,
        transparent 34%,
        color-mix(
          in srgb,
          var(--background) 32%,
          transparent
        ) 72%,
        var(--background) 100%
      );
  }

  .background-holo {
    z-index: 3;

    background-image:
      url(
        "/images/anime/effects/holo.webp"
      );

    background-size: cover;
    background-position: center;

    mix-blend-mode:
      soft-light;

    opacity: 0.035;
  }

  :global(html.dark)
  .not-found-background img {
    filter:
      brightness(0.5)
      saturate(0.72)
      contrast(1.02);
  }

  :global(html.dark)
  .background-tint {
    background:
      linear-gradient(
        105deg,
        rgba(
          16,
          17,
          26,
          0.98
        ) 0%,
        rgba(
          16,
          17,
          26,
          0.88
        ) 39%,
        rgba(
          16,
          17,
          26,
          0.38
        ) 79%,
        transparent 100%
      );
  }

  .not-found-inner {
    width:
      min(
        calc(
          100% - 48px
        ),
        1180px
      );

    margin:
      0 auto;

    padding:
      86px 0 100px;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(320px, 0.72fr);

    align-items: center;

    gap: 72px;
  }

  .not-found-inner > * {
    min-width: 0;
  }

  .error-copy {
    position: relative;

    z-index: 4;
  }

  .error-badge {
    width: fit-content;

    padding:
      7px 11px;

    display: inline-flex;

    align-items: center;

    gap: 8px;

    border:
      1px solid
      var(--border);

    border-radius: 999px;

    background:
      color-mix(
        in srgb,
        var(--color-surface) 78%,
        transparent
      );

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    backdrop-filter:
      blur(12px);

    -webkit-backdrop-filter:
      blur(12px);

    font-size: 10px;
    font-weight: 800;

    letter-spacing:
      0.14em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      var(--color-pink);

    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        var(--color-pink) 14%,
        transparent
      );
  }

  .error-code {
    margin-top: 18px;

    display: flex;

    align-items: center;

    gap:
      clamp(
        4px,
        1vw,
        12px
      );

    color:
      var(--text-primary);

    font-size:
      clamp(
        100px,
        14vw,
        174px
      );

    font-weight: 800;

    line-height: 0.88;

    letter-spacing:
      -0.09em;
  }

  .error-code > span {
    background:
      linear-gradient(
        180deg,
        var(--text-primary),
        color-mix(
          in srgb,
          var(--text-primary) 65%,
          var(--color-primary)
        )
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color: transparent;
  }

  .error-zero {
    position: relative;

    width:
      0.72em;

    height:
      0.88em;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;
  }

  .error-zero strong {
    position: relative;

    z-index: 2;

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color: transparent;

    font: inherit;
  }

  .zero-ring {
    position: absolute;

    width: 0.72em;
    height: 0.72em;

    border:
      1px dashed
      color-mix(
        in srgb,
        var(--color-primary) 38%,
        transparent
      );

    border-radius: 50%;

    transform:
      rotate(18deg);
  }

  .zero-star {
    position: absolute;

    z-index: 3;

    right: -3px;
    top: 9%;

    color:
      var(--color-pink);

    font-size: 0.12em;

    text-shadow:
      0 0 16px
      color-mix(
        in srgb,
        var(--color-pink) 50%,
        transparent
      );
  }

  .error-kicker {
    margin:
      28px 0 0;

    color:
      var(--color-primary);

    font-size: 13px;
    font-weight: 700;
  }

  .error-copy h1 {
    max-width: 650px;

    margin:
      10px 0 0;

    font-size:
      clamp(
        38px,
        5vw,
        58px
      );

    line-height: 1.1;

    letter-spacing:
      -0.055em;

    word-break: keep-all;
  }

  .error-copy h1 span {
    display: block;

    background:
      linear-gradient(
        100deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color: transparent;
  }

  .error-description {
    max-width: 580px;

    margin:
      22px 0 0;

    color:
      var(--text-secondary);

    font-size: 15px;
    line-height: 1.9;
  }

  .error-actions {
    margin-top: 30px;

    display: flex;
    flex-wrap: wrap;

    gap: 11px;
  }

  .primary-action,
  .secondary-action {
    min-height: 46px;

    padding:
      0 18px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 10px;

    border-radius: 13px;

    font-size: 12px;
    font-weight: 650;

    transition:
      transform
        var(--transition-fast),
      border-color
        var(--transition-fast),
      box-shadow
        var(--transition-fast);
  }

  .primary-action {
    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-primary) 48%,
        transparent
      );

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary)
      );

    color: #ffffff;

    box-shadow:
      0 12px 28px
      color-mix(
        in srgb,
        var(--color-primary) 22%,
        transparent
      );
  }

  .primary-action:hover {
    color: #ffffff;

    transform:
      translateY(-2px);

    box-shadow:
      0 17px 36px
      color-mix(
        in srgb,
        var(--color-primary) 29%,
        transparent
      );
  }

  .secondary-action {
    border:
      1px solid
      var(--border);

    background:
      color-mix(
        in srgb,
        var(--color-surface) 80%,
        transparent
      );

    color:
      var(--text-primary);

    backdrop-filter:
      blur(10px);

    -webkit-backdrop-filter:
      blur(10px);
  }

  .secondary-action:hover {
    color:
      var(--color-primary);

    transform:
      translateY(-2px);

    border-color:
      var(--border-strong);
  }

  /* =========================
     Lost panel
     ========================= */

  .lost-panel {
    position: relative;

    z-index: 4;

    min-height: 440px;

    display: flex;

    align-items: center;
    justify-content: center;
  }

  .lost-card {
    position: relative;

    z-index: 3;

    width:
      min(
        100%,
        340px
      );

    padding: 22px;

    overflow: hidden;

    border:
      1px solid
      var(--glass-border);

    border-radius: 27px;

    background:
      color-mix(
        in srgb,
        var(--glass-background) 86%,
        transparent
      );

    box-shadow:
      0 28px 78px
      rgba(
        20,
        20,
        50,
        0.18
      );

    backdrop-filter:
      blur(18px);

    -webkit-backdrop-filter:
      blur(18px);

    transform:
      rotate(-2deg);
  }

  .lost-holo {
    position: absolute;

    inset: 0;

    background-image:
      url(
        "/images/anime/effects/holo.webp"
      );

    background-size: cover;
    background-position: center;

    mix-blend-mode:
      soft-light;

    opacity: 0.075;

    pointer-events: none;
  }

  .lost-card-top {
    position: relative;

    z-index: 2;

    display: flex;

    align-items: center;
    justify-content: space-between;

    color:
      var(--text-muted);

    font-size: 8px;
    font-weight: 800;

    letter-spacing:
      0.12em;
  }

  .lost-icon {
    position: relative;

    z-index: 2;

    width: 92px;
    height: 92px;

    margin:
      40px auto 0;

    padding: 5px;

    border:
      1px solid
      var(--border);

    border-radius: 30px;

    background:
      linear-gradient(
        135deg,
        var(--color-primary-soft),
        color-mix(
          in srgb,
          var(--color-pink) 12%,
          transparent
        )
      );
  }

  .lost-icon span {
    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 24px;

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    color: #ffffff;

    font-size: 38px;
    font-weight: 800;
  }

  .lost-message {
    position: relative;

    z-index: 2;

    margin-top: 17px;

    display: flex;

    align-items: center;

    flex-direction: column;

    gap: 5px;
  }

  .lost-message strong {
    font-size: 17px;
  }

  .lost-message span {
    color:
      var(--text-secondary);

    font-size: 9px;

    letter-spacing:
      0.08em;
  }

  .lost-data {
    position: relative;

    z-index: 2;

    margin-top: 31px;

    display: grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap: 8px;
  }

  .lost-data div {
    min-width: 0;

    padding: 12px;

    display: flex;

    flex-direction: column;

    gap: 5px;

    border:
      1px solid
      var(--border);

    border-radius: 12px;

    background:
      color-mix(
        in srgb,
        var(--color-surface) 70%,
        transparent
      );
  }

  .lost-data span {
    color:
      var(--text-muted);

    font-size: 7px;
  }

  .lost-data strong {
    font-size: 10px;
  }

  .orbit {
    position: absolute;

    border:
      1px dashed
      color-mix(
        in srgb,
        var(--color-primary) 28%,
        transparent
      );

    border-radius: 50%;
  }

  .orbit-one {
    width: 390px;
    height: 390px;

    transform:
      rotate(18deg);
  }

  .orbit-two {
    width: 300px;
    height: 300px;

    transform:
      rotate(-25deg);
  }

  .panel-star {
    position: absolute;

    z-index: 5;

    color:
      var(--color-primary);
  }

  .panel-star-one {
    right: 4px;
    top: 74px;

    font-size: 24px;
  }

  .panel-star-two {
    left: 12px;
    bottom: 76px;

    color:
      var(--color-pink);

    font-size: 18px;
  }

  /* =========================
     Bottom label
     ========================= */

  .bottom-note {
    position: absolute;

    z-index: 5;

    left: 50%;
    bottom: 22px;

    display: flex;

    align-items: center;

    gap: 10px;

    transform:
      translateX(-50%);

    color:
      var(--text-muted);

    font-size: 8px;
    font-weight: 700;

    letter-spacing:
      0.12em;

    white-space: nowrap;
  }

  .bottom-note i {
    width: 34px;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        var(--color-primary),
        transparent
      );
  }

  /* =========================
     Runtime mobile fallback
     ========================= */

  :global(html.mobile-device)
  .not-found {
    min-height: auto;
  }

  :global(html.mobile-device)
  .not-found-background img {
    object-position:
      67% center;
  }

  :global(html.mobile-device)
  .background-tint {
    background:
      linear-gradient(
        180deg,
        color-mix(
          in srgb,
          var(--background) 45%,
          transparent
        ) 0%,
        color-mix(
          in srgb,
          var(--background) 76%,
          transparent
        ) 46%,
        var(--background) 100%
      );
  }

  :global(html.mobile-device)
  .not-found-inner {
    width:
      min(
        calc(
          100% - 36px
        ),
        1180px
      );

    padding:
      58px 0 74px;

    grid-template-columns:
      minmax(0, 1fr);

    gap: 24px;
  }

  :global(html.mobile-device)
  .error-code {
    font-size:
      clamp(
        88px,
        28vw,
        132px
      );
  }

  :global(html.mobile-device)
  .error-copy h1 {
    width: 100%;
    max-width: 100%;

    font-size:
      clamp(
        38px,
        11vw,
        54px
      );
  }

  :global(html.mobile-device)
  .error-description {
    font-size: 14px;
  }

  :global(html.mobile-device)
  .error-actions {
    width: 100%;

    flex-direction: column;
  }

  :global(html.mobile-device)
  .primary-action,
  :global(html.mobile-device)
  .secondary-action {
    width: 100%;
  }

  :global(html.mobile-device)
  .lost-panel {
    min-height: 350px;

    overflow: hidden;
  }

  :global(html.mobile-device)
  .lost-card {
    width:
      min(
        calc(
          100% - 22px
        ),
        340px
      );

    transform: none;
  }

  :global(html.mobile-device)
  .orbit-one {
    width:
      min(
        330px,
        84vw
      );

    height:
      min(
        330px,
        84vw
      );
  }

  :global(html.mobile-device)
  .orbit-two {
    width:
      min(
        270px,
        68vw
      );

    height:
      min(
        270px,
        68vw
      );
  }

  :global(html.mobile-device)
  .panel-star,
  :global(html.mobile-device)
  .bottom-note {
    display: none;
  }

  /* =========================
     Standard responsive
     ========================= */

  @media (
    max-width: 960px
  ) {
    .not-found-inner {
      grid-template-columns:
        1fr;

      gap: 20px;
    }

    .lost-panel {
      min-height: 380px;
    }
  }

  @media (
    max-width: 700px
  ) {
    .not-found {
      min-height: auto;
    }

    .not-found-inner {
      width:
        calc(
          100% - 36px
        );

      padding:
        58px 0 74px;
    }

    .error-code {
      font-size:
        clamp(
          88px,
          28vw,
          132px
        );
    }

    .error-copy h1 {
      font-size:
        clamp(
          38px,
          12vw,
          54px
        );
    }

    .error-actions {
      flex-direction: column;
    }

    .primary-action,
    .secondary-action {
      width: 100%;
    }

    .lost-card {
      transform: none;
    }

    .panel-star,
    .bottom-note {
      display: none;
    }
  }

  @media (
    max-width: 420px
  ) {
    .lost-card {
      padding: 19px;
    }

    .lost-data {
      gap: 6px;
    }
  }

  @media (
    hover: none
  ) {
    .primary-action:hover,
    .secondary-action:hover {
      transform: none;
    }
  }

  @media (
    prefers-reduced-motion:
      reduce
  ) {
    .lost-card,
    .primary-action,
    .secondary-action {
      transition:
        none !important;

      transform:
        none !important;
    }
  }
</style>