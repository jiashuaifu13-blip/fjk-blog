        var(--color-primary-soft),
        color-mix(
          in srgb,
          var(--color-pink)
            12%,
          transparent
        )
      );
  }

  .stats-label {
    margin-bottom:
      auto;

    color:
      var(--text-muted);

    font-size:
      9px;

    font-weight:
      800;

    letter-spacing:
      0.14em;
  }

  .stats-main strong {
    color:
      var(--color-primary);

    font-size:
      72px;

    line-height:
      0.95;

    letter-spacing:
      -0.06em;
  }

  .stats-main p {
    margin:
      10px 0 0;

    color:
      var(--text-secondary);

    font-size:
      12px;
  }

  .stats-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
