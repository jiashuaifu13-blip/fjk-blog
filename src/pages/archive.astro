        minmax(0, 1fr)
      );
  }

  .stats-grid div {
    min-height:
      95px;

    padding:
      18px;

    display:
      flex;

    flex-direction:
      column;

    justify-content:
      space-between;

    border-top:
      1px solid
      var(--border);

    border-right:
      1px solid
      var(--border);
  }

  .stats-grid div:nth-child(
    2n
  ) {
    border-right:
      0;
  }

  .stats-grid span {
    color:
      var(--text-muted);

    font-size:
      8px;

    font-weight:
      750;

    letter-spacing:
      0.11em;
  }

  .stats-grid strong {
    margin-top:
      10px;

    font-size:
      20px;

    letter-spacing:
      -0.03em;
  }

  .stats-grid
  .range-text {
    font-size:
      14px;

    letter-spacing:
      -0.02em;
  }

  .timeline-section {
    padding:
      82px 0 30px;
  }

  .section-heading {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap:
      30px;

    padding-bottom:
      34px;

    border-bottom:
      1px solid
      var(--border);
  }

  .section-eyebrow {
    margin:
      0 0 9px;

    color:
      var(--color-primary);

    font-size:
      9px;

    font-weight:
      800;

    letter-spacing:
      0.15em;
  }

  .section-heading h2 {
    margin:
      0;

    font-size:
      clamp(
        30px,
        4vw,
        42px
      );

    letter-spacing:
      -0.045em;
  }

  .section-description {
    margin:
      10px 0 0;

    color:
      var(--text-secondary);

    font-size:
      13px;
  }

  .timeline-total {
    padding:
      7px 10px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    color:
      var(--text-muted);

    font-size:
      10px;

    font-weight:
      700;
  }

  .timeline {
    margin-top:
      12px;
  }

  .year-group {
    display:
      grid;

    grid-template-columns:
      150px
      minmax(0, 1fr);

    gap:
      40px;

    padding:
      54px 0;

    border-bottom:
      1px solid
      var(--border);
  }

  .year-group:last-child {
    border-bottom:
      0;
  }

  .year-column {
    position:
      relative;
  }

  .year-sticky {
    position:
      sticky;

    top:
      118px;

    display:
      flex;

    flex-direction:
      column;
  }

  .year-index {
    color:
      var(--text-muted);

    font-size:
      8px;

    font-weight:
      800;

    letter-spacing:
      0.12em;
  }

  .year-sticky strong {
    margin-top:
      7px;

    color:
      var(--text-primary);

    font-size:
      42px;

    line-height:
      1;

    letter-spacing:
      -0.05em;
  }

  .year-count {
    margin-top:
      9px;

    color:
      var(--color-primary);

    font-size:
      10px;

    font-weight:
      650;
  }

  .year-posts {
    position:
      relative;

    display:
      flex;

    flex-direction:
      column;

    gap:
      14px;
  }

  .year-posts::before {
    content: "";

    position:
      absolute;

    top:
      22px;

    bottom:
      22px;

    left:
      -25px;

    width:
      1px;

    background:
      linear-gradient(
        180deg,
        var(--color-primary),
        var(--border),
        var(--border)
      );
  }

  .timeline-item {
    position:
      relative;
  }

  .timeline-node {
    position:
      absolute;

    top:
      33px;

    left:
      -31px;

    z-index:
      3;

    width:
      13px;

    height:
      13px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      3px solid
      var(--background);

    border-radius:
      50%;

    background:
      var(--color-primary);
  }

  .timeline-node span {
    width:
      3px;

    height:
      3px;

    border-radius:
      50%;

    background:
      #ffffff;
  }

  .timeline-card {
    min-height:
      160px;

    padding:
      22px;

    display:
      grid;

    grid-template-columns:
      58px
      minmax(0, 1fr)
      auto;

    align-items:
      start;

    gap:
      20px;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-lg);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-sm);

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      background-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .timeline-card:hover {
    transform:
      translateX(4px);

    border-color:
      var(--border-strong);

    background:
      var(--color-surface-elevated);

    box-shadow:
      var(--shadow-card);
  }

  .timeline-date {
    display:
      flex;

    flex-direction:
      column;

    align-items:
      flex-start;
  }

  .date-day {
    color:
      var(--text-primary);

    font-size:
      27px;

    font-weight:
      750;

    line-height:
      1;

    letter-spacing:
      -0.045em;
  }

  .date-month {
    margin-top:
      5px;

    color:
      var(--text-muted);

    font-size:
      9px;

    font-weight:
      650;
  }

  .timeline-content {
    min-width:
      0;
  }

  .timeline-meta {
    display:
      flex;

    align-items:
      center;

    flex-wrap:
      wrap;

    gap:
      6px;

    color:
      var(--text-muted);

    font-size:
      9px;
  }

