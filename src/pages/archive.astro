---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.date.getTime() -
      a.data.date.getTime()
  );

const postsByYear =
  new Map<
    number,
    typeof posts
  >();

for (const post of posts) {
  const year =
    post.data.date.getFullYear();

  const yearPosts =
    postsByYear.get(year) ?? [];

  yearPosts.push(post);

  postsByYear.set(
    year,
    yearPosts
  );
}

const archiveYears =
  Array.from(
    postsByYear.entries()
  ).sort(
    ([yearA], [yearB]) =>
      yearB - yearA
  );

const categoryCount =
  new Set(
    posts.map(
      (post) =>
        post.data.category
    )
  ).size;

const tagCount =
  new Set(
    posts.flatMap(
      (post) =>
        post.data.tags
    )
  ).size;

const firstYear =
  archiveYears.length > 0
    ? archiveYears[
        archiveYears.length - 1
      ][0]
    : undefined;

const latestYear =
  archiveYears.length > 0
    ? archiveYears[0][0]
    : undefined;
---

<Layout
  title="归档"
  description="FJK Blog 的文章归档，按年份整理技术、项目、学习与生活记录。"
>
  <section class="archive-hero">
    <div class="archive-copy">
      <div class="archive-badge">
        <span
          class="badge-dot"
          aria-hidden="true"
        ></span>

        <span>
          ARCHIVE
        </span>
      </div>

      <p class="archive-kicker">
        Timeline of ideas
      </p>

      <h1>
        时间会过去，
        <span>
          记录会留下。
        </span>
      </h1>

      <p class="archive-description">
        按时间整理已经发布的文章。
        技术、项目、学习过程和一些零散想法，
        都会慢慢沉淀在这里。
      </p>

      <a
        class="back-link"
        href="/blog"
      >
        <span>
          查看全部文章
        </span>

        <span
          aria-hidden="true"
        >
          →
        </span>
      </a>
    </div>

    <div class="archive-stats">
      <div class="stats-main">
        <span class="stats-label">
          TOTAL POSTS
        </span>

        <strong>
          {String(
            posts.length
          ).padStart(
            2,
            "0"
          )}
        </strong>

        <p>
          已发布文章
        </p>
      </div>

      <div class="stats-grid">
        <div>
          <span>
            YEARS
          </span>

          <strong>
            {archiveYears.length}
          </strong>
        </div>

        <div>
          <span>
            CATEGORIES
          </span>

          <strong>
            {categoryCount}
          </strong>
        </div>

        <div>
          <span>
            TAGS
          </span>

          <strong>
            {tagCount}
          </strong>
        </div>

        <div>
          <span>
            RANGE
          </span>

          <strong class="range-text">
            {
              firstYear &&
              latestYear
                ? firstYear ===
                  latestYear
                  ? latestYear
                  : `${firstYear}–${latestYear}`
                : "—"
            }
          </strong>
        </div>
      </div>
    </div>
  </section>

  {
    archiveYears.length > 0 ? (
      <section class="timeline-section">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">
              ALL STORIES
            </p>

            <h2>
              文章时间轴
            </h2>

            <p class="section-description">
              从最近的记录开始向过去翻阅。
            </p>
          </div>

          <span class="timeline-total">
            {archiveYears.length}
            {" "}
            Years
          </span>
        </div>

        <div class="timeline">
          {
            archiveYears.map(
              (
                [
                  year,
                  yearPosts,
                ],
                yearIndex
              ) => (
                <section class="year-group">
                  <div class="year-column">
                    <div class="year-sticky">
                      <span class="year-index">
                        {String(
                          yearIndex +
                            1
                        ).padStart(
                          2,
                          "0"
                        )}
                      </span>

                      <strong>
                        {year}
                      </strong>

                      <span class="year-count">
                        {
                          yearPosts.length
                        }
                        {" "}
                        Posts
                      </span>
                    </div>
                  </div>

                  <div class="year-posts">
                    {
                      yearPosts.map(
                        (
                          post,
                          postIndex
                        ) => (
                          <article class="timeline-item">
                            <div
                              class="timeline-node"
                              aria-hidden="true"
                            >
                              <span></span>
                            </div>

                            <a
                              class="timeline-card"
                              href={`/blog/${post.id}/`}
                            >
                              <div class="timeline-date">
                                <span class="date-day">
                                  {
                                    String(
                                      post.data.date.getDate()
                                    ).padStart(
                                      2,
                                      "0"
                                    )
                                  }
                                </span>

                                <span class="date-month">
                                  {
                                    post.data.date.toLocaleDateString(
                                      "zh-CN",
                                      {
                                        month:
                                          "2-digit",
                                      }
                                    )
                                  }
                                </span>
                              </div>

                              <div class="timeline-content">
                                <div class="timeline-meta">
                                  <span>
                                    {
                                      post.data.category
                                    }
                                  </span>

                                  <span
                                    aria-hidden="true"
                                  >
                                    ·
                                  </span>

                                  <time
                                    datetime={
                                      post.data.date.toISOString()
                                    }
                                  >
                                    {
                                      post.data.date.toLocaleDateString(
                                        "zh-CN",
                                        {
                                          year:
                                            "numeric",
                                          month:
                                            "2-digit",
                                          day:
                                            "2-digit",
                                        }
                                      )
                                    }
                                  </time>
                                </div>

                                <h3>
                                  {
                                    post.data.title
                                  }
                                </h3>

                                <p>
                                  {
                                    post.data.description
                                  }
                                </p>

                                {
                                  post.data
                                    .tags
                                    .length >
                                    0 && (
                                    <div class="tag-list">
                                      {
                                        post.data.tags
                                          .slice(
                                            0,
                                            4
                                          )
                                          .map(
                                            (
                                              tag
                                            ) => (
                                              <span>
                                                #
                                                {
                                                  tag
                                                }
                                              </span>
                                            )
                                          )
                                      }
                                    </div>
                                  )
                                }
                              </div>

                              <div class="timeline-end">
                                <span class="item-number">
                                  {String(
                                    postIndex +
                                      1
                                  ).padStart(
                                    2,
                                    "0"
                                  )}
                                </span>

                                <span
                                  class="item-arrow"
                                  aria-hidden="true"
                                >
                                  ↗
                                </span>
                              </div>
                            </a>
                          </article>
                        )
                      )
                    }
                  </div>
                </section>
              )
            )
          }
        </div>
      </section>
    ) : (
      <section class="empty-section">
        <div class="empty-state">
          <span
            class="empty-symbol"
            aria-hidden="true"
          >
            ✦
          </span>

          <h2>
            归档还是空的
          </h2>

          <p>
            第一篇文章发布后，
            它会出现在这里。
          </p>

          <a href="/blog">
            返回文章
          </a>
        </div>
      </section>
    )
  }
</Layout>

<style>
