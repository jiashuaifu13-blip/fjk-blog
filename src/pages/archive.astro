---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts =
  (await getCollection("posts"))
    .filter(
      (post) =>
        !post.data.draft
    )
    .sort(
      (a, b) =>
        b.data.date.getTime() -
        a.data.date.getTime()
    );

const postsByYear =
  new Map<
    number,
    typeof posts
  >();

for (const post of posts) {
  const year =
    post.data.date.getFullYear();

  const yearPosts =
    postsByYear.get(year) ?? [];

  yearPosts.push(post);

  postsByYear.set(
    year,
    yearPosts
  );
}

const archiveYears =
  Array.from(
    postsByYear.entries()
  ).sort(
    ([a], [b]) =>
      b - a
  );

const categoryCount =
  new Set(
    posts.map(
      (post) =>
        post.data.category
    )
  ).size;

const tagCount =
  new Set(
    posts.flatMap(
      (post) =>
        post.data.tags
    )
  ).size;

const firstYear =
  archiveYears.length
    ? archiveYears[
        archiveYears.length - 1
      ][0]
    : undefined;

const latestYear =
  archiveYears.length
    ? archiveYears[0][0]
    : undefined;
---

<Layout
  title="归档"
  description="FJK Blog 的文章归档。"
>
  <section class="archive-hero">
    <div class="archive-copy">
      <div class="archive-badge">
        <span></span>
        ARCHIVE
      </div>

      <p class="archive-kicker">
        Timeline of ideas
      </p>

      <h1>
        时间会过去，
        <span>
          记录会留下。
        </span>
      </h1>

      <p class="archive-description">
        按时间整理已经发布的文章。
        技术、项目、学习过程和一些零散想法，
        都会慢慢沉淀在这里。
      </p>

      <a
        class="back-link"
        href="/blog"
      >
        查看全部文章 →
      </a>
    </div>

    <div class="archive-stats">
      <div class="stats-main">
        <span>
          TOTAL POSTS
        </span>

        <strong>
          {String(
            posts.length
          ).padStart(
            2,
            "0"
          )}
        </strong>

        <p>
          已发布文章
        </p>
      </div>

      <div class="stats-grid">
        <div>
          <span>
            YEARS
          </span>
          <strong>
            {archiveYears.length}
          </strong>
        </div>

        <div>
          <span>
            CATEGORIES
          </span>
          <strong>
            {categoryCount}
          </strong>
        </div>

        <div>
          <span>
            TAGS
          </span>
          <strong>
            {tagCount}
          </strong>
        </div>

        <div>
          <span>
            RANGE
          </span>
          <strong>
            {
              firstYear &&
              latestYear
                ? firstYear ===
                  latestYear
                  ? latestYear
                  : `${firstYear}–${latestYear}`
                : "—"
            }
          </strong>
        </div>
      </div>
    </div>
  </section>

  <section class="timeline-section">
    <div class="section-heading">
      <div>
        <p>
          ALL STORIES
        </p>

        <h2>
          文章时间轴
        </h2>
      </div>
    </div>

    <div class="timeline">
      {
        archiveYears.map(
          ([year, yearPosts]) => (
            <section class="year-group">
              <div class="year-column">
                <div class="year-sticky">
                  <strong>
                    {year}
                  </strong>

                  <span>
                    {
                      yearPosts.length
                    }
                    {" "}
                    Posts
                  </span>
                </div>
              </div>

              <div class="year-posts">
                {
                  yearPosts.map(
                    (post) => (
                      <article class="timeline-item">
                        <a
                          class="timeline-card"
                          href={`/blog/${post.id}/`}
                        >
                          <div class="timeline-date">
                            <strong>
                              {String(
                                post.data.date.getDate()
                              ).padStart(
                                2,
                                "0"
                              )}
                            </strong>

                            <span>
                              {
                                post.data.date.toLocaleDateString(
                                  "zh-CN",
                                  {
                                    month:
                                      "2-digit",
                                  }
                                )
                              }
                            </span>
                          </div>

                          <div class="timeline-content">
                            <div class="timeline-meta">
                              {
                                post.data.category
                              }
                            </div>

                            <h3>
                              {
                                post.data.title
                              }
                            </h3>

                            <p>
                              {
                                post.data.description
                              }
                            </p>

                            <div class="tag-list">
                              {
                                post.data.tags.map(
                                  (tag) => (
                                    <span>
                                      #{tag}
                                    </span>
                                  )
                                )
                              }
                            </div>
                          </div>

                          <span class="item-arrow">
                            ↗
                          </span>
                        </a>
                      </article>
                    )
                  )
                }
              </div>
            </section>
          )
        )
      }
    </div>
  </section>
</Layout>

<style>
  .archive-hero {
    min-height:
      590px;

    padding:
      78px 0 72px;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(360px, 0.72fr);

    align-items:
      center;

    gap:
      72px;

    border-bottom:
      1px solid
      var(--border);
  }

  .archive-hero > * {
    min-width:
      0;
  }

  .archive-badge {
    width:
      fit-content;

    padding:
      7px 11px;

    display:
      flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    font-size:
      9px;
  }

  .archive-badge span {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
      var(--color-cyan);
  }

  .archive-kicker {
    margin-top:
      24px;

    color:
      var(--color-primary);

    font-weight:
      700;
  }

  .archive-copy h1 {
    margin:
      12px 0 0;

    font-size:
      clamp(
        48px,
        6.4vw,
        76px
      );

    line-height:
      1.08;

    letter-spacing:
      -0.055em;

    word-break:
      normal;
  }

  .archive-copy h1 span {
    display:
      block;

    background:
      linear-gradient(
        100deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;
  }

  .archive-description {
    max-width:
      620px;

    color:
      var(--text-secondary);

    line-height:
      1.9;
  }

  .back-link {
    margin-top:
      30px;

    padding:
      12px 16px;

    display:
      inline-flex;

    border:
      1px solid
      var(--border);

    border-radius:
      13px;

    background:
      var(--color-surface);
  }

  .archive-stats {
    min-width:
      0;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      28px;

    background:
      var(--glass-background);

    box-shadow:
      var(--shadow-card);
  }

  .stats-main {
    min-height:
      210px;

    padding:
      28px;

    display:
      flex;

    flex-direction:
      column;

    justify-content:
      flex-end;

    background:
      var(--color-primary-soft);
  }

  .stats-main > span {
    margin-bottom:
      auto;

    color:
      var(--text-muted);

    font-size:
      9px;
  }

  .stats-main strong {
    color:
      var(--color-primary);

    font-size:
      72px;
  }

  .stats-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .stats-grid div {
    min-width:
      0;

    min-height:
      95px;

    padding:
      18px;

    display:
      flex;

    flex-direction:
      column;

    justify-content:
      space-between;

    border:
      1px solid
      var(--border);
  }

  .stats-grid span {
    color:
      var(--text-muted);

    font-size:
      8px;
  }

  .timeline-section {
    padding:
      82px 0 30px;
  }

  .section-heading p {
    margin:
      0 0 9px;

    color:
      var(--color-primary);

    font-size:
      9px;
  }

  .section-heading h2 {
    margin:
      0;

    font-size:
      40px;
  }

  .timeline {
    margin-top:
      46px;
  }

  .year-group {
    min-width:
      0;

    display:
      grid;

    grid-template-columns:
      150px
      minmax(0, 1fr);

    gap:
      40px;

    padding:
      54px 0;

    border-bottom:
      1px solid
      var(--border);
  }

  .year-sticky {
    position:
      sticky;

    top:
      118px;

    display:
      flex;

    flex-direction:
      column;
  }

  .year-sticky strong {
    font-size:
      42px;
  }

  .year-sticky span {
    color:
      var(--color-primary);

    font-size:
      10px;
  }

  .year-posts {
    min-width:
      0;

    display:
      flex;

    flex-direction:
      column;

    gap:
      14px;
  }

  .timeline-card {
    min-width:
      0;

    padding:
      22px;

    display:
      grid;

    grid-template-columns:
      58px
      minmax(0, 1fr)
      auto;

    gap:
      20px;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-lg);

    background:
      var(--color-surface);
  }

  .timeline-date {
    display:
      flex;

    flex-direction:
      column;
  }

  .timeline-date strong {
    font-size:
      27px;
  }

  .timeline-date span {
    color:
      var(--text-muted);

    font-size:
      9px;
  }

  .timeline-content {
    min-width:
      0;
  }

  .timeline-meta {
    color:
      var(--text-muted);

    font-size:
      9px;
  }

  .timeline-content h3 {
    margin:
      10px 0 7px;

    font-size:
      19px;

    word-break:
      normal;
  }

  .timeline-content p {
    color:
      var(--text-secondary);

    font-size:
      12px;
  }

  .tag-list {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      6px;
  }

  .tag-list span {
    max-width:
      100%;

    padding:
      4px 7px;

    border-radius:
      999px;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size:
      8px;

    overflow-wrap:
      anywhere;
  }

  .item-arrow {
    width:
      32px;

    height:
      32px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      10px;
  }

  :global(html.mobile-device)
  .archive-hero {
    min-height:
      auto;

    padding:
      56px 0 60px;

    grid-template-columns:
      minmax(0, 1fr);

    gap:
      42px;
  }

  :global(html.mobile-device)
  .archive-copy h1 {
    font-size:
      clamp(
        44px,
        13vw,
        62px
      );
  }

  :global(html.mobile-device)
  .archive-stats {
    width:
      100%;

    transform:
      none;
  }

  :global(html.mobile-device)
  .stats-main {
    min-height:
      175px;

    padding:
      22px;
  }

  :global(html.mobile-device)
  .stats-main strong {
    font-size:
      58px;
  }

  :global(html.mobile-device)
  .timeline-section {
    padding-top:
      60px;
  }

  :global(html.mobile-device)
  .year-group {
    grid-template-columns:
      minmax(0, 1fr);

    gap:
      24px;

    padding:
      44px 0;
  }

  :global(html.mobile-device)
  .year-sticky {
    position:
      static;

    flex-direction:
      row;

    align-items:
      baseline;

    gap:
      10px;
  }

  :global(html.mobile-device)
  .timeline-card {
    grid-template-columns:
      45px
      minmax(0, 1fr);

    gap:
      14px;

    padding:
      18px;
  }

  :global(html.mobile-device)
  .item-arrow {
    display:
      none;
  }

  @media (
    max-width: 700px
  ) {
    .archive-hero {
      grid-template-columns:
        1fr;
    }

    .year-group {
      grid-template-columns:
        1fr;
    }

    .timeline-card {
      grid-template-columns:
        45px 1fr;
    }

    .item-arrow {
      display:
        none;
    }
  }
</style>