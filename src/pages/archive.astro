    margin:
      10px 0 7px;

    font-size:
      19px;

    line-height:
      1.4;

    letter-spacing:
      -0.025em;
  }

  .timeline-content > p {
    margin:
      0;

    color:
      var(--text-secondary);

    font-size:
      12px;

    line-height:
      1.75;
  }

  .tag-list {
    margin-top:
      15px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      6px;
  }

  .tag-list span {
    padding:
      4px 7px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size:
      8px;

    font-weight:
      600;
  }

  .timeline-end {
    min-width:
      34px;

    height:
      100%;

    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    flex-direction:
      column;
  }

  .item-number {
    color:
      var(--text-muted);

    font-size:
      8px;

    font-weight:
      750;

    letter-spacing:
      0.08em;
  }

  .item-arrow {
    width:
      32px;

    height:
      32px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      10px;

    background:
      var(--color-surface-elevated);

    color:
      var(--text-muted);

    transition:
      transform
        var(--transition-fast),
      color
        var(--transition-fast),
      border-color
        var(--transition-fast);
  }

  .timeline-card:hover
  .item-arrow {
    transform:
      translate(
        2px,
        -2px
      );

    border-color:
      var(--border-strong);

    color:
      var(--color-primary);
  }

  .empty-section {
    padding:
      80px 0;
  }

  .empty-state {
    padding:
      70px 24px;

    display:
      flex;

    align-items:
      center;

    flex-direction:
      column;

    border:
      1px dashed
      var(--border-strong);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);

    text-align:
      center;
  }

  .empty-symbol {
    color:
      var(--color-primary);

    font-size:
      26px;
  }

  .empty-state h2 {
    margin:
      16px 0 0;
  }

  .empty-state p {
    margin:
      8px 0 0;

    color:
      var(--text-secondary);
  }

  .empty-state a {
    margin-top:
      22px;

    color:
      var(--color-primary);

    font-size:
      12px;

    font-weight:
      650;
  }

  @media (
    max-width: 900px
  ) {
    .archive-hero {
      grid-template-columns:
        1fr;

      gap:
        46px;
    }

    .archive-stats {
      width:
        min(
          100%,
          580px
        );

      transform:
        none;
    }

    .year-group {
      grid-template-columns:
        110px
        minmax(0, 1fr);

      gap:
        32px;
    }
  }

  @media (
    max-width: 700px
  ) {
    .archive-hero {
      min-height:
        auto;

      padding:
        56px 0 60px;
    }

    .archive-copy h1 {
      font-size:
        clamp(
          44px,
          14vw,
          62px
        );
    }

    .archive-stats {
      border-radius:
        22px;
    }

    .stats-main {
      min-height:
        175px;

      padding:
        22px;
    }

