---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    name: "FJK Blog",
    description:
      "从零开始构建并持续维护的个人博客，用来记录技术学习、项目开发、工具使用与个人内容。",
    status: "Active",
    type: "Personal Project",
    year: "2026",
    stack: [
      "Astro 7",
      "TypeScript",
      "Tailwind CSS 4",
      "Markdown",
      "Nginx",
    ],
    github:
      "https://github.com/jiashuaifu13-blip/fjk-blog",
    demo:
      "https://fjksp.cn",
    featured: true,
  },
  {
    name: "Future Project",
    description:
      "新的项目正在规划中。这里会继续记录后续完成的 Web 项目、工具和实验作品。",
    status: "Planning",
    type: "Coming Soon",
    year: "—",
    stack: [
      "Ideas",
      "Learning",
      "Building",
    ],
    github: "",
    demo: "",
    featured: false,
  },
];

const activeProjects =
  projects.filter(
    (project) =>
      project.status === "Active"
  ).length;

const totalTechnologies =
  new Set(
    projects.flatMap(
      (project) =>
        project.stack
    )
  ).size;
---

<Layout
  title="项目"
  description="FJK 的个人项目与开发作品，记录从想法到实现的过程。"
>
  <section class="projects-hero">
    <div class="hero-copy">
      <div class="hero-badge">
        <span
          class="badge-dot"
          aria-hidden="true"
        ></span>

        <span>
          PROJECTS
        </span>
      </div>

      <p class="hero-kicker">
        Build, learn, repeat.
      </p>

      <h1>
        把想法，
        <span>
          做成真正的东西。
        </span>
      </h1>

      <p class="hero-description">
        这里记录我正在开发、已经完成，
        或者准备继续探索的个人项目。
        比起单纯展示结果，我更想保留从想法到实现的过程。
      </p>

      <div class="hero-actions">
        <a
          class="primary-action"
          href="#project-list"
        >
          <span>
            查看项目
          </span>

          <span
            aria-hidden="true"
          >
            ↓
          </span>
        </a>

        <a
          class="secondary-action"
          href="https://github.com/jiashuaifu13-blip"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </div>

    <div
      class="hero-panel"
      aria-hidden="true"
    >
      <div class="panel-orbit orbit-one"></div>
      <div class="panel-orbit orbit-two"></div>

      <div class="panel-card">
        <div class="panel-header">
          <span>
            PROJECT INDEX
          </span>

          <span>
            2026
          </span>
        </div>

        <div class="panel-main">
          <strong>
            {String(
              projects.length
            ).padStart(
              2,
              "0"
            )}
          </strong>

          <span>
            PROJECTS
          </span>
        </div>

        <div class="panel-grid">
          <div>
            <span>
              ACTIVE
            </span>

            <strong>
              {activeProjects}
            </strong>
          </div>

          <div>
            <span>
              STACK
            </span>

            <strong>
              {totalTechnologies}
            </strong>
          </div>

          <div>
            <span>
              FOCUS
            </span>

            <strong>
              WEB
            </strong>
          </div>

          <div>
            <span>
              MODE
            </span>

            <strong>
              BUILD
            </strong>
          </div>
        </div>
      </div>

      <span class="panel-label label-left">
        DEV / LAB
      </span>

      <span class="panel-label label-right">
        ✦ KEEP BUILDING
      </span>
    </div>
  </section>

  <section
    id="project-list"
    class="projects-section"
  >
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          SELECTED WORK
        </p>

        <h2>
          项目列表
        </h2>

        <p class="section-description">
          从个人博客开始，持续积累真正完成的项目。
        </p>
      </div>

      <span class="project-total">
        {projects.length} Projects
      </span>
    </div>

    <div class="project-list">
      {
        projects.map(
          (
            project,
            index
          ) => (
            <article
              class:list={[
                "project-card",
                {
                  featured:
                    project.featured,
                },
              ]}
            >
              <div class="project-number">
                <span>
                  PROJECT
                </span>

                <strong>
                  {String(
                    index + 1
                  ).padStart(
                    2,
                    "0"
                  )}
                </strong>
              </div>

              <div class="project-content">
                <div class="project-topline">
                  <div class="project-status">
                    <span
                      class:list={[
                        "status-dot",
                        {
                          active:
                            project.status ===
                            "Active",
                        },
                      ]}
                    ></span>

                    <span>
                      {project.status}
                    </span>
                  </div>

                  <span class="project-type">
                    {project.type}
                  </span>
                </div>

                <h3>
                  {project.name}
                </h3>

                <p class="project-description">
                  {project.description}
                </p>

                <div class="project-stack">
                  {
                    project.stack.map(
                      (item) => (
                        <span>
                          {item}
                        </span>
                      )
                    )
                  }
                </div>

                <div class="project-meta">
                  <div>
                    <span>
                      YEAR
                    </span>

                    <strong>
                      {project.year}
                    </strong>
                  </div>

                  <div>
                    <span>
                      STATUS
                    </span>

                    <strong>
                      {project.status}
                    </strong>
                  </div>

                  <div>
                    <span>
                      TYPE
                    </span>

                    <strong>
                      {project.type}
                    </strong>
                  </div>
                </div>

                {
                  (
                    project.demo ||
                    project.github
                  ) && (
                    <div class="project-actions">
                      {
                        project.demo && (
                          <a
                            class="project-primary"
                            href={
                              project.demo
                            }
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            在线访问

                            <span
                              aria-hidden="true"
                            >
                              ↗
                            </span>
                          </a>
                        )
                      }

                      {
                        project.github && (
                          <a
                            class="project-secondary"
                            href={
                              project.github
                            }
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            GitHub

                            <span
                              aria-hidden="true"
                            >
                              ↗
                            </span>
                          </a>
                        )
                      }
                    </div>
                  )
                }
              </div>

              <div
                class="project-preview"
                aria-hidden="true"
              >
                {
                  project.featured ? (
                    <div class="browser-window">
                      <div class="browser-bar">
                        <div class="window-dots">
                          <span></span>
                          <span></span>
                          <span></span>
                        </div>

                        <span class="window-url">
                          fjksp.cn
                        </span>
                      </div>

                      <div class="browser-body">
                        <div class="browser-nav">
                          <div class="mini-logo">
                            F
                          </div>

                          <div class="mini-links">
                            <span></span>
                            <span></span>
                            <span></span>
                          </div>
                        </div>

                        <div class="browser-hero">
                          <span class="mini-badge">
                            PERSONAL BLOG
                          </span>

                          <strong>
                            FJK
                          </strong>

                          <p>
                            Anime Soft Tech
                          </p>

                          <div class="mini-button"></div>
                        </div>
                      </div>
                    </div>
                  ) : (
                    <div class="future-window">
                      <span class="future-symbol">
                        ✦
                      </span>

                      <strong>
                        NEXT
                      </strong>

                      <p>
                        Something new
                        <br />
                        is coming.
                      </p>

                      <span class="future-code">
                        02 / TBD
                      </span>
                    </div>
                  )
                }
              </div>
            </article>
          )
        )
      }
    </div>
  </section>

  <section class="process-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          WORKFLOW
        </p>

        <h2>
          我的项目流程
        </h2>

        <p class="section-description">
          不追求一次完成，而是不断规划、实现、测试和改进。
        </p>
      </div>
    </div>

    <div class="process-grid">
      <div class="process-card">
        <span class="process-index">
          01
        </span>

        <h3>
          规划
        </h3>

        <p>
          明确要解决的问题、功能范围和实现方向。
        </p>
      </div>

      <div class="process-card">
        <span class="process-index">
          02
        </span>

        <h3>
          落地
        </h3>

        <p>
          从最小可用版本开始，把想法真正写成代码。
        </p>
      </div>

      <div class="process-card">
        <span class="process-index">
          03
        </span>

        <h3>
          测试
        </h3>

        <p>
          检查功能、响应式、构建和部署是否稳定。
        </p>
      </div>

      <div class="process-card">
        <span class="process-index">
          04
        </span>

        <h3>
          迭代
        </h3>

        <p>
          根据实际使用持续优化，而不是停在第一版。
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects-hero {
    min-height:
      660px;

    padding:
      76px 0 82px;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(360px, 0.78fr);

    align-items:
      center;

    gap:
      74px;

    border-bottom:
      1px solid
      var(--border);
  }

  .hero-badge {
    width:
      fit-content;

    padding:
      7px 11px;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    font-size:
      9px;

    font-weight:
      800;

    letter-spacing:
      0.14em;
  }

  .badge-dot {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        var(--color-cyan)
          15%,
        transparent
      );
  }

  .hero-kicker {
    margin:
      24px 0 0;

    color:
      var(--color-primary);

    font-size:
      14px;

    font-weight:
      700;
  }

  .hero-copy h1 {
    max-width:
      720px;

    margin:
      12px 0 0;

    font-size:
      clamp(
        48px,
        6.5vw,
        78px
      );

    line-height:
      1.07;

    letter-spacing:
      -0.055em;
  }

  .hero-copy h1 span {
    display:
      block;

    background:
      linear-gradient(
        100deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;
  }

  .hero-description {
    max-width:
      640px;

    margin:
      26px 0 0;

    color:
      var(--text-secondary);

    font-size:
      15px;

    line-height:
      1.9;
  }

  .hero-actions {
    margin-top:
      32px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      10px;
  }

  .primary-action,
  .secondary-action {
    min-height:
      46px;

    padding:
      0 17px;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      9px;

    border-radius:
      13px;

    font-size:
      12px;

    font-weight:
      650;

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .primary-action {
    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-primary)
          55%,
        transparent
      );

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary)
      );

    color:
      #ffffff;

    box-shadow:
      0 12px 28px
      color-mix(
        in srgb,
        var(--color-primary)
          24%,
        transparent
      );
  }

  .primary-action:hover {
    color:
      #ffffff;

    transform:
      translateY(-3px);
  }

  .secondary-action {
    border:
      1px solid
      var(--border);

    background:
      var(--color-surface);

    color:
      var(--text-primary);

    box-shadow:
      var(--shadow-sm);
  }

  .secondary-action:hover {
    transform:
      translateY(-3px);

    border-color:
      var(--border-strong);

    color:
      var(--color-primary);
  }

  .hero-panel {
    position:
      relative;

    min-height:
      420px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;
  }

  .panel-orbit {
    position:
      absolute;

    border:
      1px dashed
      color-mix(
        in srgb,
        var(--color-primary)
          24%,
        transparent
      );

    border-radius:
      50%;
  }

  .orbit-one {
    width:
      370px;

    height:
      370px;

    transform:
      rotate(18deg);
  }

  .orbit-two {
    width:
      290px;

    height:
      290px;

    border-color:
      color-mix(
        in srgb,
        var(--color-pink)
          22%,
        transparent
      );

    transform:
      rotate(-22deg);
  }

  .panel-card {
    position:
      relative;

    z-index:
      2;

    width:
      min(
        100%,
        360px
      );

    padding:
      24px;

    border:
      1px solid
      var(--glass-border);

    border-radius:
      28px;

    background:
      var(--glass-background);

    box-shadow:
      var(--shadow-card);

    backdrop-filter:
      blur(
        var(--glass-blur)
      );

    -webkit-backdrop-filter:
      blur(
        var(--glass-blur)
      );

    transform:
      rotate(-2deg);
  }

  .panel-header {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    color:
      var(--text-muted);

    font-size:
      8px;

    font-weight:
      750;

    letter-spacing:
      0.12em;
  }

  .panel-main {
    min-height:
      165px;

    display:
      flex;

    justify-content:
      center;

    flex-direction:
      column;
  }

  .panel-main strong {
    color:
      var(--color-primary);

    font-size:
      68px;

    line-height:
      0.9;

    letter-spacing:
      -0.06em;
  }

  .panel-main span {
    margin-top:
      9px;

    color:
      var(--text-secondary);

    font-size:
      10px;

    font-weight:
      750;

    letter-spacing:
      0.11em;
  }

  .panel-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      8px;
  }

  .panel-grid div {
    padding:
      12px;

    display:
      flex;

    flex-direction:
      column;

    gap:
      6px;

    border:
      1px solid
      var(--border);

    border-radius:
      13px;

    background:
      color-mix(
        in srgb,
        var(--color-surface)
          78%,
        transparent
      );
  }

  .panel-grid span {
    color:
      var(--text-muted);

    font-size:
      7px;

    font-weight:
      750;

    letter-spacing:
      0.11em;
  }

  .panel-grid strong {
    font-size:
      11px;
  }

  .panel-label {
    position:
      absolute;

    z-index:
      4;

    padding:
      8px 10px;

    border:
      1px solid
      var(--border);

    border-radius:
      10px;

    background:
      var(--color-surface-elevated);

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    font-size:
      8px;

    font-weight:
      750;

    letter-spacing:
      0.08em;
  }

  .label-left {
    left:
      0;

    top:
      110px;

    transform:
      rotate(-7deg);
  }

  .label-right {
    right:
      0;

    bottom:
      92px;

    transform:
      rotate(6deg);
  }

  .projects-section,
  .process-section {
    padding:
      80px 0;

    border-bottom:
      1px solid
      var(--border);
  }

  .process-section {
    border-bottom:
      0;
  }

  .section-heading {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap:
      30px;
  }

  .section-eyebrow {
    margin:
      0 0 9px;

    color:
      var(--color-primary);

    font-size:
      9px;

    font-weight:
      800;

    letter-spacing:
      0.15em;
  }

  .section-heading h2 {
    margin:
      0;

    font-size:
      clamp(
        30px,
        4vw,
        42px
      );

    letter-spacing:
      -0.045em;
  }

  .section-description {
    margin:
      10px 0 0;

    color:
      var(--text-secondary);

    font-size:
      13px;
  }

  .project-total {
    padding:
      7px 10px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    color:
      var(--text-muted);

    font-size:
      10px;

    font-weight:
      700;
  }

  .project-list {
    margin-top:
      36px;

    display:
      flex;

    flex-direction:
      column;

    gap:
      24px;
  }

  .project-card {
    min-height:
      410px;

    padding:
      30px;

    display:
      grid;

    grid-template-columns:
      90px
      minmax(0, 1fr)
      minmax(300px, 0.8fr);

    align-items:
      stretch;

    gap:
      34px;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-card);

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .project-card:hover {
    transform:
      translateY(-4px);

    border-color:
      var(--border-strong);

    box-shadow:
      var(--shadow-hover);
  }

  .project-card.featured {
    background:
      linear-gradient(
        135deg,
        var(--color-surface),
        color-mix(
          in srgb,
          var(--color-primary-soft)
            48%,
          var(--color-surface)
        )
      );
  }

  .project-number {
    display:
      flex;

    flex-direction:
      column;

    justify-content:
      space-between;

    border-right:
      1px solid
      var(--border);
  }

  .project-number span {
    color:
      var(--text-muted);

    font-size:
      8px;

    font-weight:
      750;

    letter-spacing:
      0.12em;
  }

  .project-number strong {
    margin-bottom:
      4px;

    color:
      var(--color-primary);

    font-size:
      36px;

    line-height:
      1;

    letter-spacing:
      -0.05em;
  }

  .project-content {
    min-width:
      0;

    display:
      flex;

    flex-direction:
      column;
  }

  .project-topline {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    flex-wrap:
      wrap;

    gap:
      12px;
  }

  .project-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      7px;

    color:
      var(--text-secondary);

    font-size:
      9px;

    font-weight:
      650;
  }

  .status-dot {
    width:
      7px;

    height:
      7px;

    border-radius:
      50%;

    background:
      var(--text-muted);
  }

  .status-dot.active {
    background:
      #77d7b0;

    box-shadow:
      0 0 0 4px
      rgba(
        119,
        215,
        176,
        0.12
      );
  }

  .project-type {
    color:
      var(--text-muted);

    font-size:
      8px;

    font-weight:
      750;

    letter-spacing:
      0.1em;
  }

  .project-content h3 {
    margin:
      26px 0 0;

    font-size:
      clamp(
        30px,
        4vw,
        44px
      );

    line-height:
      1.1;

    letter-spacing:
      -0.045em;
  }

  .project-description {
    max-width:
      600px;

    margin:
      17px 0 0;

    color:
      var(--text-secondary);

    font-size:
      13px;

    line-height:
      1.8;
  }

  .project-stack {
    margin-top:
      22px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      7px;
  }

  .project-stack span {
    padding:
      5px 8px;

    border:
