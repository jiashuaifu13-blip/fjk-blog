---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    name: "FJK Blog",
    description:
      "从零开始构建并持续维护的个人博客，用来记录技术学习、项目开发、工具使用与个人内容。",
    status: "Active",
    type: "Personal Project",
    year: "2026",
    stack: [
      "Astro 7",
      "TypeScript",
      "Tailwind CSS 4",
      "Markdown",
      "Nginx",
    ],
    github:
      "https://github.com/jiashuaifu13-blip/fjk-blog",
    demo:
      "https://fjksp.cn",
    featured: true,
  },
  {
    name: "Future Project",
    description:
      "新的项目正在规划中。这里会继续记录后续完成的 Web 项目、工具和实验作品。",
    status: "Planning",
    type: "Coming Soon",
    year: "—",
    stack: [
      "Ideas",
      "Learning",
      "Building",
    ],
    github: "",
    demo: "",
    featured: false,
  },
];

const activeProjects =
  projects.filter(
    (project) =>
      project.status ===
      "Active"
  ).length;

const totalTechnologies =
  new Set(
    projects.flatMap(
      (project) =>
        project.stack
    )
  ).size;
---

<Layout
  title="项目"
  description="FJK 的个人项目与开发作品。"
>
  <section class="projects-hero">
    <div class="hero-copy">
      <div class="hero-badge">
        <span></span>
        PROJECTS
      </div>

      <p class="hero-kicker">
        Build, learn, repeat.
      </p>

      <h1>
        把想法，
        <span>
          做成真正的东西。
        </span>
      </h1>

      <p class="hero-description">
        这里记录我正在开发、已经完成，
        或者准备继续探索的个人项目。
        比起单纯展示结果，我更想保留从想法到实现的过程。
      </p>

      <div class="hero-actions">
        <a
          class="primary-action"
          href="#project-list"
        >
          查看项目 ↓
        </a>

        <a
          class="secondary-action"
          href="https://github.com/jiashuaifu13-blip"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </div>

    <div class="hero-panel">
      <div class="panel-card">
        <div class="panel-header">
          <span>
            PROJECT INDEX
          </span>

          <span>
            2026
          </span>
        </div>

        <div class="panel-main">
          <strong>
            {String(
              projects.length
            ).padStart(
              2,
              "0"
            )}
          </strong>

          <span>
            PROJECTS
          </span>
        </div>

        <div class="panel-grid">
          <div>
            <span>
              ACTIVE
            </span>

            <strong>
              {activeProjects}
            </strong>
          </div>

          <div>
            <span>
              STACK
            </span>

            <strong>
              {totalTechnologies}
            </strong>
          </div>

          <div>
            <span>
              FOCUS
            </span>

            <strong>
              WEB
            </strong>
          </div>

          <div>
            <span>
              MODE
            </span>

            <strong>
              BUILD
            </strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    id="project-list"
    class="projects-section"
  >
    <div class="section-heading">
      <div>
        <p>
          SELECTED WORK
        </p>

        <h2>
          项目列表
        </h2>
      </div>

      <span>
        {projects.length} Projects
      </span>
    </div>

    <div class="project-list">
      {
        projects.map(
          (
            project,
            index
          ) => (
            <article class="project-card">
              <div class="project-number">
                <span>
                  PROJECT
                </span>

                <strong>
                  {String(
                    index + 1
                  ).padStart(
                    2,
                    "0"
                  )}
                </strong>
              </div>

              <div class="project-content">
                <div class="project-topline">
                  <span>
                    {project.status}
                  </span>

                  <span>
                    {project.type}
                  </span>
                </div>

                <h3>
                  {project.name}
                </h3>

                <p>
                  {project.description}
                </p>

                <div class="project-stack">
                  {
                    project.stack.map(
                      (item) => (
                        <span>
                          {item}
                        </span>
                      )
                    )
                  }
                </div>

                {
                  (
                    project.demo ||
                    project.github
                  ) && (
                    <div class="project-actions">
                      {
                        project.demo && (
                          <a
                            href={
                              project.demo
                            }
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            在线访问 ↗
                          </a>
                        )
                      }

                      {
                        project.github && (
                          <a
                            href={
                              project.github
                            }
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            GitHub ↗
                          </a>
                        )
                      }
                    </div>
                  )
                }
              </div>

              <div class="project-preview">
                {
                  project.featured ? (
                    <div class="browser-window">
                      <div class="browser-bar">
                        fjksp.cn
                      </div>

                      <div class="browser-body">
                        <strong>
                          FJK
                        </strong>

                        <span>
                          Anime Soft Tech
                        </span>
                      </div>
                    </div>
                  ) : (
                    <div class="future-window">
                      <span>
                        ✦
                      </span>

                      <strong>
                        NEXT
                      </strong>

                      <p>
                        Something new
                        is coming.
                      </p>
                    </div>
                  )
                }
              </div>
            </article>
          )
        )
      }
    </div>
  </section>

  <section class="process-section">
    <div class="section-heading">
      <div>
        <p>
          WORKFLOW
        </p>

        <h2>
          我的项目流程
        </h2>
      </div>
    </div>

    <div class="process-grid">
      {
        [
          ["01", "规划"],
          ["02", "落地"],
          ["03", "测试"],
          ["04", "迭代"],
        ].map(
          ([index, title]) => (
            <div class="process-card">
              <span>
                {index}
              </span>

              <h3>
                {title}
              </h3>
            </div>
          )
        )
      }
    </div>
  </section>
</Layout>

<style>
  .projects-hero {
    min-height:
      660px;

    padding:
      76px 0 82px;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(360px, 0.78fr);

    align-items:
      center;

    gap:
      74px;

    border-bottom:
      1px solid
      var(--border);
  }

  .projects-hero > * {
    min-width:
      0;
  }

  .hero-badge {
    width:
      fit-content;

    padding:
      7px 11px;

    display:
      flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);
  }

  .hero-badge span {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
      var(--color-cyan);
  }

  .hero-kicker {
    margin-top:
      24px;

    color:
      var(--color-primary);

    font-weight:
      700;

    word-break:
      keep-all;
  }

  .hero-copy h1 {
    margin:
      12px 0 0;

    font-size:
      clamp(
        48px,
        6.5vw,
        78px
      );

    line-height:
      1.07;

    word-break:
      normal;
  }

  .hero-copy h1 span {
    display:
      block;

    background:
      linear-gradient(
        100deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;
  }

  .hero-description {
    max-width:
      640px;

    color:
      var(--text-secondary);

    line-height:
      1.9;
  }

  .hero-actions {
    margin-top:
      32px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      10px;
  }

  .primary-action,
  .secondary-action {
    min-height:
      46px;

    padding:
      0 17px;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    border-radius:
      13px;
  }

  .primary-action {
    background:
      var(--color-primary);

    color:
      #ffffff;
  }

  .secondary-action {
    border:
      1px solid
      var(--border);

    background:
      var(--color-surface);
  }

  .hero-panel {
    min-width:
      0;

    display:
      flex;

    justify-content:
      center;
  }

  .panel-card {
    width:
      min(
        100%,
        360px
      );

    min-width:
      0;

    padding:
      24px;

    border:
      1px solid
      var(--border);

    border-radius:
      28px;

    background:
      var(--glass-background);

    box-shadow:
      var(--shadow-card);
  }

  .panel-header {
    display:
      flex;

    justify-content:
      space-between;

    color:
      var(--text-muted);

    font-size:
      8px;
  }

  .panel-main {
    min-height:
      165px;

    display:
      flex;

    justify-content:
      center;

    flex-direction:
      column;
  }

  .panel-main strong {
    color:
      var(--color-primary);

    font-size:
      68px;
  }

  .panel-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      8px;
  }

  .panel-grid div {
    min-width:
      0;

    padding:
      12px;

    border:
      1px solid
      var(--border);

    border-radius:
      13px;
  }

  .panel-grid span {
    color:
      var(--text-muted);

    font-size:
      7px;
  }

  .projects-section,
  .process-section {
    padding:
      80px 0;
  }

  .section-heading {
    display:
      flex;

    justify-content:
      space-between;

    align-items:
      flex-end;

    gap:
      20px;
  }

  .section-heading p {
    margin:
      0 0 8px;

    color:
      var(--color-primary);

    font-size:
      9px;
  }

  .section-heading h2 {
    margin:
      0;

    font-size:
      40px;
  }

  .project-list {
    margin-top:
      36px;

    display:
      flex;

    flex-direction:
      column;

    gap:
      24px;
  }

  .project-card {
    min-width:
      0;

    padding:
      30px;

    display:
      grid;

    grid-template-columns:
      90px
      minmax(0, 1fr)
      minmax(300px, 0.8fr);

    gap:
      34px;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);
  }

  .project-number {
    display:
      flex;

    flex-direction:
      column;

    justify-content:
      space-between;

    border-right:
      1px solid
      var(--border);
  }

  .project-number span {
    color:
      var(--text-muted);

    font-size:
      8px;
  }

  .project-number strong {
    color:
      var(--color-primary);

    font-size:
      36px;
  }

  .project-content {
    min-width:
      0;

    display:
      flex;

    flex-direction:
      column;
  }

  .project-topline {
    display:
      flex;

    justify-content:
      space-between;

    color:
      var(--text-muted);

    font-size:
      9px;
  }

  .project-content h3 {
    margin:
      26px 0 0;

    font-size:
      40px;

    word-break:
      normal;
  }

  .project-content > p {
    color:
      var(--text-secondary);

    line-height:
      1.8;
  }

  .project-stack {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      7px;
  }

  .project-stack span {
    max-width:
      100%;

    padding:
      5px 8px;

    border-radius:
      999px;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size:
      9px;

    overflow-wrap:
      anywhere;
  }

  .project-actions {
    margin-top:
      auto;

    padding-top:
      26px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      9px;
  }

  .project-actions a {
    min-height:
      42px;

    padding:
      0 14px;

    display:
      inline-flex;

    align-items:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      12px;
  }

  .project-preview {
    min-width:
      0;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;
  }

  .browser-window,
  .future-window {
    width:
      100%;

    min-width:
      0;

    min-height:
      250px;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      18px;
  }

  .browser-window {
    background:
      #111421;

    color:
      #ffffff;
  }

  .browser-bar {
    padding:
      14px;

    border-bottom:
      1px solid
      rgba(255,255,255,0.08);
  }

  .browser-body {
    min-height:
      200px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    flex-direction:
      column;
  }

  .browser-body strong {
    font-size:
      44px;
  }

  .browser-body span {
    color:
      #929ab8;
  }

  .future-window {
    padding:
      28px;

    display:
      flex;

    flex-direction:
      column;

    justify-content:
      flex-end;

    background:
      var(--color-primary-soft);
  }

  .future-window strong {
    color:
      var(--color-primary);

    font-size:
      36px;
  }

  .process-grid {
    margin-top:
      34px;

    display:
      grid;

    grid-template-columns:
      repeat(
        4,
        minmax(0, 1fr)
      );

    gap:
      14px;
  }

  .process-card {
    min-width:
      0;

    min-height:
      150px;

    padding:
      20px;

    display:
      flex;

    flex-direction:
      column;

    justify-content:
      space-between;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-lg);

    background:
      var(--color-surface);
  }

  .process-card span {
    color:
      var(--color-primary);

    font-size:
      9px;
  }

  .process-card h3 {
    margin:
      0;

    font-size:
      20px;
  }

  /* Runtime fallback */

  :global(html.mobile-device)
  .projects-hero {
    min-height:
      auto;

    padding:
      56px 0 60px;

    grid-template-columns:
      minmax(0, 1fr);

    gap:
      38px;
  }

  :global(html.mobile-device)
  .hero-copy h1 {
    font-size:
      clamp(
        44px,
        13vw,
        62px
      );
  }

  :global(html.mobile-device)
  .hero-actions {
    flex-direction:
      column;

    align-items:
      stretch;
  }

  :global(html.mobile-device)
  .primary-action,
  :global(html.mobile-device)
  .secondary-action {
    width:
      100%;
  }

  :global(html.mobile-device)
  .hero-panel {
    width:
      100%;
  }

  :global(html.mobile-device)
  .panel-card {
    width:
      min(
        100%,
        360px
      );
  }

  :global(html.mobile-device)
  .projects-section,
  :global(html.mobile-device)
  .process-section {
    padding:
      60px 0;
  }

  :global(html.mobile-device)
  .section-heading {
    align-items:
      flex-start;

    flex-direction:
      column;

    gap:
      15px;
  }

  :global(html.mobile-device)
  .project-card {
    padding:
      22px;

    grid-template-columns:
      minmax(0, 1fr);

    gap:
      24px;
  }

  :global(html.mobile-device)
  .project-number {
    padding-bottom:
      15px;

    flex-direction:
      row;

    align-items:
      center;

    border-right:
      0;

    border-bottom:
      1px solid
      var(--border);
  }

  :global(html.mobile-device)
  .project-number strong {
    font-size:
      28px;
  }

  :global(html.mobile-device)
  .project-content h3 {
    font-size:
      32px;
  }

  :global(html.mobile-device)
  .project-actions {
    align-items:
      stretch;

    flex-direction:
      column;
  }

  :global(html.mobile-device)
  .project-actions a {
    width:
      100%;

    justify-content:
      center;
  }

  :global(html.mobile-device)
  .process-grid {
    grid-template-columns:
      minmax(0, 1fr);
  }

  @media (
    max-width: 700px
  ) {
    .projects-hero {
      grid-template-columns:
        1fr;
    }

    .hero-actions {
      flex-direction:
        column;
    }

    .project-card {
      grid-template-columns:
        1fr;
    }

    .project-number {
      flex-direction:
        row;

      border-right:
        0;

      border-bottom:
        1px solid
        var(--border);
    }

    .process-grid {
      grid-template-columns:
        1fr;
    }
  }
</style>