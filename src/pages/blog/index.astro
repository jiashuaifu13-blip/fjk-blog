---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );

const categoryMap =
  new Map<string, number>();

const tagMap =
  new Map<string, number>();

for (const post of posts) {
  categoryMap.set(
    post.data.category,
    (categoryMap.get(
      post.data.category
    ) ?? 0) + 1
  );

  for (const tag of post.data.tags) {
    tagMap.set(
      tag,
      (tagMap.get(tag) ?? 0) + 1
    );
  }
}

const categories =
  Array.from(categoryMap.entries())
    .map(
      ([name, count]) => ({
        name,
        count,
      })
    )
    .sort(
      (a, b) =>
        b.count - a.count
    );

const tags =
  Array.from(tagMap.entries())
    .map(
      ([name, count]) => ({
        name,
        count,
      })
    )
    .sort(
      (a, b) =>
        b.count - a.count
    );
---

<Layout
  title="文章"
  description="FJK Blog 的全部文章，记录技术、项目、学习与生活。"
>
  <section class="blog-hero">
    <div class="blog-hero-copy">
      <div class="hero-badge">
        <span
          class="badge-dot"
          aria-hidden="true"
        ></span>

        <span>
          BLOG ARCHIVE
        </span>
      </div>

      <p class="hero-kicker">
        Stories & Notes
      </p>

      <h1>
        文章
      </h1>

      <p class="hero-description">
        这里整理我的技术学习、项目开发、
        工具使用与一些值得记录的想法。
      </p>
    </div>

    <div class="hero-stats">
      <div class="stat-card">
        <span class="stat-label">
          POSTS
        </span>

        <strong>
          {posts.length}
        </strong>

        <p>
          已发布文章
        </p>
      </div>

      <div class="stat-card">
        <span class="stat-label">
          CATEGORIES
        </span>

        <strong>
          {categories.length}
        </strong>

        <p>
          内容分类
        </p>
      </div>

      <div class="stat-card">
        <span class="stat-label">
          TAGS
        </span>

        <strong>
          {tags.length}
        </strong>

        <p>
          文章标签
        </p>
      </div>
    </div>
  </section>

  {
    categories.length > 0 && (
      <section class="filter-section">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">
              CATEGORIES
            </p>

            <h2>
              分类
            </h2>
          </div>

          <a
            class="archive-link"
            href="/archive"
          >
            查看归档

            <span
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </div>

        <div class="category-list">
          {
            categories.map(
              (category, index) => (
                <a
                  class="category-chip"
                  href={`/blog/category/${encodeURIComponent(
                    category.name
                  )}/`}
                >
                  <span class="category-number">
                    {String(
                      index + 1
                    ).padStart(
                      2,
                      "0"
                    )}
                  </span>

                  <span class="category-name">
                    {category.name}
                  </span>

                  <span class="category-count">
                    {category.count}
                  </span>
                </a>
              )
            )
          }
        </div>
      </section>
    )
  }

  <section class="posts-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          ALL POSTS
        </p>

        <h2>
          全部文章
        </h2>

        <p class="section-description">
          按发布时间从新到旧排列。
        </p>
      </div>

      <span class="post-total">
        {posts.length} Posts
      </span>
    </div>

    {
      posts.length > 0 ? (
        <div class="posts-grid">
          {
            posts.map(
              (post, index) => (
                <article class="post-card">
                  <a
                    class="post-card-link"
                    href={`/blog/${post.id}/`}
                  >
                    <div class="post-cover">
                      {
                        post.data.cover ? (
                          <img
                            src={post.data.cover}
                            alt={
                              post.data.coverAlt ??
                              post.data.title
                            }
                            loading={
                              index < 2
                                ? "eager"
                                : "lazy"
                            }
                          />
                        ) : (
                          <div class="cover-placeholder">
                            <span>
                              FJK
                            </span>
                          </div>
                        )
                      }

                      <div class="cover-overlay"></div>

                      <div class="post-index">
                        {String(
                          index + 1
                        ).padStart(
                          2,
                          "0"
                        )}
                      </div>
                    </div>

                    <div class="post-content">
                      <div class="post-meta">
                        <time
                          datetime={
                            post.data.date.toISOString()
                          }
                        >
                          {
                            post.data.date.toLocaleDateString(
                              "zh-CN",
                              {
                                year: "numeric",
                                month: "2-digit",
                                day: "2-digit",
                              }
                            )
                          }
                        </time>

                        <span
                          class="meta-dot"
                          aria-hidden="true"
                        >
                          ·
                        </span>

                        <span>
                          {post.data.category}
                        </span>
                      </div>

                      <h3>
                        {post.data.title}
                      </h3>

                      <p class="post-description">
                        {post.data.description}
                      </p>

                      {
                        post.data.tags.length >
                          0 && (
                          <div class="tag-list">
                            {
                              post.data.tags
                                .slice(0, 4)
                                .map(
                                  (tag) => (
                                    <span>
                                      #{tag}
                                    </span>
                                  )
                                )
                            }
                          </div>
                        )
                      }

                      <div class="post-footer">
                        <span>
                          阅读文章
                        </span>

                        <span
                          class="post-arrow"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      </div>
                    </div>
                  </a>
                </article>
              )
            )
          }
        </div>
      ) : (
        <div class="empty-state">
          <div
            class="empty-icon"
            aria-hidden="true"
          >
            ✦
          </div>

          <h2>
            暂时还没有文章
          </h2>

          <p>
            新内容正在准备中。
          </p>
        </div>
      )
    }
  </section>

  {
    tags.length > 0 && (
      <section class="tags-section">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">
              TOPICS
            </p>

            <h2>
              标签
            </h2>

            <p class="section-description">
              从关键词快速找到感兴趣的内容。
            </p>
          </div>
        </div>

        <div class="tag-cloud">
          {
            tags.map(
              (tag) => (
                <a
                  href={`/blog/tag/${encodeURIComponent(
                    tag.name
                  )}/`}
                >
                  <span>
                    #{tag.name}
                  </span>

                  <small>
                    {tag.count}
                  </small>
                </a>
              )
            )
          }
        </div>
      </section>
    )
  }
</Layout>

