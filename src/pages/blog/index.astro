---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.date.getTime() -
      a.data.date.getTime()
  );

const categoryMap =
  new Map<string, number>();

const tagMap =
  new Map<string, number>();

for (const post of posts) {
  categoryMap.set(
    post.data.category,
    (categoryMap.get(post.data.category) ?? 0) + 1
  );

  for (const tag of post.data.tags) {
    tagMap.set(
      tag,
      (tagMap.get(tag) ?? 0) + 1
    );
  }
}

const categories =
  Array.from(categoryMap.entries())
    .map(([name, count]) => ({
      name,
      count,
    }))
    .sort(
      (a, b) =>
        b.count - a.count
    );

const tags =
  Array.from(tagMap.entries())
    .map(([name, count]) => ({
      name,
      count,
    }))
    .sort(
      (a, b) =>
        b.count - a.count
    );

const getVisualCover = (
  post: (typeof posts)[number]
) =>
  post.data.cover ??
  "/images/anime/covers/soft-pink.webp";
---

<Layout
  title="文章"
  description="FJK Blog 的全部文章，记录技术、项目、学习与生活。"
>
  <section class="blog-hero">
    <div
      class="hero-decoration"
      aria-hidden="true"
    >
      <div class="hero-glow hero-glow-primary"></div>
      <div class="hero-glow hero-glow-pink"></div>

      <span class="hero-star hero-star-one">
        ✦
      </span>

      <span class="hero-star hero-star-two">
        ✧
      </span>
    </div>

    <div class="blog-hero-copy">
      <div class="hero-badge">
        <span
          class="badge-dot"
          aria-hidden="true"
        ></span>

        <span>
          BLOG ARCHIVE
        </span>
      </div>

      <p class="hero-kicker">
        Stories & Notes
      </p>

      <h1>
        写下一些，
        <span>
          值得留下的东西。
        </span>
      </h1>

      <p class="hero-description">
        技术学习、项目开发、工具使用，
        以及偶尔出现的生活记录。
        这里是 FJK Blog 的全部文章。
      </p>
    </div>

    <div class="hero-stats">
      <div class="stat-card">
        <span class="stat-label">
          POSTS
        </span>

        <strong>
          {String(posts.length).padStart(2, "0")}
        </strong>

        <p>
          已发布文章
        </p>
      </div>

      <div class="stat-card">
        <span class="stat-label">
          CATEGORIES
        </span>

        <strong>
          {String(categories.length).padStart(2, "0")}
        </strong>

        <p>
          内容分类
        </p>
      </div>

      <div class="stat-card">
        <span class="stat-label">
          TAGS
        </span>

        <strong>
          {String(tags.length).padStart(2, "0")}
        </strong>

        <p>
          文章标签
        </p>
      </div>
    </div>
  </section>

  {
    categories.length > 0 && (
      <section class="category-section">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">
              EXPLORE
            </p>

            <h2>
              按分类浏览
            </h2>
          </div>

          <a
            class="section-link"
            href="/archive"
          >
            查看归档

            <span aria-hidden="true">
              →
            </span>
          </a>
        </div>

        <div class="category-list">
          {
            categories.map(
              (category, index) => (
                <a
                  class="category-chip"
                  href={`/blog/category/${encodeURIComponent(
                    category.name
                  )}/`}
                >
                  <span class="category-index">
                    {String(index + 1).padStart(
                      2,
                      "0"
                    )}
                  </span>

                  <span class="category-name">
                    {category.name}
                  </span>

                  <span class="category-count">
                    {category.count}
                  </span>
                </a>
              )
            )
          }
        </div>
      </section>
    )
  }

  <section class="posts-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          ALL STORIES
        </p>

        <h2>
          全部文章
        </h2>

        <p class="section-description">
          从最近写下的内容开始。
        </p>
      </div>

      <span class="post-total">
        {posts.length}
        {" "}
        Posts
      </span>
    </div>

    {
      posts.length > 0 ? (
        <div class="posts-grid">
          {
            posts.map(
              (post, index) => {
                const cover =
                  getVisualCover(post);

                const isFeatured =
                  index === 0;

                return (
                  <article
                    class:list={[
                      "post-card",
                      {
                        "post-card-featured":
                          isFeatured,
                      },
                    ]}
                  >
                    <div
                      class="post-holo"
                      aria-hidden="true"
                    ></div>

                    <a
                      class="post-card-link"
                      href={`/blog/${post.id}/`}
                    >
                      <div class="post-cover">
                        <img
                          src={cover}
                          alt={
                            post.data.coverAlt ??
                            post.data.title
                          }
                          loading={
                            isFeatured
                              ? "eager"
                              : "lazy"
                          }
                        />

                        <div class="cover-shade"></div>
                        <div class="cover-tint"></div>

                        <div class="cover-topline">
                          <span class="post-number">
                            {String(
                              index + 1
                            ).padStart(
                              2,
                              "0"
                            )}
                          </span>

                          {
                            isFeatured && (
                              <span class="featured-label">
                                FEATURED
                              </span>
                            )
                          }
                        </div>

                        <div class="cover-category">
                          {post.data.category}
                        </div>

                        <span
                          class="cover-spark"
                          aria-hidden="true"
                        >
                          ✦
                        </span>
                      </div>

                      <div class="post-content">
                        <div class="post-meta">
                          <time
                            datetime={
                              post.data.date.toISOString()
                            }
                          >
                            {
                              post.data.date.toLocaleDateString(
                                "zh-CN",
                                {
                                  year:
                                    "numeric",
                                  month:
                                    "2-digit",
                                  day:
                                    "2-digit",
                                }
                              )
                            }
                          </time>

                          <span
                            class="meta-dot"
                            aria-hidden="true"
                          >
                            ·
                          </span>

                          <span>
                            {post.data.category}
                          </span>
                        </div>

                        <h3>
                          {post.data.title}
                        </h3>

                        <p class="post-description">
                          {post.data.description}
                        </p>

                        {
                          post.data.tags.length >
                            0 && (
                            <div class="tag-list">
                              {
                                post.data.tags
                                  .slice(
                                    0,
                                    isFeatured
                                      ? 5
                                      : 4
                                  )
                                  .map(
                                    (tag) => (
                                      <span>
                                        #{tag}
                                      </span>
                                    )
                                  )
                              }
                            </div>
                          )
                        }

                        <div class="post-footer">
                          <span>
                            阅读文章
                          </span>

                          <span
                            class="post-arrow"
                            aria-hidden="true"
                          >
                            ↗
                          </span>
                        </div>
                      </div>
                    </a>
                  </article>
                );
              }
            )
          }
        </div>
      ) : (
        <div class="empty-state">
          <div
            class="empty-icon"
            aria-hidden="true"
          >
            ✦
          </div>

          <h2>
            暂时还没有文章
          </h2>

          <p>
            新内容正在准备中。
          </p>
        </div>
      )
    }
  </section>

  {
    tags.length > 0 && (
      <section class="tags-section">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">
              TOPICS
            </p>

            <h2>
              标签
            </h2>

            <p class="section-description">
              从关键词继续探索。
            </p>
          </div>
        </div>

        <div class="tag-cloud">
          {
            tags.map(
              (tag) => (
                <a
                  href={`/blog/tag/${encodeURIComponent(
                    tag.name
                  )}/`}
                >
                  <span>
                    #{tag.name}
                  </span>

                  <small>
                    {tag.count}
                  </small>
                </a>
              )
            )
          }
        </div>
      </section>
    )
  }
</Layout>

<style>
  .blog-hero {
    position: relative;
    min-width: 0;
    padding: 88px 0 76px;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(360px, 0.76fr);

    align-items: end;
    gap: 72px;

    overflow: hidden;

    border-bottom:
      1px solid var(--border);

    isolation: isolate;
  }

  .blog-hero > * {
    min-width: 0;
  }

  .hero-decoration {
    position: absolute;
    z-index: -1;
    inset: 0;

    overflow: hidden;

    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(14px);
  }

  .hero-glow-primary {
    width: 420px;
    height: 420px;

    right: 7%;
    top: -220px;

    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--color-primary) 19%,
          transparent
        ),
        transparent 70%
      );
  }

  .hero-glow-pink {
    width: 340px;
    height: 340px;

    right: -100px;
    bottom: -180px;

    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--color-pink) 14%,
          transparent
        ),
        transparent 70%
      );
  }

  .hero-star {
    position: absolute;

    color:
      var(--color-primary);

    opacity: 0.68;
  }

  .hero-star-one {
    right: 38%;
    top: 74px;

    font-size: 22px;
  }

  .hero-star-two {
    right: 8%;
    bottom: 54px;

    color:
      var(--color-pink);

    font-size: 17px;
  }

  .hero-badge {
    width: fit-content;

    padding: 7px 11px;

    display: inline-flex;
    align-items: center;

    gap: 8px;

    border:
      1px solid var(--border);

    border-radius: 999px;

    background:
      color-mix(
        in srgb,
        var(--color-surface) 84%,
        transparent
      );

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    backdrop-filter:
      blur(10px);

    -webkit-backdrop-filter:
      blur(10px);

    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.14em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        var(--color-cyan) 14%,
        transparent
      );
  }

  .hero-kicker {
    margin:
      24px 0 0;

    color:
      var(--color-primary);

    font-size: 14px;
    font-weight: 700;

    word-break: keep-all;
  }

  .blog-hero h1 {
    max-width: 760px;

    margin:
      12px 0 0;

    font-size:
      clamp(
        52px,
        7vw,
        82px
      );

    line-height: 1.04;

    letter-spacing:
      -0.06em;

    word-break: keep-all;
  }

  .blog-hero h1 span {
    display: block;

    background:
      linear-gradient(
        100deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;
  }

  .hero-description {
    max-width: 620px;

    margin:
      25px 0 0;

    color:
      var(--text-secondary);

    font-size: 16px;
    line-height: 1.9;
  }

  .hero-stats {
    min-width: 0;

    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 10px;
  }

  .stat-card {
    position: relative;

    min-width: 0;
    min-height: 150px;

    padding: 18px;

    display: flex;
    flex-direction: column;
    justify-content: flex-end;

    overflow: hidden;

    border:
      1px solid var(--border);

    border-radius:
      var(--radius-lg);

    background:
      linear-gradient(
        145deg,
        var(--color-surface),
        color-mix(
          in srgb,
          var(--color-primary-soft) 18%,
          var(--color-surface)
        )
      );

    box-shadow:
      var(--shadow-sm);
  }

  .stat-card::after {
    content: "";

    position: absolute;

    width: 90px;
    height: 90px;

    right: -48px;
    top: -50px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--color-primary) 18%,
          transparent
        ),
        transparent 72%
      );
  }

  .stat-label {
    margin-bottom: auto;

    color:
      var(--text-muted);

    font-size: 8px;
    font-weight: 800;

    letter-spacing:
      0.12em;
  }

  .stat-card strong {
    font-size: 30px;
    line-height: 1;
  }

  .stat-card p {
    margin:
      8px 0 0;

    color:
      var(--text-secondary);

    font-size: 10px;
  }

  .category-section,
  .posts-section,
  .tags-section {
    min-width: 0;

    padding: 78px 0;

    border-bottom:
      1px solid var(--border);
  }

  .tags-section {
    border-bottom: 0;
  }

  .section-heading {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: 32px;
  }

  .section-heading > * {
    min-width: 0;
  }

  .section-eyebrow {
    margin:
      0 0 9px;

    color:
      var(--color-primary);

    font-size: 10px;
    font-weight: 800;

    letter-spacing:
      0.15em;
  }

  .section-heading h2 {
    margin: 0;

    font-size:
      clamp(
        30px,
        4vw,
        42px
      );

    letter-spacing:
      -0.045em;
  }

  .section-description {
    margin:
      10px 0 0;

    color:
      var(--text-secondary);

    font-size: 13px;
  }

  .section-link {
    display:
      inline-flex;

    align-items:
      center;

    gap: 7px;

    flex-shrink: 0;

    color:
      var(--text-secondary);

    font-size: 13px;
    font-weight: 600;
  }

  .category-list {
    margin-top: 30px;

    display: flex;

    flex-wrap: wrap;

    gap: 10px;
  }

  .category-chip {
    min-width: 0;
    min-height: 46px;

    padding:
      5px 13px 5px 6px;

    display:
      inline-flex;

    align-items:
      center;

    gap: 9px;

    border:
      1px solid var(--border);

    border-radius: 999px;

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-sm);

    transition:
      transform
        var(--transition-fast),
      border-color
        var(--transition-fast),
      box-shadow
        var(--transition-fast);
  }

  .category-chip:hover {
    transform:
      translateY(-2px);

    border-color:
      color-mix(
        in srgb,
        var(--color-primary) 34%,
        var(--border)
      );

    box-shadow:
      0 12px 26px
      color-mix(
        in srgb,
        var(--color-primary) 9%,
        transparent
      );
  }

  .category-index {
    width: 34px;
    height: 34px;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size: 9px;
    font-weight: 800;
  }

  .category-name {
    color:
      var(--text-primary);

    font-size: 12px;
    font-weight: 650;

    word-break: keep-all;
  }

  .category-count {
    min-width: 20px;

    color:
      var(--text-muted);

    font-size: 10px;

    text-align: right;
  }

  .post-total {
    padding:
      7px 10px;

    border:
      1px solid var(--border);

    border-radius: 999px;

    background:
      var(--color-surface);

    color:
      var(--text-muted);

    font-size: 10px;
    font-weight: 700;
  }

  .posts-grid {
    min-width: 0;

    margin-top: 36px;

    display: grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap: 22px;
  }

  .post-card {
    position: relative;

    min-width: 0;

    overflow: hidden;

    border:
      1px solid var(--border);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-card);

    isolation: isolate;

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .post-card:hover {
    transform:
      translateY(-5px);

    border-color:
      color-mix(
        in srgb,
        var(--color-primary) 35%,
        var(--border)
      );

    box-shadow:
      0 28px 62px
      color-mix(
        in srgb,
        var(--color-primary) 12%,
        transparent
      );
  }

  .post-card-featured {
    grid-column:
      1 / -1;
  }

  .post-holo {
    position: absolute;

    z-index: 1;

    inset: 0;

    background-image:
      url(
        "/images/anime/effects/holo.webp"
      );

    background-position: center;
    background-size: cover;

    mix-blend-mode:
      soft-light;

    opacity: 0;

    pointer-events: none;

    transition:
      opacity 320ms ease,
      transform 600ms ease;
  }

  .post-card:hover
  .post-holo {
    opacity: 0.09;

    transform:
      scale(1.06)
      rotate(1deg);
  }

  .post-card-link {
    position: relative;

    z-index: 2;

    height: 100%;

    display: flex;
    flex-direction: column;
  }

  .post-card-featured
  .post-card-link {
    display: grid;

    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(320px, 0.8fr);
  }

  .post-cover {
    position: relative;

    min-width: 0;

    aspect-ratio:
      16 / 9;

    overflow: hidden;

    background:
      var(--color-primary-soft);
  }

  .post-card-featured
  .post-cover {
    min-height: 420px;
    aspect-ratio: auto;
  }

  .post-cover img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform
        650ms
        cubic-bezier(
          0.2,
          0.8,
          0.2,
          1
        ),
      filter
        450ms ease;
  }

  .post-card:hover
  .post-cover img {
    transform:
      scale(1.045);

    filter:
      saturate(1.06)
      contrast(1.01);
  }

  .cover-shade,
  .cover-tint {
    position: absolute;

    inset: 0;

    pointer-events: none;
  }

  .cover-shade {
    background:
      linear-gradient(
        180deg,
        rgba(
          10,
          12,
          24,
          0.02
        ) 20%,
        rgba(
          10,
          12,
          24,
          0.1
        ) 62%,
        rgba(
          10,
          12,
          24,
          0.46
        ) 100%
      );
  }

  .cover-tint {
    background:
      linear-gradient(
        135deg,
        color-mix(
          in srgb,
          var(--color-primary) 7%,
          transparent
        ),
        transparent 46%,
        color-mix(
          in srgb,
          var(--color-pink) 8%,
          transparent
        )
      );
  }

  .cover-topline {
    position: absolute;

    z-index: 3;

    top: 16px;
    left: 16px;
    right: 16px;

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;
  }

  .post-number,
  .featured-label,
  .cover-category {
    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.22
      );

    background:
      rgba(
        15,
        17,
        32,
        0.54
      );

    color: #ffffff;

    box-shadow:
      0 6px 18px
      rgba(
        0,
        0,
        0,
        0.08
      );

    backdrop-filter:
      blur(9px);

    -webkit-backdrop-filter:
      blur(9px);
  }

  .post-number {
    width: 36px;
    height: 36px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 11px;

    font-size: 9px;
    font-weight: 800;
  }

  .featured-label {
    padding:
      7px 10px;

    border-radius: 999px;

    font-size: 8px;
    font-weight: 800;

    letter-spacing:
      0.12em;
  }

  .cover-category {
    position: absolute;

    z-index: 3;

    left: 16px;
    bottom: 16px;

    padding:
      7px 10px;

    border-radius: 999px;

    font-size: 9px;
    font-weight: 700;
  }

  .cover-spark {
    position: absolute;

    z-index: 3;

    right: 20px;
    bottom: 17px;

    color: #ffffff;

    font-size: 18px;

    text-shadow:
      0 0 18px
      rgba(
        255,
        255,
        255,
        0.72
      );

    transition:
      transform
        var(--transition-normal);
  }

  .post-card:hover
