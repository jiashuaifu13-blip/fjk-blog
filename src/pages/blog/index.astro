---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );
---

<Layout
  title="文章"
  description="所有博客文章"
>
  <section class="blog-page">
    <header class="blog-header">
      <p class="section-label">
        BLOG
      </p>

      <h1>
        文章
      </h1>

      <p>
        技术笔记、项目记录和学习过程。
      </p>
    </header>

    <div class="post-list">
      {
        posts.map((post) => (
          <article class="post-item">
            {
              post.data.cover && (
                <a
                  class="cover-link"
                  href={`/blog/${post.id}/`}
                  aria-label={post.data.title}
                >
                  <Image
                    class="post-cover"
                    src={post.data.cover}
                    alt={
                      post.data.coverAlt ??
                      post.data.title
                    }
                  />
                </a>
              )
            }

            <div class="post-body">
              <div class="post-meta">
                <time
                  datetime={post.data.date.toISOString()}
                >
                  {post.data.date.toLocaleDateString("zh-CN")}
                </time>

                <a
                  class="category-link"
                  href={`/blog/category/${encodeURIComponent(
                    post.data.category
                  )}/`}
                >
                  {post.data.category}
                </a>
              </div>

              <h2>
                <a
                  class="post-title-link"
                  href={`/blog/${post.id}/`}
                >
                  {post.data.title}
                </a>
              </h2>

              <p class="post-description">
                {post.data.description}
              </p>

              {
                post.data.tags.length > 0 && (
                  <div class="tags">
                    {post.data.tags.map((tag) => (
                      <a
                        class="tag"
                        href={`/blog/tag/${encodeURIComponent(
                          tag
                        )}/`}
                      >
                        #{tag}
                      </a>
                    ))}
                  </div>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .blog-page {
    width: min(100%, 900px);
    margin: 0 auto;
    padding: 72px 0;
  }

  .blog-header {
    padding-bottom: 48px;
  }

  .section-label {
    margin: 0 0 14px;

    color: var(--text-secondary);

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 0.14em;
  }

  .blog-header h1 {
    margin: 0;

    font-size: clamp(
      40px,
      6vw,
      56px
    );

    line-height: 1.1;

    letter-spacing: -0.045em;
  }

  .blog-header > p:last-child {
    margin: 16px 0 0;

    color: var(--text-secondary);

    font-size: 17px;
  }

  .post-list {
    border-top: 1px solid var(--border);
  }

  .post-item {
    padding: 32px 0;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr);

    gap: 28px;

    border-bottom:
      1px solid var(--border);
  }

  .post-item:has(.post-cover) {
    grid-template-columns:
      260px minmax(0, 1fr);
  }

  .cover-link {
    display: block;
  }

  .post-cover {
    width: 100%;
    height: 170px;

    object-fit: cover;

    border-radius: 10px;
  }

  .post-body {
    min-width: 0;
  }

  .post-meta {
    display: flex;

    flex-wrap: wrap;

    gap: 16px;

    color: var(--text-secondary);

    font-size: 12px;
  }

  .category-link {
    color: var(--text-secondary);

    transition: color 0.2s ease;
  }

  .category-link:hover {
    color: var(--text-primary);
  }

  .post-item h2 {
    margin: 10px 0;

    font-size: 24px;

    letter-spacing: -0.025em;
  }

  .post-title-link:hover {
    text-decoration: underline;

    text-underline-offset: 4px;
  }

  .post-description {
    max-width: 720px;

    margin: 0;

    color: var(--text-secondary);

    line-height: 1.7;
  }

  .tags {
    margin-top: 16px;

    display: flex;

    flex-wrap: wrap;

    gap: 8px;
  }

  .tag {
    padding: 3px 8px;

    border-radius: 6px;

    background: var(--surface);

    color: var(--text-secondary);

    font-size: 12px;

    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .tag:hover {
    color: var(--text-primary);

    background: var(--border);
  }

  @media (max-width: 700px) {
    .blog-page {
      padding: 52px 0;
    }

    .post-item,
    .post-item:has(.post-cover) {
      grid-template-columns: 1fr;
    }

    .post-cover {
      height: auto;

      aspect-ratio: 16 / 9;
    }

    .post-item h2 {
      font-size: 21px;
    }
  }
</style>