---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("posts"))
    .filter((post) => !post.data.draft);

  const tags = [
    ...new Set(
      posts.flatMap(
        (post) =>
          post.data.tags
      )
    ),
  ];

  return tags.map(
    (tag) => ({
      params: {
        tag,
      },

      props: {
        tag,
      },
    })
  );
}

const {
  tag,
} = Astro.props;

const posts = (await getCollection("posts"))
  .filter(
    (post) =>
      !post.data.draft &&
      post.data.tags.includes(tag)
  )
  .sort(
    (a, b) =>
      b.data.date.getTime() -
      a.data.date.getTime()
  );

const allPosts = (await getCollection("posts"))
  .filter(
    (post) =>
      !post.data.draft
  );

const allTags = [
  ...new Set(
    allPosts.flatMap(
      (post) =>
        post.data.tags
    )
  ),
].sort(
  (a, b) =>
    a.localeCompare(
      b,
      "zh-CN"
    )
);
---

<Layout
  title={`#${tag} - 标签`}
  description={`浏览 FJK Blog 中标签为「${tag}」的文章。`}
>
  <section class="collection-hero">
    <div class="collection-copy">
      <a
        class="back-link"
        href="/blog"
      >
        <span
          aria-hidden="true"
        >
          ←
        </span>

        <span>
          返回文章
        </span>
      </a>

      <div class="collection-badge">
        <span
          class="badge-dot"
          aria-hidden="true"
        ></span>

        <span>
          TOPIC
        </span>
      </div>

      <p class="collection-kicker">
        Explore by topic
      </p>

      <h1>
        <span class="hash">
          #
        </span>
        {tag}
      </h1>

      <p class="collection-description">
        当前标签下共有
        <strong>
          {posts.length}
        </strong>
        篇文章。
      </p>
    </div>

    <div
      class="collection-visual"
      aria-hidden="true"
    >
      <div class="visual-orbit"></div>

      <div class="visual-card">
        <span class="visual-label">
          TOPIC
        </span>

        <strong>
          #
        </strong>

        <span class="visual-name">
          {tag}
        </span>

        <div class="visual-line"></div>

        <span class="visual-footer">
          {String(
            posts.length
          ).padStart(
            2,
            "0"
          )}
          {" "}
          POSTS / FJK BLOG
        </span>
      </div>

      <span class="visual-star">
        ✦
      </span>
    </div>
  </section>

  {
    allTags.length > 1 && (
      <section class="switcher-section">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">
              TOPICS
            </p>

            <h2>
              其他标签
            </h2>
          </div>

          <a
            href="/blog"
            class="section-link"
          >
            全部文章

            <span
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </div>

        <div class="switcher-list">
          {
            allTags.map(
              (item) => (
                <a
                  href={`/blog/tag/${encodeURIComponent(
                    item
                  )}/`}
                  class:list={[
                    "switcher-chip",
                    {
                      active:
                        item === tag,
                    },
                  ]}
                >
                  #{item}
                </a>
              )
            )
          }
        </div>
      </section>
    )
  }

  <section class="posts-section">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">
          POSTS
        </p>

        <h2>
          标签文章
        </h2>

        <p class="section-description">
          按发布时间从新到旧排列。
        </p>
      </div>

      <span class="post-total">
        {posts.length} Posts
      </span>
    </div>

    {
      posts.length > 0 ? (
        <div class="posts-grid">
          {
            posts.map(
              (post, index) => (
                <article class="post-card">
                  <a
                    href={`/blog/${post.id}/`}
                    class="post-card-link"
                  >
                    <div class="post-cover">
                      {
                        post.data.cover ? (
                          <img
                            src={post.data.cover}
                            alt={
                              post.data.coverAlt ??
                              post.data.title
                            }
                            loading={
                              index < 2
                                ? "eager"
                                : "lazy"
                            }
                          />
                        ) : (
                          <div class="cover-placeholder">
                            <span>
                              FJK
                            </span>
                          </div>
                        )
                      }

                      <div class="cover-overlay"></div>

                      <span class="post-number">
                        {String(
                          index + 1
                        ).padStart(
                          2,
                          "0"
                        )}
                      </span>
                    </div>

                    <div class="post-content">
                      <div class="post-meta">
                        <time
                          datetime={
                            post.data.date.toISOString()
                          }
                        >
                          {
                            post.data.date.toLocaleDateString(
                              "zh-CN",
                              {
                                year: "numeric",
                                month: "2-digit",
                                day: "2-digit",
                              }
                            )
                          }
                        </time>

                        <span>
                          ·
                        </span>

                        <span>
                          {post.data.category}
                        </span>
                      </div>

                      <h3>
                        {post.data.title}
                      </h3>

                      <p>
                        {post.data.description}
                      </p>

                      {
                        post.data.tags.length >
                          0 && (
                          <div class="tag-list">
                            {
                              post.data.tags
                                .slice(0, 4)
                                .map(
                                  (item) => (
                                    <span
                                      class:list={[
                                        {
                                          active:
                                            item === tag,
                                        },
                                      ]}
                                    >
                                      #{item}
                                    </span>
                                  )
                                )
                            }
                          </div>
                        )
                      }

                      <div class="post-footer">
                        <span>
                          阅读文章
                        </span>

                        <span
                          class="post-arrow"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      </div>
                    </div>
                  </a>
                </article>
              )
            )
          }
        </div>
      ) : (
        <div class="empty-state">
          <span
            aria-hidden="true"
          >
            ✦
          </span>

          <h2>
            暂无文章
          </h2>

          <p>
            当前标签暂时没有已发布内容。
          </p>

          <a href="/blog">
            返回全部文章
          </a>
        </div>
      )
    }
  </section>
</Layout>

<style>
  .collection-hero {
    min-height:
      500px;

    padding:
      72px 0 68px;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(320px, 0.65fr);

    align-items:
      center;

    gap:
      72px;

    border-bottom:
      1px solid
      var(--border);
  }

  .back-link {
    width:
      fit-content;

    min-height:
      38px;

    padding:
      0 12px;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      12px;

    background:
      var(--color-surface);

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    font-size:
      11px;

    font-weight:
      650;

    transition:
      transform
        var(--transition-fast),
      color
        var(--transition-fast),
      border-color
        var(--transition-fast);
  }

  .back-link:hover {
    transform:
      translateX(-2px);

    color:
      var(--color-primary);

    border-color:
      var(--border-strong);
  }

  .collection-badge {
    width:
      fit-content;

    margin-top:
      42px;

    padding:
      7px 11px;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    font-size:
      9px;

    font-weight:
      800;

    letter-spacing:
      0.14em;
  }

  .badge-dot {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
      var(--color-pink);
  }

  .collection-kicker {
    margin:
      22px 0 0;

    color:
      var(--color-primary);

    font-size:
      14px;

    font-weight:
      700;
  }

  .collection-copy h1 {
    margin:
      9px 0 0;

    font-size:
      clamp(
        52px,
        7vw,
        82px
      );

    line-height:
      1.05;

    letter-spacing:
      -0.055em;

    word-break:
      break-word;
  }

  .hash {
    color:
      var(--color-primary);
  }

  .collection-description {
    margin:
      22px 0 0;

    color:
      var(--text-secondary);

    line-height:
      1.8;
  }

  .collection-description strong {
    margin:
      0 4px;

    color:
      var(--color-primary);
  }

  .collection-visual {
    position:
      relative;

    min-height:
      300px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;
  }

  .visual-orbit {
    position:
      absolute;

    width:
      290px;

    height:
      290px;

    border:
      1px dashed
      color-mix(
        in srgb,
        var(--color-pink)
          28%,
        transparent
      );

    border-radius:
      50%;

    transform:
      rotate(18deg);
  }

  .visual-card {
    position:
      relative;

    z-index:
      2;

    width:
      min(
        100%,
        300px
      );

    min-height:
      250px;

    padding:
      24px;

    display:
      flex;

    flex-direction:
      column;

    border:
      1px solid
      var(--glass-border);

    border-radius:
      28px;

    background:
      var(--glass-background);

    box-shadow:
      var(--shadow-card);

    backdrop-filter:
      blur(
        var(--glass-blur)
      );

    transform:
      rotate(-2deg);
  }

  .visual-label {
    color:
      var(--text-muted);

    font-size:
      9px;

    font-weight:
      800;

    letter-spacing:
      0.13em;
  }

  .visual-card strong {
    margin-top:
      auto;

    color:
      var(--color-pink);

    font-size:
      58px;

    line-height:
      1;
  }

  .visual-name {
    margin-top:
      8px;

    color:
      var(--text-primary);

    font-size:
      18px;

    font-weight:
      750;

    word-break:
      break-word;
  }

  .visual-line {
    height:
      1px;

    margin:
      20px 0 14px;

    background:
      var(--border);
  }

  .visual-footer {
    color:
      var(--text-muted);

    font-size:
      8px;

    letter-spacing:
      0.1em;
  }

  .visual-star {
    position:
      absolute;

    top:
      35px;

    right:
      10px;

    z-index:
      3;

    color:
      var(--color-cyan);

    font-size:
      22px;
  }

  .switcher-section,
  .posts-section {
    padding:
      70px 0;

    border-bottom:
      1px solid
      var(--border);
  }

  .posts-section {
    border-bottom:
      0;
  }

  .section-heading {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap:
      30px;
  }

  .section-eyebrow {
    margin:
      0 0 8px;

    color:
      var(--color-primary);

    font-size:
      9px;

    font-weight:
      800;

    letter-spacing:
      0.15em;
  }

  .section-heading h2 {
    margin:
      0;

    font-size:
      clamp(
        30px,
        4vw,
        40px
      );

    letter-spacing:
      -0.04em;
  }

  .section-description {
    margin:
      10px 0 0;

    color:
      var(--text-secondary);

    font-size:
      13px;
  }

  .section-link {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      7px;

    color:
      var(--text-secondary);

    font-size:
      12px;

    font-weight:
      650;
  }

  .section-link span {
    transition:
      transform
        var(--transition-fast);
  }

  .section-link:hover span {
    transform:
      translateX(3px);
  }

  .switcher-list {
    margin-top:
      28px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      9px;
  }

  .switcher-chip {
    min-height:
      38px;

    padding:
      0 13px;

    display:
      inline-flex;

    align-items:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    font-size:
      11px;

    font-weight:
      600;
  }

  .switcher-chip:hover,
  .switcher-chip.active {
    border-color:
      var(--border-strong);

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);
  }

  .post-total {
    padding:
      7px 10px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    color:
      var(--text-muted);

    font-size:
      10px;

    font-weight:
      700;
  }

  .posts-grid {
    margin-top:
      32px;

    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      20px;
  }

  .post-card {
    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-card);

    transition:
      transform
        var(--transition-normal),
      border-color
        var(--transition-normal),
      box-shadow
        var(--transition-normal);
  }

  .post-card:hover {
    transform:
      translateY(-5px);

    border-color:
      var(--border-strong);

    box-shadow:
      var(--shadow-hover);
  }

  .post-card-link {
    height:
      100%;

    display:
      flex;

    flex-direction:
      column;
  }

  .post-cover {
    position:
      relative;

    aspect-ratio:
      16 / 9;

    overflow:
      hidden;

    background:
      var(--color-primary-soft);
  }

  .post-cover img {
    width:
      100%;

    height:
      100%;

    object-fit:
      cover;

    transition:
      transform
        var(--transition-slow);
  }

  .post-card:hover
  .post-cover img {
    transform:
      scale(1.035);
  }

  .cover-placeholder {
    width:
      100%;

    height:
      100%;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    background:
      linear-gradient(
        135deg,
        var(--color-primary-soft),
        color-mix(
          in srgb,
          var(--color-pink)
            18%,
          transparent
        )
      );
  }

  .cover-placeholder span {
    color:
      var(--color-primary);

    font-size:
      42px;

    font-weight:
      800;
  }

  .cover-overlay {
    position:
      absolute;

    inset:
      0;

    background:
      linear-gradient(
        180deg,
        transparent 55%,
        rgba(
          10,
          12,
          24,
          0.18
        )
      );
  }

  .post-number {
    position:
      absolute;

    right:
      14px;

    bottom:
      14px;

    z-index:
      2;

    width:
      38px;

    height:
      38px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.22
      );

    border-radius:
      12px;

    background:
      rgba(
        14,
        16,
        30,
        0.56
      );

    color:
      #ffffff;

    backdrop-filter:
      blur(10px);

    font-size:
      9px;

    font-weight:
      800;
  }

  .post-content {
    flex:
      1;

    padding:
      25px;

    display:
      flex;

    flex-direction:
      column;
  }

  .post-meta {
    display:
      flex;

    align-items:
      center;

    flex-wrap:
      wrap;

    gap:
      7px;

    color:
      var(--text-muted);

    font-size:
      10px;
  }

  .post-card h3 {
    margin:
      14px 0 9px;

    font-size:
      22px;

    line-height:
      1.4;

    letter-spacing:
      -0.03em;
  }

  .post-content > p {
    margin:
      0;

    color:
      var(--text-secondary);

    font-size:
      13px;

    line-height:
      1.8;
  }

  .tag-list {
    margin-top:
      19px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      6px;
  }

  .tag-list span {
    padding:
      5px 8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    color:
      var(--text-muted);

    font-size:
      9px;

    font-weight:
      600;
  }

  .tag-list span.active {
    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    border-color:
      var(--border-strong);
  }

  .post-footer {
    margin-top:
      auto;

    padding-top:
      22px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    color:
      var(--text-secondary);

    font-size:
      11px;

    font-weight:
      650;
  }

  .post-arrow {
    width:
      32px;

    height:
      32px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      10px;

    color:
      var(--text-muted);
  }

  .post-card:hover
  .post-arrow {
    color:
      var(--color-primary);
  }

  .empty-state {
    margin-top:
      32px;

    padding:
      64px 24px;

    display:
      flex;

    align-items:
      center;

    flex-direction:
      column;

    border:
      1px dashed
      var(--border-strong);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);

    text-align:
      center;
  }

  .empty-state > span {
    color:
      var(--color-primary);

    font-size:
      24px;
  }

  .empty-state h2 {
    margin:
      14px 0 0;
  }

  .empty-state p {
    margin:
      8px 0 0;

    color:
      var(--text-secondary);
  }

  .empty-state a {
    margin-top:
      22px;

    color:
      var(--color-primary);

    font-size:
      12px;

    font-weight:
      650;
  }

  @media (
    max-width: 850px
  ) {
    .collection-hero {
      grid-template-columns:
        1fr;

      gap:
        38px;
    }

    .collection-visual {
      min-height:
        280px;
    }
  }

  @media (
    max-width: 700px
  ) {
    .collection-hero {
      min-height:
        auto;

      padding:
        48px 0 54px;
    }

    .collection-badge {
      margin-top:
        34px;
    }

    .collection-copy h1 {
      font-size:
        clamp(
          44px,
          14vw,
          64px
        );
    }

    .collection-visual {
      display:
        none;
    }

    .switcher-section,
    .posts-section {
      padding:
        56px 0;
    }

    .section-heading {
      align-items:
        flex-start;

      flex-direction:
        column;

      gap:
        15px;
    }

    .posts-grid {
      grid-template-columns:
        1fr;
    }
  }
</style>