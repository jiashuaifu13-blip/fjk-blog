---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts =
    (await getCollection("posts"))
      .filter(
        (post) =>
          !post.data.draft
      );

  const tags = [
    ...new Set(
      posts.flatMap(
        (post) =>
          post.data.tags
      )
    ),
  ];

  return tags.map(
    (tag) => ({
      params: {
        tag,
      },
      props: {
        tag,
      },
    })
  );
}

const {
  tag,
} = Astro.props;

const posts =
  (await getCollection("posts"))
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.tags.includes(
          tag
        )
    )
    .sort(
      (a, b) =>
        b.data.date.getTime() -
        a.data.date.getTime()
    );

const allPosts =
  (await getCollection("posts"))
    .filter(
      (post) =>
        !post.data.draft
    );

const allTags = [
  ...new Set(
    allPosts.flatMap(
      (post) =>
        post.data.tags
    )
  ),
];
---

<Layout
  title={`#${tag} - 标签`}
  description={`浏览标签「${tag}」下的文章。`}
>
  <section class="collection-hero">
    <div class="collection-copy">
      <a
        class="back-link"
        href="/blog"
      >
        ← 返回文章
      </a>

      <div class="collection-badge">
        <span></span>
        TOPIC
      </div>

      <p class="collection-kicker">
        Explore by topic
      </p>

      <h1>
        <span class="hash">
          #
        </span>
        {tag}
      </h1>

      <p class="collection-description">
        当前标签下共有
        <strong>
          {posts.length}
        </strong>
        篇文章。
      </p>
    </div>

    <div class="collection-visual">
      <div class="visual-card">
        <span>
          TOPIC
        </span>

        <strong>
          #
        </strong>

        <h2>
          {tag}
        </h2>

        <div></div>

        <small>
          {posts.length} POSTS / FJK BLOG
        </small>
      </div>
    </div>
  </section>

  {
    allTags.length >
      1 && (
      <section class="switcher-section">
        <div class="section-heading">
          <div>
            <p>
              TOPICS
            </p>

            <h2>
              其他标签
            </h2>
          </div>
        </div>

        <div class="switcher-list">
          {
            allTags.map(
              (item) => (
                <a
                  href={`/blog/tag/${encodeURIComponent(
                    item
                  )}/`}
                  class:list={[
                    "switcher-chip",
                    {
                      active:
                        item === tag,
                    },
                  ]}
                >
                  #{item}
                </a>
              )
            )
          }
        </div>
      </section>
    )
  }

  <section class="posts-section">
    <div class="section-heading">
      <div>
        <p>
          POSTS
        </p>

        <h2>
          标签文章
        </h2>
      </div>

      <span>
        {posts.length} Posts
      </span>
    </div>

    <div class="posts-grid">
      {
        posts.map(
          (post) => (
            <article class="post-card">
              <a
                href={`/blog/${post.id}/`}
              >
                {
                  post.data.cover && (
                    <div class="post-cover">
                      <img
                        src={post.data.cover}
                        alt={
                          post.data.coverAlt ??
                          post.data.title
                        }
                      />
                    </div>
                  )
                }

                <div class="post-content">
                  <div class="post-meta">
                    {
                      post.data.date.toLocaleDateString(
                        "zh-CN"
                      )
                    }
                  </div>

                  <h3>
                    {post.data.title}
                  </h3>

                  <p>
                    {post.data.description}
                  </p>

                  <div class="tag-list">
                    {
                      post.data.tags.map(
                        (item) => (
                          <span
                            class:list={[
                              {
                                active:
                                  item === tag,
                              },
                            ]}
                          >
                            #{item}
                          </span>
                        )
                      )
                    }
                  </div>
                </div>
              </a>
            </article>
          )
        )
      }
    </div>
  </section>
</Layout>

<style>
  .collection-hero {
    min-height:
      500px;

    padding:
      72px 0 68px;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(320px, 0.65fr);

    align-items:
      center;

    gap:
      72px;

    border-bottom:
      1px solid
      var(--border);
  }

  .collection-hero > * {
    min-width:
      0;
  }

  .back-link {
    min-height:
      38px;

    padding:
      0 12px;

    display:
      inline-flex;

    align-items:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      12px;

    background:
      var(--color-surface);
  }

  .collection-badge {
    width:
      fit-content;

    margin-top:
      42px;

    padding:
      7px 11px;

    display:
      flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    font-size:
      9px;
  }

  .collection-badge span {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
      var(--color-pink);
  }

  .collection-kicker {
    margin-top:
      22px;

    color:
      var(--color-primary);

    font-weight:
      700;
  }

  .collection-copy h1 {
    margin:
      9px 0 0;

    font-size:
      clamp(
        52px,
        7vw,
        82px
      );

    line-height:
      1.05;

    word-break:
      normal;
  }

  .hash {
    color:
      var(--color-primary);
  }

  .collection-description {
    color:
      var(--text-secondary);
  }

  .collection-description strong {
    color:
      var(--color-primary);
  }

  .collection-visual {
    min-width:
      0;

    display:
      flex;

    justify-content:
      center;
  }

  .visual-card {
    width:
      min(
        100%,
        300px
      );

    min-height:
      250px;

    padding:
      24px;

    display:
      flex;

    flex-direction:
      column;

    border:
      1px solid
      var(--border);

    border-radius:
      28px;

    background:
      var(--glass-background);

    box-shadow:
      var(--shadow-card);
  }

  .visual-card > span,
  .visual-card small {
    color:
      var(--text-muted);

    font-size:
      9px;
  }

  .visual-card strong {
    margin-top:
      auto;

    color:
      var(--color-pink);

    font-size:
      58px;
  }

  .visual-card h2 {
    margin:
      8px 0;

    overflow-wrap:
      anywhere;
  }

  .visual-card div {
    height:
      1px;

    margin:
      15px 0;

    background:
      var(--border);
  }

  .switcher-section,
  .posts-section {
    padding:
      70px 0;
  }

  .section-heading {
    display:
      flex;

    justify-content:
      space-between;

    align-items:
      flex-end;

    gap:
      20px;
  }

  .section-heading p {
    margin:
      0 0 8px;

    color:
      var(--color-primary);

    font-size:
      9px;
  }

  .section-heading h2 {
    margin:
      0;

    font-size:
      36px;
  }

  .switcher-list {
    margin-top:
      28px;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      9px;
  }

  .switcher-chip {
    max-width:
      100%;

    min-height:
      38px;

    padding:
      0 13px;

    display:
      inline-flex;

    align-items:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    overflow-wrap:
      anywhere;
  }

  .switcher-chip.active {
    color:
      var(--color-primary);

    background:
      var(--color-primary-soft);
  }

  .posts-grid {
    min-width:
      0;

    margin-top:
      32px;

    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      20px;
  }

  .post-card {
    min-width:
      0;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);
  }

  .post-cover {
    aspect-ratio:
      16 / 9;

    overflow:
      hidden;
  }

  .post-cover img {
    width:
      100%;

    height:
      100%;

    object-fit:
      cover;
  }

  .post-content {
    min-width:
      0;

    padding:
      25px;
  }

  .post-meta {
    color:
      var(--text-muted);

    font-size:
      10px;
  }

  .post-content h3 {
    margin:
      14px 0 9px;

    font-size:
      22px;

    word-break:
      normal;
  }

  .post-content p {
    color:
      var(--text-secondary);
  }

  .tag-list {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      6px;
  }

  .tag-list span {
    max-width:
      100%;

    padding:
      5px 8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    color:
      var(--text-muted);

    font-size:
      9px;

    overflow-wrap:
      anywhere;
  }

  .tag-list span.active {
    color:
      var(--color-primary);

    background:
      var(--color-primary-soft);
  }

  :global(html.mobile-device)
  .collection-hero {
    min-height:
      auto;

    padding:
      48px 0 54px;

    grid-template-columns:
      minmax(0, 1fr);

    gap:
      30px;
  }

  :global(html.mobile-device)
  .collection-copy h1 {
    font-size:
      clamp(
        44px,
        13vw,
        64px
      );
  }

  :global(html.mobile-device)
  .collection-visual {
    display:
      none;
  }

  :global(html.mobile-device)
  .switcher-section,
  :global(html.mobile-device)
  .posts-section {
    padding:
      56px 0;
  }

  :global(html.mobile-device)
  .section-heading {
    align-items:
      flex-start;

    flex-direction:
      column;

    gap:
      15px;
  }

  :global(html.mobile-device)
  .posts-grid {
    grid-template-columns:
      minmax(0, 1fr);
  }

  @media (
    max-width: 700px
  ) {
    .collection-hero {
      min-height:
        auto;

      grid-template-columns:
        1fr;
    }

    .collection-visual {
      display:
        none;
    }

    .section-heading {
      flex-direction:
        column;

      align-items:
        flex-start;
    }

    .posts-grid {
      grid-template-columns:
        1fr;
    }
  }
</style>