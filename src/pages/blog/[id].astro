---
import Layout from "../../layouts/Layout.astro";

import {
  getCollection,
  render,
} from "astro:content";

export async function getStaticPaths() {
  const posts = (
    await getCollection("posts")
  ).filter(
    (post) =>
      !post.data.draft
  );

  return posts.map(
    (post) => ({
      params: {
        id: post.id,
      },

      props: {
        post,
      },
    })
  );
}

const { post } = Astro.props;

const {
  Content,
  headings,
} = await render(post);

const publishedDate =
  post.data.date.toLocaleDateString(
    "zh-CN",
    {
      year: "numeric",
      month: "long",
      day: "numeric",
    }
  );

const cover =
  post.data.cover ??
  "/images/anime/covers/soft-pink.webp";

const hasToc =
  headings.filter(
    (heading) =>
      heading.depth === 2 ||
      heading.depth === 3
  ).length > 1;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={cover}
  imageAlt={
    post.data.coverAlt ??
    post.data.title
  }
  type="article"
  publishedTime={post.data.date}
>
  <article class="article-page">
    <section class="article-hero">
      <div class="article-cover">
        <img
          src={cover}
          alt={
            post.data.coverAlt ??
            post.data.title
          }
          fetchpriority="high"
        />

        <div class="cover-darken"></div>
        <div class="cover-gradient"></div>
        <div class="cover-tint"></div>

        <div
          class="cover-holo"
          aria-hidden="true"
        ></div>

        <span
          class="cover-star cover-star-one"
          aria-hidden="true"
        >
          ✦
        </span>

        <span
          class="cover-star cover-star-two"
          aria-hidden="true"
        >
          ✧
        </span>
      </div>

      <div class="article-hero-inner">
        <a
          class="back-link"
          href="/blog"
        >
          <span aria-hidden="true">
            ←
          </span>

          返回文章
        </a>

        <div class="article-title-card">
          <div
            class="title-card-holo"
            aria-hidden="true"
          ></div>

          <div class="article-category">
            <span
              class="category-dot"
              aria-hidden="true"
            ></span>

            {post.data.category}
          </div>

          <h1>
            {post.data.title}
          </h1>

          <p class="article-description">
            {post.data.description}
          </p>

          <div class="article-meta">
            <time
              datetime={
                post.data.date.toISOString()
              }
            >
              {publishedDate}
            </time>

            <span
              class="meta-separator"
              aria-hidden="true"
            >
              /
            </span>

            <span>
              FJK
            </span>

            <span
              class="meta-separator"
              aria-hidden="true"
            >
              /
            </span>

            <span>
              ARTICLE
            </span>
          </div>

          {
            post.data.tags.length > 0 && (
              <div class="article-tags">
                {
                  post.data.tags.map(
                    (tag) => (
                      <a
                        href={`/blog/tag/${encodeURIComponent(
                          tag
                        )}/`}
                      >
                        #{tag}
                      </a>
                    )
                  )
                }
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section class="reading-section">
      <div class="reading-layout">
        {
          hasToc && (
            <aside class="article-sidebar">
              <div class="toc-card">
                <div class="toc-header">
                  <span>
                    CONTENTS
                  </span>

                  <span
                    aria-hidden="true"
                  >
                    ✦
                  </span>
                </div>

                <nav
                  class="toc"
                  aria-label="文章目录"
                >
                  {
                    headings
                      .filter(
                        (heading) =>
                          heading.depth ===
                            2 ||
                          heading.depth ===
                            3
                      )
                      .map(
                        (heading) => (
                          <a
                            class:list={[
                              "toc-link",
                              {
                                "toc-link-sub":
                                  heading.depth ===
                                  3,
                              },
                            ]}
                            href={`#${heading.slug}`}
                          >
                            {heading.text}
                          </a>
                        )
                      )
                  }
                </nav>
              </div>
            </aside>
          )
        }

        <main
          class:list={[
            "article-main",
            {
              "article-main-wide":
                !hasToc,
            },
          ]}
        >
          <div
            class="reading-decoration"
            aria-hidden="true"
          >
            <span>
              ✦
            </span>

            <i></i>

            <small>
              FJK BLOG
            </small>
          </div>

          <div class="article-body">
            <Content />
          </div>

          <footer class="article-footer">
            <div class="article-end-mark">
              <span>
                ✦
              </span>

              <span>
                END OF ARTICLE
              </span>

              <span>
                ✦
              </span>
            </div>

            <div class="article-footer-card">
              <div>
                <p class="footer-eyebrow">
                  KEEP READING
                </p>

                <h2>
                  继续看看其他文章
                </h2>

                <p>
                  技术、项目、学习和生活，
                  都会继续记录在这里。
                </p>
              </div>

              <a href="/blog">
                返回文章列表

                <span aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          </footer>
        </main>
      </div>
    </section>
  </article>
</Layout>

<style>
  .article-page {
    min-width: 0;
  }

  /* =========================
     Hero
     ========================= */

  .article-hero {
    position: relative;

    min-height: 640px;

    margin:
      0 calc(
        50% - 50vw
      );

    display: flex;
    align-items: flex-end;

    overflow: hidden;

    border-bottom:
      1px solid
      var(--border);

    isolation: isolate;
  }

  .article-cover {
    position: absolute;

    z-index: -4;

    inset: 0;

    overflow: hidden;

    background:
      var(--color-primary-soft);

    pointer-events: none;
  }

  .article-cover img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
    object-position: center;

    transform:
      scale(1.02);

    filter:
      saturate(0.96)
      contrast(1.01);

    transition:
      transform
        1.2s ease;
  }

  .cover-darken,
  .cover-gradient,
  .cover-tint,
  .cover-holo {
    position: absolute;

    inset: 0;

    pointer-events: none;
  }

  .cover-darken {
    z-index: 1;

    background:
      rgba(
        12,
        14,
        28,
        0.1
      );
  }

  .cover-gradient {
    z-index: 2;

    background:
      linear-gradient(
        180deg,
        rgba(
          9,
          11,
          24,
          0.06
        ) 0%,
        rgba(
          9,
          11,
          24,
          0.12
        ) 34%,
        rgba(
          9,
          11,
          24,
          0.54
        ) 74%,
        color-mix(
          in srgb,
          var(--background) 96%,
          transparent
        ) 100%
      );
  }

  .cover-tint {
    z-index: 3;

    background:
      linear-gradient(
        110deg,
        color-mix(
          in srgb,
          var(--color-primary) 11%,
          transparent
        ),
        transparent 47%,
        color-mix(
          in srgb,
          var(--color-pink) 9%,
          transparent
        )
      );
  }

  .cover-holo {
    z-index: 4;

    background-image:
      url(
        "/images/anime/effects/holo.webp"
      );

    background-position: center;
    background-size: cover;

    mix-blend-mode:
      soft-light;

    opacity: 0.055;
  }

  :global(html.dark)
  .article-cover img {
    filter:
      brightness(0.68)
      saturate(0.86)
      contrast(1.04);
  }

  :global(html.dark)
  .cover-darken {
    background:
      rgba(
        7,
        9,
        20,
        0.24
      );
  }

  .article-hero-inner {
    position: relative;

    z-index: 5;

    width:
      min(
        calc(
          100% - 48px
        ),
        1180px
      );

    margin:
      0 auto;

    padding:
      96px 0 54px;
  }

  .back-link {
    width: fit-content;

    min-height: 38px;

    padding:
      0 13px;

    display: inline-flex;

    align-items: center;

    gap: 8px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.2
      );

    border-radius: 999px;

    background:
      rgba(
        16,
        18,
        34,
        0.42
      );

    color:
      rgba(
        255,
        255,
        255,
        0.88
      );

    box-shadow:
      0 8px 26px
      rgba(
        0,
        0,
        0,
        0.1
      );

    backdrop-filter:
      blur(12px);

    -webkit-backdrop-filter:
      blur(12px);

    font-size: 11px;
    font-weight: 650;

    transition:
      transform
        var(--transition-fast),
      background-color
        var(--transition-fast);
  }

  .back-link:hover {
    color: #ffffff;

    transform:
      translateX(-2px);

    background:
      rgba(
        16,
        18,
        34,
        0.58
      );
  }

  .article-title-card {
    position: relative;

    max-width: 850px;

    margin-top: 18px;

    padding: 34px;

    overflow: hidden;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.2
      );

    border-radius: 26px;

    background:
      rgba(
        18,
        20,
        38,
        0.53
      );

    color: #ffffff;

    box-shadow:
      0 26px 80px
      rgba(
        0,
        0,
        0,
        0.16
      );

    backdrop-filter:
      blur(18px);

    -webkit-backdrop-filter:
      blur(18px);

    isolation: isolate;
  }

  .title-card-holo {
    position: absolute;

    z-index: -1;

    inset: 0;

    background-image:
      url(
        "/images/anime/effects/holo.webp"
      );

    background-position: center;
    background-size: cover;

    mix-blend-mode:
      soft-light;

    opacity: 0.08;

    pointer-events: none;
  }

  .article-category {
    width: fit-content;

    padding:
      7px 10px;

    display: inline-flex;

    align-items: center;

    gap: 8px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.16
      );

    border-radius: 999px;

    background:
      rgba(
        255,
        255,
        255,
        0.07
      );

    color:
      rgba(
        255,
        255,
        255,
        0.84
      );

    font-size: 10px;
    font-weight: 700;
  }

  .category-dot {
    width: 6px;
    height: 6px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 0 4px
      rgba(
        125,
        227,
        255,
        0.13
      );
  }

  .article-title-card h1 {
    max-width: 780px;

    margin:
      17px 0 0;

    color: #ffffff;

    font-size:
      clamp(
        38px,
        6vw,
        66px
      );

    line-height: 1.12;

    letter-spacing:
      -0.055em;

    word-break: normal;
  }

  .article-description {
    max-width: 680px;

    margin:
      18px 0 0;

    color:
      rgba(
        255,
        255,
        255,
        0.76
      );

    font-size: 15px;
    line-height: 1.82;
  }

  .article-meta {
    margin-top: 24px;

    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 9px;

    color:
      rgba(
        255,
        255,
        255,
        0.56
      );

    font-size: 10px;
    font-weight: 650;

    letter-spacing:
      0.03em;
  }

  .meta-separator {
    opacity: 0.38;
  }

  .article-tags {
    margin-top: 20px;

    display: flex;
    flex-wrap: wrap;

    gap: 7px;
  }

  .article-tags a {
    max-width: 100%;

    padding:
      6px 9px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.14
      );

    border-radius: 999px;

    background:
      rgba(
        255,
        255,
        255,
        0.06
      );

    color:
      rgba(
        255,
        255,
        255,
        0.78
      );

    font-size: 9px;

    overflow-wrap: anywhere;

    transition:
      background-color
        var(--transition-fast),
      transform
        var(--transition-fast);
  }

  .article-tags a:hover {
    color: #ffffff;

    background:
      rgba(
        255,
        255,
        255,
        0.12
      );

    transform:
      translateY(-1px);
  }

  .cover-star {
    position: absolute;

    z-index: 5;

    color:
      rgba(
        255,
        255,
        255,
        0.74
      );

    text-shadow:
      0 0 18px
      rgba(
        255,
        255,
        255,
        0.52
      );

    pointer-events: none;
  }

  .cover-star-one {
    top: 26%;
    right: 9%;

    font-size: 27px;
  }

  .cover-star-two {
    top: 18%;
    right: 23%;

    font-size: 16px;
  }

  /* =========================
     Reading layout
     ========================= */

  .reading-section {
    min-width: 0;

    padding:
      72px 0 96px;
  }

  .reading-layout {
    min-width: 0;

    display: grid;

    grid-template-columns:
      210px
      minmax(0, 760px);

    justify-content: center;

    align-items: start;

    gap: 52px;
  }

  .article-sidebar {
    min-width: 0;
  }

  .toc-card {
    position: sticky;

    top: 92px;

    padding: 16px;

    border:
      1px solid
      var(--border);

    border-radius: 18px;

    background:
      color-mix(
        in srgb,
        var(--color-surface) 88%,
        transparent
      );

    box-shadow:
      var(--shadow-sm);

    backdrop-filter:
      blur(12px);

    -webkit-backdrop-filter:
      blur(12px);
  }

  .toc-header {
    padding-bottom: 12px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom:
      1px solid
      var(--border);

    color:
      var(--text-muted);

    font-size: 8px;
    font-weight: 800;

    letter-spacing:
      0.14em;
  }

  .toc-header span:last-child {
    color:
      var(--color-primary);

    font-size: 12px;
  }

  .toc {
    margin-top: 11px;

    display: flex;
    flex-direction: column;

    gap: 3px;
  }

  .toc-link {
    padding:
      7px 8px;

    border-radius: 9px;

    color:
      var(--text-secondary);

    font-size: 11px;
    line-height: 1.45;

    transition:
      color
        var(--transition-fast),
      background-color
        var(--transition-fast);
  }

  .toc-link:hover {
    color:
      var(--color-primary);

    background:
      var(--color-primary-soft);
  }

  .toc-link-sub {
    padding-left: 18px;

    color:
      var(--text-muted);

    font-size: 10px;
  }

  .article-main {
    min-width: 0;
    width: 100%;
  }

  .article-main-wide {
    grid-column:
      1 / -1;

    width:
      min(
        100%,
        760px
      );

    justify-self: center;
  }

  .reading-decoration {
    margin-bottom: 22px;

    display: flex;
    align-items: center;

    gap: 10px;

    color:
      var(--text-muted);

    font-size: 8px;
    font-weight: 700;

    letter-spacing:
      0.13em;
  }

  .reading-decoration span {
    color:
      var(--color-primary);

    font-size: 12px;
  }

  .reading-decoration i {
    width: 38px;
    height: 1px;

    display: block;

    background:
      linear-gradient(
        90deg,
        var(--color-primary),
        transparent
      );
  }

  /* =========================
     Article body
     ========================= */

  .article-body {
    min-width: 0;

    font-size: 16px;
    line-height: 1.95;

    color:
      var(--text-primary);

    overflow-wrap: anywhere;
  }

  .article-body :global(
    > *:first-child
  ) {
    margin-top: 0;
  }

  .article-body :global(h1),
  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4) {
    color:
      var(--text-primary);

    line-height: 1.35;

    scroll-margin-top: 100px;
  }

  .article-body :global(h1) {
    margin:
      0 0 28px;

    font-size: 34px;

    letter-spacing:
      -0.04em;
  }

  .article-body :global(h2) {
    position: relative;

    margin:
      58px 0 20px;

    padding-left: 18px;

    font-size: 27px;

    letter-spacing:
      -0.035em;
  }

  .article-body :global(h2)::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0.25em;

    width: 5px;
    height: 0.92em;

    border-radius: 999px;

    background:
      linear-gradient(
        180deg,
        var(--color-primary),
        var(--color-pink)
      );

    box-shadow:
      0 0 16px
      color-mix(
        in srgb,
        var(--color-primary) 20%,
        transparent
      );
  }

  .article-body :global(h3) {
    margin:
      38px 0 16px;

    font-size: 21px;

    letter-spacing:
      -0.025em;
  }

  .article-body :global(h4) {
    margin:
      30px 0 14px;

    font-size: 17px;
  }

  .article-body :global(p) {
    margin:
      0 0 22px;

    color:
      color-mix(
        in srgb,
        var(--text-primary) 88%,
        var(--text-secondary)
      );
  }

  .article-body :global(a) {
    color:
      var(--color-primary);

    text-decoration:
      underline;

    text-decoration-color:
      color-mix(
        in srgb,
        var(--color-primary) 28%,
        transparent
      );

    text-underline-offset:
      4px;

    text-decoration-thickness:
      1px;
  }

  .article-body :global(a:hover) {
    color:
      var(--color-secondary);

    text-decoration-color:
      currentColor;
  }

  .article-body :global(strong) {
    color:
      var(--text-primary);

    font-weight: 700;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin:
      0 0 24px;

    padding-left: 1.45em;
  }

  .article-body :global(li) {
    margin:
      8px 0;

    padding-left: 4px;
  }

  .article-body :global(li::marker) {
    color:
      var(--color-primary);
  }

  .article-body :global(blockquote) {
    position: relative;

    margin:
      30px 0;

    padding:
      20px 22px 20px 24px;

    overflow: hidden;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-primary) 18%,
        var(--border)
      );

    border-left:
      4px solid
      var(--color-primary);

    border-radius:
      0 16px 16px 0;

    background:
      linear-gradient(
        135deg,
        var(--color-primary-soft),
        color-mix(
          in srgb,
          var(--color-pink) 4%,
          var(--color-surface)
        )
      );

    color:
      var(--text-secondary);
  }

  .article-body :global(
    blockquote::after
  ) {
    content: "✦";

    position: absolute;

    right: 16px;
    top: 11px;

    color:
      color-mix(
        in srgb,
        var(--color-primary) 18%,
        transparent
      );

    font-size: 24px;
  }

  .article-body :global(
    blockquote p:last-child
  ) {
    margin-bottom: 0;
  }

  .article-body :global(hr) {
    height: 1px;

    margin:
      48px 0;

    border: 0;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--border-strong),
        transparent
      );
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;

    display: block;

    margin:
      30px auto;

    border:
      1px solid
      var(--border);

    border-radius: 18px;

    box-shadow:
      var(--shadow-card);
  }

  .article-body :global(pre) {
    max-width: 100%;

    margin:
      28px 0;

    padding: 22px;

    overflow-x: auto;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.07
      );

    border-radius: 16px;

    background:
      #10131f !important;

    color:
      #e9ecff;

    box-shadow:
      0 18px 44px
      rgba(
        10,
        12,
        24,
        0.14
      );

    font-size: 13px;
    line-height: 1.75;

    tab-size: 2;

    -webkit-overflow-scrolling:
      touch;
  }

  .article-body :global(
    :not(pre) > code
  ) {
    padding:
      3px 6px;

    border:
      1px solid
      var(--border);

    border-radius: 6px;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size: 0.9em;
  }

  .article-body :global(
    pre code
  ) {
    padding: 0;

    border: 0;

    background: transparent;

    color: inherit;

    font-size: inherit;
  }

  .article-body :global(table) {
    width: 100%;

    margin:
      28px 0;

    border-collapse:
      separate;

    border-spacing: 0;

    overflow: hidden;

    border:
      1px solid
      var(--border);

    border-radius: 14px;

    background:
      var(--color-surface);

    font-size: 13px;
  }

  .article-body :global(th),
