---
import Layout from "../../layouts/Layout.astro";

import {
  getCollection,
  render,
} from "astro:content";

export async function getStaticPaths() {
  const posts =
    (await getCollection("posts"))
      .filter(
        (post) =>
          !post.data.draft
      );

  return posts.map(
    (post) => ({
      params: {
        id: post.id,
      },

      props: {
        post,
      },
    })
  );
}

const {
  post,
} = Astro.props;

const allPosts =
  (await getCollection("posts"))
    .filter(
      (item) =>
        !item.data.draft
    )
    .sort(
      (a, b) =>
        b.data.date.getTime() -
        a.data.date.getTime()
    );

const currentIndex =
  allPosts.findIndex(
    (item) =>
      item.id === post.id
  );

const olderPost =
  currentIndex <
  allPosts.length - 1
    ? allPosts[currentIndex + 1]
    : undefined;

const newerPost =
  currentIndex > 0
    ? allPosts[currentIndex - 1]
    : undefined;

const {
  Content,
} = await render(post);

const publishedDate =
  post.data.date.toLocaleDateString(
    "zh-CN",
    {
      year: "numeric",
      month: "long",
      day: "numeric",
    }
  );
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  imageAlt={
    post.data.coverAlt ??
    post.data.title
  }
  type="article"
  publishedTime={post.data.date}
>
  <article class="article">
    <header class="article-header">
      <div class="article-topbar">
        <a
          class="back-link"
          href="/blog"
        >
          ← 返回文章
        </a>

        <span class="article-type">
          ARTICLE / FJK BLOG
        </span>
      </div>

      <div class="article-heading">
        <div class="article-eyebrow">
          <span
            class="eyebrow-dot"
          ></span>

          STORIES & NOTES
        </div>

        <h1>
          {post.data.title}
        </h1>

        <p class="article-description">
          {post.data.description}
        </p>

        <div class="article-meta">
          <div class="meta-item">
            <span class="meta-label">
              PUBLISHED
            </span>

            <time
              datetime={
                post.data.date.toISOString()
              }
            >
              {publishedDate}
            </time>
          </div>

          <div class="meta-divider"></div>

          <div class="meta-item">
            <span class="meta-label">
              CATEGORY
            </span>

            <a
              href={`/blog/category/${encodeURIComponent(
                post.data.category
              )}/`}
            >
              {post.data.category}
            </a>
          </div>

          {
            post.data.tags.length >
              0 && (
              <>
                <div class="meta-divider"></div>

                <div class="meta-item">
                  <span class="meta-label">
                    TAGS
                  </span>

                  <span>
                    {
                      post.data.tags.length
                    }
                    {" "}
                    Topics
                  </span>
                </div>
              </>
            )
          }
        </div>

        {
          post.data.tags.length >
            0 && (
            <div class="article-tags">
              {
                post.data.tags.map(
                  (tag) => (
                    <a
                      href={`/blog/tag/${encodeURIComponent(
                        tag
                      )}/`}
                    >
                      #{tag}
                    </a>
                  )
                )
              }
            </div>
          )
        }
      </div>

      {
        post.data.cover && (
          <figure class="article-cover">
            <img
              src={post.data.cover}
              alt={
                post.data.coverAlt ??
                post.data.title
              }
            />

            <figcaption>
              <span>
                FJK BLOG
              </span>

              <span>
                {
                  post.data.coverAlt ??
                  post.data.title
                }
              </span>
            </figcaption>
          </figure>
        )
      }
    </header>

    <div class="reading-layout">
      <aside class="article-sidebar">
        <div class="sidebar-card">
          <span class="sidebar-label">
            ARTICLE
          </span>

          <strong>
            {String(
              currentIndex + 1
            ).padStart(
              2,
              "0"
            )}
          </strong>

          <span>
            / {String(
              allPosts.length
            ).padStart(
              2,
              "0"
            )}
          </span>

          <div class="sidebar-line"></div>

          <span class="sidebar-text">
            Keep learning.
            <br />
            Keep building.
          </span>
        </div>
      </aside>

      <main class="article-body">
        <div class="article-content">
          <Content />
        </div>

        <div class="article-end">
          <div>
            ✦
          </div>

          <p>
            Thanks for reading.
          </p>

          <span>
            感谢阅读
          </span>
        </div>
      </main>
    </div>

    <footer class="article-footer">
      <div class="article-footer-heading">
        <div>
          <p>
            CONTINUE READING
          </p>

          <h2>
            继续阅读
          </h2>
        </div>

        <a href="/blog">
          全部文章 →
        </a>
      </div>

      <nav class="article-navigation">
        {
          olderPost ? (
            <a
              class="navigation-card"
              href={`/blog/${olderPost.id}/`}
            >
              <span>
                ← 较早文章
              </span>

              <strong>
                {olderPost.data.title}
              </strong>

              <p>
                {
                  olderPost.data.description
                }
              </p>
            </a>
          ) : (
            <div class="navigation-card disabled">
              <span>
                ← 较早文章
              </span>

              <strong>
                已经是最早的文章
              </strong>
            </div>
          )
        }

        {
          newerPost ? (
            <a
              class="navigation-card"
              href={`/blog/${newerPost.id}/`}
            >
              <span>
                较新文章 →
              </span>

              <strong>
                {newerPost.data.title}
              </strong>

              <p>
                {
                  newerPost.data.description
                }
              </p>
            </a>
          ) : (
            <div class="navigation-card disabled">
              <span>
                较新文章 →
              </span>

              <strong>
                已经是最新的文章
              </strong>
            </div>
          )
        }
      </nav>
    </footer>
  </article>
</Layout>

<style>
  .article {
    min-width:
      0;

    padding:
      66px 0 40px;
  }

  .article-header {
    min-width:
      0;

    padding-bottom:
      70px;

    border-bottom:
      1px solid
      var(--border);
  }

  .article-topbar {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      24px;
  }

  .back-link {
    min-height:
      38px;

    padding:
      0 12px;

    display:
      inline-flex;

    align-items:
      center;

    border:
      1px solid
      var(--border);

    border-radius:
      12px;

    background:
      var(--color-surface);

    color:
      var(--text-secondary);
  }

  .article-type {
    color:
      var(--text-muted);

    font-size:
      9px;

    letter-spacing:
      0.13em;
  }

  .article-heading {
    width:
      min(
        100%,
        880px
      );

    min-width:
      0;

    margin:
      64px auto 0;

    text-align:
      center;
  }

  .article-eyebrow {
    width:
      fit-content;

    margin:
      0 auto;

    padding:
      7px 11px;

    display:
      flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    font-size:
      9px;

    letter-spacing:
      0.14em;
  }

  .eyebrow-dot {
    width:
      6px;

    height:
      6px;

    flex-shrink:
      0;

    border-radius:
      50%;

    background:
      var(--color-cyan);
  }

  .article-heading h1 {
    margin:
      24px auto 0;

    font-size:
      clamp(
        44px,
        6.5vw,
        72px
      );

    line-height:
      1.12;

    letter-spacing:
      -0.055em;

    word-break:
      normal;
  }

  .article-description {
    width:
      min(
        100%,
        680px
      );

    margin:
      22px auto 0;

    color:
      var(--text-secondary);

    font-size:
      16px;

    line-height:
      1.85;
  }

  .article-meta {
    margin-top:
      34px;

    display:
      flex;

    align-items:
      stretch;

    justify-content:
      center;

    flex-wrap:
      wrap;

    gap:
      18px;
  }

  .meta-item {
    min-width:
      0;

    display:
      flex;

    align-items:
      center;

    flex-direction:
      column;

    gap:
      5px;
  }

  .meta-label {
    color:
      var(--text-muted);

    font-size:
      8px;
  }

  .meta-divider {
    width:
      1px;

    min-height:
      34px;

    background:
      var(--border);
  }

  .article-tags {
    margin-top:
      24px;

    display:
      flex;

    justify-content:
      center;

    flex-wrap:
      wrap;

    gap:
      7px;
  }

  .article-tags a {
    max-width:
      100%;

    padding:
      6px 9px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size:
      10px;

    overflow-wrap:
      anywhere;
  }

  .article-cover {
    margin:
      54px 0 0;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-card);
  }

  .article-cover img {
    width:
      100%;

    max-height:
      620px;

    aspect-ratio:
      16 / 9;

    object-fit:
      cover;
  }

  .article-cover figcaption {
    min-height:
      42px;

    padding:
      0 16px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      20px;

    border-top:
      1px solid
      var(--border);

    color:
      var(--text-muted);

    font-size:
      9px;
  }

  .reading-layout {
    width:
      min(
        100%,
        980px
      );

    min-width:
      0;

    margin:
      0 auto;

    padding:
      74px 0 28px;

    display:
      grid;

    grid-template-columns:
      120px
      minmax(
        0,
        var(--article-width)
      );

    justify-content:
      center;

    gap:
      54px;
  }

  .sidebar-card {
    position:
      sticky;

    top:
      110px;

    padding:
      18px 14px;

    display:
      flex;

    flex-direction:
      column;

    border:
      1px solid
      var(--border);

    border-radius:
      18px;

    background:
      var(--color-surface);
  }

  .sidebar-card strong {
    margin-top:
      14px;

    color:
      var(--color-primary);

    font-size:
      28px;
  }

  .sidebar-line {
    height:
      1px;

    margin:
      18px 0;

    background:
      var(--border);
  }

  .sidebar-label,
  .sidebar-text,
  .sidebar-card > span {
    color:
      var(--text-muted);

    font-size:
      9px;
  }

  .article-body {
    min-width:
      0;
  }

  .article-content {
    min-width:
      0;

    font-size:
      17px;

    line-height:
      1.9;
  }

  .article-content
  > :global(h1:first-child) {
    display:
      none;
  }

  .article-content
  :global(h2) {
    margin:
      64px 0 20px;

    font-size:
      30px;

    line-height:
      1.3;

    word-break:
      normal;
  }

  .article-content
  :global(h3) {
    margin:
      42px 0 16px;

    font-size:
      22px;
  }

  .article-content
  :global(p) {
    margin:
      0 0 24px;

    color:
      var(--text-secondary);
  }

  .article-content
  :global(ul),
  .article-content
  :global(ol) {
    padding-left:
      26px;

    color:
      var(--text-secondary);
  }

  .article-content
  :global(img) {
    width:
      100%;

    height:
      auto;

    margin:
      34px 0;

    border-radius:
      var(--radius-lg);
  }

  .article-content
  :global(pre) {
    width:
      100%;

    max-width:
      100%;

    margin:
      32px 0;

    padding:
      22px;

    overflow-x:
      auto;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-lg);

    background:
      #111421;

    font-size:
      13px;

    -webkit-overflow-scrolling:
      touch;
  }

  .article-content
  :global(table) {
    width:
      100%;

    max-width:
      100%;

    display:
      block;

    overflow-x:
      auto;

    -webkit-overflow-scrolling:
      touch;
  }

  .article-end {
    margin-top:
      70px;

    padding:
      32px 20px;

    border-top:
      1px solid
      var(--border);

    text-align:
      center;
  }

  .article-end p {
    margin:
      10px 0 0;
  }

  .article-end span {
    color:
      var(--text-muted);

    font-size:
      10px;
  }

  .article-footer {
    margin-top:
      54px;

    padding:
      70px 0 24px;

    border-top:
      1px solid
      var(--border);
  }

  .article-footer-heading {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap:
      30px;
  }

  .article-footer-heading p {
    margin:
      0 0 8px;

    color:
      var(--color-primary);

    font-size:
      9px;
  }

  .article-footer-heading h2 {
    margin:
      0;

    font-size:
      34px;
  }

  .article-navigation {
    min-width:
      0;

    margin-top:
      30px;

    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      18px;
  }

  .navigation-card {
    min-width:
      0;

    min-height:
      190px;

    padding:
      24px;

    display:
      flex;

    flex-direction:
      column;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-lg);

    background:
      var(--color-surface);
  }

  .navigation-card > span {
    color:
      var(--text-muted);

    font-size:
      9px;
  }

  .navigation-card strong {
    margin-top:
      28px;

    font-size:
      19px;

    word-break:
      normal;
  }

  .navigation-card p {
    color:
      var(--text-secondary);

    font-size:
      12px;
  }

  .disabled {
    opacity:
      0.52;
  }

  /* Runtime mobile fallback */

  :global(html.mobile-device)
  .article {
    padding:
      42px 0 18px;
  }

  :global(html.mobile-device)
  .article-header {
    padding-bottom:
      52px;
  }

  :global(html.mobile-device)
  .article-type {
    display:
      none;
  }

  :global(html.mobile-device)
  .article-heading {
    width:
      100%;

    margin-top:
      46px;

    text-align:
      left;
  }

  :global(html.mobile-device)
  .article-eyebrow {
    margin:
      0;
  }

  :global(html.mobile-device)
  .article-heading h1 {
    width:
      100%;

    font-size:
      clamp(
        38px,
        11vw,
        54px
      );

    word-break:
      normal;
  }

  :global(html.mobile-device)
  .article-description {
    width:
      100%;

    margin-left:
      0;

    font-size:
      15px;
  }

  :global(html.mobile-device)
  .article-meta {
    justify-content:
      flex-start;
  }

  :global(html.mobile-device)
  .meta-item {
    align-items:
      flex-start;
  }

  :global(html.mobile-device)
  .article-tags {
    justify-content:
      flex-start;
  }

  :global(html.mobile-device)
  .article-cover {
    margin-top:
      40px;

    border-radius:
      var(--radius-lg);
  }

  :global(html.mobile-device)
  .article-cover figcaption {
    display:
      none;
  }

  :global(html.mobile-device)
  .reading-layout {
    width:
      100%;

    padding-top:
      52px;

    grid-template-columns:
      minmax(0, 1fr);

    gap:
      0;
  }

  :global(html.mobile-device)
  .article-sidebar {
    display:
      none;
  }

  :global(html.mobile-device)
  .article-content {
    width:
      100%;

    font-size:
      16px;

    line-height:
      1.86;
  }

  :global(html.mobile-device)
  .article-content
  :global(h2) {
    margin-top:
      52px;

    font-size:
      26px;
  }

  :global(html.mobile-device)
  .article-content
  :global(h3) {
    font-size:
      20px;
  }

  :global(html.mobile-device)
  .article-footer {
    padding-top:
      54px;
  }

  :global(html.mobile-device)
  .article-footer-heading {
    align-items:
      flex-start;

    flex-direction:
      column;

    gap:
      16px;
  }

  :global(html.mobile-device)
  .article-navigation {
    grid-template-columns:
      minmax(0, 1fr);
  }

  @media (
    max-width: 900px
  ) {
    .reading-layout {
      grid-template-columns:
        1fr;
    }

    .article-sidebar {
      display:
        none;
    }
  }

  @media (
    max-width: 700px
  ) {
    .article {
      padding:
        42px 0 18px;
    }

    .article-type {
      display:
        none;
    }

    .article-heading {
      margin-top:
        46px;

      text-align:
        left;
    }

    .article-eyebrow {
      margin:
        0;
    }

    .article-meta,
    .article-tags {
      justify-content:
        flex-start;
    }

    .article-navigation {
      grid-template-columns:
        1fr;
    }
  }
</style>