---
import Layout from "../../layouts/Layout.astro";

import {
  getCollection,
  render,
} from "astro:content";

export async function getStaticPaths() {
  const posts =
    (await getCollection("posts"))
      .filter(
        (post) =>
          !post.data.draft
      );

  return posts.map(
    (post) => ({
      params: {
        id: post.id,
      },

      props: {
        post,
      },
    })
  );
}

const {
  post,
} = Astro.props;

const allPosts =
  (await getCollection("posts"))
    .filter(
      (item) =>
        !item.data.draft
    )
    .sort(
      (a, b) =>
        b.data.date.getTime() -
        a.data.date.getTime()
    );

const currentIndex =
  allPosts.findIndex(
    (item) =>
      item.id === post.id
  );

const olderPost =
  currentIndex <
  allPosts.length - 1
    ? allPosts[
        currentIndex + 1
      ]
    : undefined;

const newerPost =
  currentIndex > 0
    ? allPosts[
        currentIndex - 1
      ]
    : undefined;

const {
  Content,
} = await render(post);

const publishedDate =
  post.data.date.toLocaleDateString(
    "zh-CN",
    {
      year: "numeric",
      month: "long",
      day: "numeric",
    }
  );
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  imageAlt={
    post.data.coverAlt ??
    post.data.title
  }
  type="article"
  publishedTime={post.data.date}
>
  <article class="article">
    <header class="article-header">
      <div class="article-topbar">
        <a
          class="back-link"
          href="/blog"
        >
          <span
            aria-hidden="true"
          >
            ←
          </span>

          <span>
            返回文章
          </span>
        </a>

        <span class="article-type">
          ARTICLE / FJK BLOG
        </span>
      </div>

      <div class="article-heading">
        <div class="article-eyebrow">
          <span
            class="eyebrow-dot"
            aria-hidden="true"
          ></span>

          <span>
            STORIES & NOTES
          </span>
        </div>

        <h1>
          {post.data.title}
        </h1>

        <p class="article-description">
          {post.data.description}
        </p>

        <div class="article-meta">
          <div class="meta-item">
            <span class="meta-label">
              PUBLISHED
            </span>

            <time
              datetime={
                post.data.date.toISOString()
              }
            >
              {publishedDate}
            </time>
          </div>

          <div class="meta-divider"></div>

          <div class="meta-item">
            <span class="meta-label">
              CATEGORY
            </span>

            <a
              href={`/blog/category/${encodeURIComponent(
                post.data.category
              )}/`}
            >
              {post.data.category}
            </a>
          </div>

          {
            post.data.tags.length >
              0 && (
              <>
                <div class="meta-divider"></div>

                <div class="meta-item">
                  <span class="meta-label">
                    TAGS
                  </span>

                  <span>
                    {
                      post.data.tags.length
                    }
                    {" "}
                    Topics
                  </span>
                </div>
              </>
            )
          }
        </div>

        {
          post.data.tags.length >
            0 && (
            <div class="article-tags">
              {
                post.data.tags.map(
                  (tag) => (
                    <a
                      href={`/blog/tag/${encodeURIComponent(
                        tag
                      )}/`}
                    >
                      #{tag}
                    </a>
                  )
                )
              }
            </div>
          )
        }
      </div>

      {
        post.data.cover && (
          <figure class="article-cover">
            <img
              src={post.data.cover}
              alt={
                post.data.coverAlt ??
                post.data.title
              }
            />

            <div
              class="cover-shine"
              aria-hidden="true"
            ></div>

            <figcaption>
              <span>
                FJK BLOG
              </span>

              <span>
                {
                  post.data.coverAlt ??
                  post.data.title
                }
              </span>
            </figcaption>
          </figure>
        )
      }
    </header>

    <div class="reading-layout">
      <aside class="article-sidebar">
        <div class="sidebar-card">
          <span class="sidebar-label">
            ARTICLE
          </span>

          <strong>
            {String(
              currentIndex + 1
            ).padStart(
              2,
              "0"
            )}
          </strong>

          <span class="sidebar-total">
            / {String(
              allPosts.length
            ).padStart(
              2,
              "0"
            )}
          </span>

          <div class="sidebar-line"></div>

          <span class="sidebar-text">
            Keep learning.
            <br />
            Keep building.
          </span>
        </div>
      </aside>

      <main class="article-body">
        <div class="article-content">
          <Content />
        </div>

        <div class="article-end">
          <div
            class="end-symbol"
            aria-hidden="true"
          >
            ✦
          </div>

          <p>
            Thanks for reading.
          </p>

          <span>
            感谢阅读
          </span>
        </div>
      </main>
    </div>

    <footer class="article-footer">
      <div class="article-footer-heading">
        <div>
          <p>
            CONTINUE READING
          </p>

          <h2>
            继续阅读
          </h2>
        </div>

        <a href="/blog">
          全部文章
          <span aria-hidden="true">
            →
          </span>
        </a>
      </div>

      <nav
        class="article-navigation"
        aria-label="文章导航"
      >
        {
          olderPost ? (
            <a
              class="navigation-card"
              href={`/blog/${olderPost.id}/`}
            >
              <div class="navigation-top">
                <span>
                  ← 较早文章
                </span>

                <span class="navigation-index">
                  PREV
                </span>
              </div>

              <strong>
                {olderPost.data.title}
              </strong>

              <p>
                {
                  olderPost.data.description
                }
              </p>

              <div class="navigation-bottom">
                <span>
                  {
                    olderPost.data
                      .category
                  }
                </span>

                <span
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>
            </a>
          ) : (
            <div class="navigation-card disabled">
              <div class="navigation-top">
                <span>
                  ← 较早文章
                </span>

                <span class="navigation-index">
                  PREV
                </span>
              </div>

              <strong>
                已经是最早的文章
              </strong>

              <p>
                暂时没有更早的内容。
              </p>
            </div>
          )
        }

        {
          newerPost ? (
            <a
              class="navigation-card navigation-newer"
              href={`/blog/${newerPost.id}/`}
            >
              <div class="navigation-top">
                <span>
                  较新文章 →
                </span>

                <span class="navigation-index">
                  NEXT
                </span>
              </div>

              <strong>
                {newerPost.data.title}
              </strong>

              <p>
                {
                  newerPost.data.description
                }
              </p>

              <div class="navigation-bottom">
                <span>
                  {
                    newerPost.data
                      .category
                  }
                </span>

                <span
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>
            </a>
          ) : (
            <div class="navigation-card disabled">
              <div class="navigation-top">
                <span>
                  较新文章 →
                </span>

                <span class="navigation-index">
                  NEXT
                </span>
              </div>

              <strong>
                已经是最新的文章
              </strong>

              <p>
                新内容正在准备中。
              </p>
            </div>
          )
        }
      </nav>
    </footer>
  </article>
</Layout>

<style>
  .article {
    padding:
      66px 0 40px;
  }

  .article-header {
    padding-bottom:
      70px;

    border-bottom:
      1px solid
      var(--border);
  }

  .article-topbar {
    display: flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      24px;
  }

  .back-link {
    min-height:
      38px;

    padding:
      0 12px;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      12px;

    background:
      var(--color-surface);

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    font-size:
      11px;

    font-weight:
      650;

    transition:
      transform
        var(--transition-fast),
      border-color
        var(--transition-fast),
      color
        var(--transition-fast),
      background-color
        var(--transition-fast);
  }

  .back-link:hover {
    transform:
      translateX(-2px);

    border-color:
      var(--border-strong);

    background:
      var(--color-surface-elevated);

    color:
      var(--color-primary);
  }

  .article-type {
    color:
      var(--text-muted);

    font-size:
      9px;

    font-weight:
      750;

    letter-spacing:
      0.13em;
  }

  .article-heading {
    width:
      min(
        100%,
        880px
      );

    margin:
      64px auto 0;

    text-align:
      center;
  }

  .article-eyebrow {
    width:
      fit-content;

    margin:
      0 auto;

    padding:
      7px 11px;

    display:
      flex;

    align-items:
      center;

    gap:
      8px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-surface);

    color:
      var(--text-secondary);

    box-shadow:
      var(--shadow-sm);

    font-size:
      9px;

    font-weight:
      750;

    letter-spacing:
      0.14em;
  }

  .eyebrow-dot {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        var(--color-cyan)
          15%,
        transparent
      );
  }

  .article-heading h1 {
    margin:
      24px auto 0;

    font-size:
      clamp(
        44px,
        6.5vw,
        72px
      );

    line-height:
      1.12;

    letter-spacing:
      -0.055em;
  }

  .article-description {
    width:
      min(
        100%,
        680px
      );

    margin:
      22px auto 0;

    color:
      var(--text-secondary);

    font-size:
      16px;

    line-height:
      1.85;
  }

  .article-meta {
    margin-top:
      34px;

    display:
      flex;

    align-items:
      stretch;

    justify-content:
      center;

    flex-wrap:
      wrap;

    gap:
      18px;
  }

  .meta-item {
    display:
      flex;

    align-items:
      center;

    flex-direction:
      column;

    justify-content:
      center;

    gap:
      5px;
  }

  .meta-label {
    color:
      var(--text-muted);

    font-size:
      8px;

    font-weight:
      750;

    letter-spacing:
      0.13em;
  }

  .meta-item time,
  .meta-item a,
  .meta-item > span:last-child {
    color:
      var(--text-secondary);

    font-size:
      11px;

    font-weight:
      550;
  }

  .meta-item a:hover {
    color:
      var(--color-primary);
  }

  .meta-divider {
    width:
      1px;

    min-height:
      34px;

    background:
      var(--border);
  }

  .article-tags {
    margin-top:
      24px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    flex-wrap:
      wrap;

    gap:
      7px;
  }

  .article-tags a {
    padding:
      6px 9px;

    border:
      1px solid
      var(--border);

    border-radius:
      999px;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size:
      10px;

    font-weight:
      650;

    transition:
      transform
        var(--transition-fast),
      border-color
        var(--transition-fast);
  }

  .article-tags a:hover {
    transform:
      translateY(-2px);

    border-color:
      var(--border-strong);
  }

  .article-cover {
    position:
      relative;

    margin:
      54px 0 0;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-xl);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-card);
  }

  .article-cover img {
    width:
      100%;

    max-height:
      620px;

    aspect-ratio:
      16 / 9;

    object-fit:
      cover;
  }

  .cover-shine {
    position:
      absolute;

    inset:
      0;

    background:
      linear-gradient(
        135deg,
        rgba(
          255,
          255,
          255,
          0.08
        ),
        transparent 38%
      );

    pointer-events:
      none;
  }

  .article-cover figcaption {
    min-height:
      42px;

    padding:
      0 16px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      20px;

    border-top:
      1px solid
      var(--border);

    color:
      var(--text-muted);

    font-size:
      9px;
  }

  .article-cover figcaption
  span:first-child {
    flex-shrink:
      0;

    color:
      var(--color-primary);

    font-weight:
      750;

    letter-spacing:
      0.11em;
  }

  .article-cover figcaption
  span:last-child {
    overflow:
      hidden;

    text-overflow:
      ellipsis;

    white-space:
      nowrap;
  }

  .reading-layout {
    width:
      min(
        100%,
        980px
      );

    margin:
      0 auto;

    padding:
      74px 0 28px;

    display:
      grid;

    grid-template-columns:
      120px
      minmax(
        0,
        var(--article-width)
      );

    justify-content:
      center;

    gap:
      54px;
  }

  .article-sidebar {
    position:
      relative;
  }

  .sidebar-card {
    position:
      sticky;

    top:
      110px;

    padding:
      18px 14px;

    display:
      flex;

    flex-direction:
      column;

    border:
      1px solid
      var(--border);

    border-radius:
      18px;

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-sm);
  }

  .sidebar-label {
    color:
      var(--text-muted);

    font-size:
      8px;

    font-weight:
      800;

    letter-spacing:
      0.12em;
  }

  .sidebar-card strong {
    margin-top:
      14px;

    color:
      var(--color-primary);

    font-size:
      28px;

    line-height:
      1;
  }

  .sidebar-total {
    margin-top:
      3px;

    color:
      var(--text-muted);

    font-size:
      10px;
  }

  .sidebar-line {
    height:
      1px;

    margin:
      18px 0;

    background:
      var(--border);
  }

  .sidebar-text {
    color:
      var(--text-secondary);

    font-size:
      9px;

    line-height:
      1.7;

    letter-spacing:
      0.02em;
  }

  .article-body {
    min-width:
      0;
  }

  .article-content {
    font-size:
      17px;

    line-height:
      1.9;
  }

  /*
   * Markdown 文件本身目前以 # 标题开头。
   * 页面 Header 已经显示文章标题，
   * 所以隐藏正文中的重复首个 H1。
   */
  .article-content
  > :global(h1:first-child) {
    display:
      none;
  }

  .article-content
  :global(h1),
  .article-content
  :global(h2),
  .article-content
  :global(h3),
  .article-content
  :global(h4) {
    position:
      relative;

    scroll-margin-top:
      120px;
  }

  .article-content
  :global(h2) {
    margin:
      64px 0 20px;

    padding-top:
      8px;

    font-size:
      30px;

    line-height:
      1.3;

    letter-spacing:
      -0.04em;
  }

  .article-content
  :global(h2::before) {
    content:
      "";

    position:
      absolute;

    top:
      -11px;

    left:
      0;

    width:
      28px;

    height:
      3px;

    border-radius:
      999px;

    background:
      linear-gradient(
        90deg,
        var(--color-primary),
        var(--color-pink)
      );
  }

  .article-content
  :global(h3) {
    margin:
      42px 0 16px;

    font-size:
      22px;

    line-height:
      1.4;

    letter-spacing:
      -0.025em;
  }

  .article-content
  :global(h4) {
    margin:
      32px 0 12px;

    font-size:
      18px;
  }

  .article-content
  :global(p) {
    margin:
      0 0 24px;

    color:
      var(--text-secondary);
  }

  .article-content
  :global(strong) {
    font-weight:
      700;
  }

  .article-content
  :global(ul),
  .article-content
  :global(ol) {
    margin:
      22px 0 28px;

    padding-left:
      26px;

    color:
      var(--text-secondary);
  }

  .article-content
  :global(li) {
    margin:
      8px 0;

    padding-left:
      4px;
  }

  .article-content
  :global(li::marker) {
    color:
      var(--color-primary);
  }

  .article-content
  :global(blockquote) {
    position:
      relative;

    margin:
      36px 0;

    padding:
      22px 24px 22px 27px;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-left:
      3px solid
      var(--color-primary);

    border-radius:
      0
      var(--radius-md)
      var(--radius-md)
      0;

    background:
      linear-gradient(
        135deg,
        var(--color-primary-soft),
        var(--color-surface)
      );

    box-shadow:
      var(--shadow-sm);
  }

  .article-content
  :global(blockquote p) {
    margin:
      0;

    color:
      var(--text-secondary);
  }

  .article-content
  :global(a) {
    color:
      var(--color-primary);

    text-decoration:
      underline;

    text-decoration-color:
      color-mix(
        in srgb,
        var(--color-primary)
          35%,
        transparent
      );

    text-underline-offset:
      4px;
  }

  .article-content
  :global(a:hover) {
    text-decoration-color:
      var(--color-primary);
  }

  .article-content
  :global(img) {
    width:
      100%;

    margin:
      34px 0;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-lg);

    box-shadow:
      var(--shadow-card);
  }

  .article-content
  :global(hr) {
    margin:
      52px 0;
  }

  .article-content
  :global(pre) {
    margin:
      32px 0;

    padding:
      22px;

    overflow-x:
      auto;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-lg);

    background:
      #111421;

    box-shadow:
      var(--shadow-card);

    font-size:
      13px;

    line-height:
      1.75;
  }

  .article-content
  :global(pre code) {
    padding:
      0;

    border:
      0;

    background:
      transparent;

    color:
      inherit;
  }

  .article-content
  :global(:not(pre) > code) {
    padding:
      0.18em
      0.43em;

    border:
      1px solid
      var(--border);

    border-radius:
      7px;

    background:
      var(--color-primary-soft);

    color:
      var(--color-primary);

    font-size:
      0.9em;
  }

  .article-content
  :global(table) {
    width:
      100%;

    margin:
      32px 0;

    border-collapse:
      collapse;

    overflow:
      hidden;

    border:
      1px solid
      var(--border);

    border-radius:
      var(--radius-md);

    font-size:
      14px;
  }

  .article-content
  :global(th),
  .article-content
  :global(td) {
    padding:
      12px 14px;

    border:
      1px solid
      var(--border);

    text-align:
      left;
  }

  .article-content
  :global(th) {
    background:
      var(--color-primary-soft);

    color:
      var(--text-primary);
  }

  .article-content
  :global(td) {
    color:
      var(--text-secondary);
  }

  .article-end {
    margin-top:
      70px;

    padding:
      32px 20px;

    display:
      flex;

    align-items:
      center;

    flex-direction:
      column;

    border-top:
      1px solid
      var(--border);

    text-align:
      center;
  }

  .end-symbol {
    color:
      var(--color-primary);

    font-size:
      20px;

    text-shadow:
      0 0 20px
      color-mix(
        in srgb,
        var(--color-primary)
          55%,
        transparent
      );
  }

  .article-end p {
    margin:
      10px 0 0;

    color:
      var(--text-primary);

    font-size:
      13px;

    font-weight:
      700;

    letter-spacing:
      0.04em;
  }

  .article-end span {
    margin-top:
      4px;

    color:
      var(--text-muted);

    font-size:
      10px;
  }

  .article-footer {
    margin-top:
      54px;

    padding:
      70px 0 24px;

    border-top:
      1px solid
      var(--border);
  }

  .article-footer-heading {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
