---
import Header
  from "../components/Header.astro";

import Footer
  from "../components/Footer.astro";

import "../styles/global.css";

import {
  SITE,
} from "../config/site";

interface Props {
  title?: string;

  description?: string;

  image?: string;

  imageAlt?: string;

  type?: "website" | "article";

  publishedTime?: Date;

  noindex?: boolean;
}

const {
  title,

  description =
    SITE.description,

  image,

  imageAlt,

  type =
    "website",

  publishedTime,

  noindex =
    false,
} = Astro.props;

const pageTitle =
  title
    ? `${title} | ${SITE.title}`
    : SITE.title;

const siteBase =
  Astro.site ??
  new URL(
    Astro.url.origin
  );

const canonicalURL =
  new URL(
    Astro.url.pathname,
    siteBase
  );

const imageURL =
  image
    ? new URL(
        image,
        siteBase
      )
    : undefined;

const rssURL =
  new URL(
    "/rss.xml",
    siteBase
  );
---

<!doctype html>

<html lang={SITE.language}>
  <head>
    <meta
      charset="UTF-8"
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="author"
      content={SITE.author}
    />

    <meta
      name="robots"
      content={
        noindex
          ? "noindex, nofollow"
          : "index, follow"
      }
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <meta
      name="color-scheme"
      content="light dark"
    />

    <link
      rel="canonical"
      href={canonicalURL.href}
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS`}
      href={rssURL.href}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <meta
      property="og:type"
      content={type}
    />

    <meta
      property="og:site_name"
      content={SITE.title}
    />

    <meta
      property="og:title"
      content={pageTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL.href}
    />

    <meta
      property="og:locale"
      content={SITE.locale}
    />

    {
      imageURL && (
        <>
          <meta
            property="og:image"
            content={imageURL.href}
          />

          <meta
            property="og:image:alt"
            content={
              imageAlt ??
              title ??
              SITE.title
            }
          />
        </>
      )
    }

    {
      type === "article" &&
      publishedTime && (
        <meta
          property="article:published_time"
          content={
            publishedTime.toISOString()
          }
        />
      )
    }

    <meta
      name="twitter:card"
      content={
        imageURL
          ? "summary_large_image"
          : "summary"
      }
    />

    <meta
      name="twitter:title"
      content={pageTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    {
      imageURL && (
        <>
          <meta
            name="twitter:image"
            content={imageURL.href}
          />

          <meta
            name="twitter:image:alt"
            content={
              imageAlt ??
              title ??
              SITE.title
            }
          />
        </>
      )
    }

    <title>
      {pageTitle}
    </title>

    <!--
      Cross-platform mobile fallback.

      Standard browsers should enter the mobile layout
      through CSS media queries.

      Some embedded / system browsers expose an
      unexpectedly wide layout viewport. In that case
      we additionally detect a touch-oriented device
      using the physical screen's short side.
    -->
    <script is:inline>
      (() => {
        try {
          const screenWidth =
            window.screen?.width ?? 0;

          const screenHeight =
            window.screen?.height ?? 0;

          const shortSide =
            screenWidth > 0 &&
            screenHeight > 0
              ? Math.min(
                  screenWidth,
                  screenHeight
                )
              : 9999;

          const hasTouch =
            navigator.maxTouchPoints > 0 ||
            "ontouchstart" in window;

          const normalMobileViewport =
            window.matchMedia(
              "(max-width: 760px)"
            ).matches;

          const touchMobileDevice =
            hasTouch &&
            shortSide <= 900;

          const useMobileLayout =
            normalMobileViewport ||
            touchMobileDevice;

          document.documentElement
            .classList.toggle(
              "mobile-device",
              useMobileLayout
            );
        } catch {
          /*
           * CSS responsive rules remain
           * the normal fallback.
           */
        }
      })();
    </script>

    <script is:inline>
      (() => {
        try {
          const savedTheme =
            localStorage.getItem(
              "theme"
            );

          let theme;

          if (
            savedTheme === "dark" ||
            savedTheme === "light"
          ) {
            theme =
              savedTheme;
          } else {
            theme =
              window.matchMedia(
                "(prefers-color-scheme: dark)"
              ).matches
                ? "dark"
                : "light";
          }

          document.documentElement
            .classList.toggle(
              "dark",
              theme === "dark"
            );
        } catch {
          const prefersDark =
            window.matchMedia(
              "(prefers-color-scheme: dark)"
            ).matches;

          document.documentElement
            .classList.toggle(
              "dark",
              prefersDark
            );
        }
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="site-main">
      <slot />
    </main>

    <Footer />
  </body>
</html>