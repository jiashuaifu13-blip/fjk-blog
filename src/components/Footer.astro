---
import {
  NAV_ITEMS,
  SITE,
} from "../config/site";

const year =
  new Date().getFullYear();
---

<!--
  Global atmosphere

  Footer exists on every page, so this
  very small decorative layer can stay
  here without adding another component
  to Layout.astro.
-->
<div
  class="site-atmosphere"
  aria-hidden="true"
>
  <span class="petal petal-1"></span>
  <span class="petal petal-2"></span>
  <span class="petal petal-3"></span>
  <span class="petal petal-4"></span>
  <span class="petal petal-5"></span>
  <span class="petal petal-6"></span>
</div>

<footer class="site-footer">
  <div
    class="footer-atmosphere"
    aria-hidden="true"
  >
    <div class="footer-glow footer-glow-primary"></div>
    <div class="footer-glow footer-glow-pink"></div>
    <div class="footer-sparkles"></div>
    <div class="footer-grid"></div>
  </div>

  <div class="footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <a
          class="brand-mark"
          href="/"
          aria-label={`${SITE.title} 首页`}
        >
          <span class="brand-symbol">
            F
          </span>

          <span class="brand-copy">
            <strong>
              FJK
            </strong>

            <small>
              PERSONAL BLOG
            </small>
          </span>
        </a>

        <p class="brand-description">
          记录技术、项目、学习与生活。
          保留那些值得以后再次回看的东西。
        </p>

        <div class="brand-status">
          <span
            class="status-dot"
            aria-hidden="true"
          ></span>

          <span>
            KEEP BUILDING
          </span>

          <i></i>

          <span>
            fjksp.cn
          </span>
        </div>
      </div>

      <div class="footer-navigation">
        <div class="footer-column">
          <p class="footer-label">
            NAVIGATION
          </p>

          <nav
            class="footer-links"
            aria-label="页脚导航"
          >
            {
              NAV_ITEMS.map((item) => (
                <a href={item.href}>
                  <span>
                    {item.label}
                  </span>

                  <span
                    class="link-arrow"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              ))
            }
          </nav>
        </div>

        <div class="footer-column">
          <p class="footer-label">
            ELSEWHERE
          </p>

          <div class="footer-links">
            <a
              href="/rss.xml"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>
                RSS
              </span>

              <span
                class="link-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>

            <a
              href="https://github.com/jiashuaifu13-blip/fjk-blog"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>
                GitHub
              </span>

              <span
                class="link-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>

            <a href="/projects">
              <span>
                Projects
              </span>

              <span
                class="link-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-divider">
      <span></span>

      <div
        class="divider-mark"
        aria-hidden="true"
      >
        ✦
      </div>

      <span></span>
    </div>

    <div class="footer-bottom">
      <div class="copyright">
        <span>
          © {year} {SITE.author}
        </span>

        <span class="copyright-dot">
          ·
        </span>

        <span>
          Built with Astro
        </span>
      </div>

      <div class="footer-signature">
        <span>
          ANIME SOFT TECH
        </span>

        <i></i>

        <span>
          FJK BLOG
        </span>
      </div>

      <a
        class="back-top"
        href="#top"
        aria-label="返回页面顶部"
      >
        <span>
          TOP
        </span>

        <span
          aria-hidden="true"
        >
          ↑
        </span>
      </a>
    </div>
  </div>
</footer>

<style>
  /* =========================
     Global atmosphere
     ========================= */

  .site-atmosphere {
    position: fixed;

    z-index: 30;

    inset: 0;

    overflow: hidden;

    pointer-events: none;

    user-select: none;

    contain: layout paint;
  }

  .petal {
    position: absolute;

    top: -7vh;

    width: 12px;
    height: 8px;

    border-radius:
      80% 20% 70% 30%;

    background:
      linear-gradient(
        135deg,
        color-mix(
          in srgb,
          var(--color-pink) 64%,
          #ffffff
        ),
        color-mix(
          in srgb,
          var(--color-primary) 24%,
          #ffffff
        )
      );

    box-shadow:
      0 0 10px
      color-mix(
        in srgb,
        var(--color-pink) 16%,
        transparent
      );

    opacity: 0.22;

    animation-name:
      petal-fall;

    animation-timing-function:
      linear;

    animation-iteration-count:
      infinite;

    will-change:
      transform;
  }

  .petal::after {
    content: "";

    position: absolute;

    width: 4px;
    height: 4px;

    top: 1px;
    left: 2px;

    border-radius: 50%;

    background:
      rgba(
        255,
        255,
        255,
        0.48
      );
  }

  .petal-1 {
    left: 8%;

    animation-duration:
      19s;

    animation-delay:
      -6s;
  }

  .petal-2 {
    left: 24%;

    width: 9px;
    height: 7px;

    opacity: 0.17;

    animation-duration:
      24s;

    animation-delay:
      -18s;
  }

  .petal-3 {
    left: 43%;

    width: 11px;
    height: 7px;

    animation-duration:
      22s;

    animation-delay:
      -10s;
  }

  .petal-4 {
    left: 62%;

    width: 8px;
    height: 6px;

    opacity: 0.15;

    animation-duration:
      27s;

    animation-delay:
      -21s;
  }

  .petal-5 {
    left: 79%;

    width: 13px;
    height: 8px;

    animation-duration:
      21s;

    animation-delay:
      -4s;
  }

  .petal-6 {
    left: 92%;

    width: 9px;
    height: 6px;

    opacity: 0.17;

    animation-duration:
      25s;

    animation-delay:
      -14s;
  }

  @keyframes petal-fall {
    0% {
      transform:
        translate3d(
          0,
          -10vh,
          0
        )
        rotate(0deg);

      opacity: 0;
    }

    8% {
      opacity: 0.2;
    }

    35% {
      transform:
        translate3d(
          32px,
          35vh,
          0
        )
        rotate(145deg);
    }

    68% {
      transform:
        translate3d(
          -18px,
          70vh,
          0
        )
        rotate(285deg);

      opacity: 0.2;
    }

    100% {
      transform:
        translate3d(
          22px,
          108vh,
          0
        )
        rotate(430deg);

      opacity: 0;
    }
  }

  :global(html.dark)
  .petal {
    opacity: 0.15;

    filter:
      saturate(0.78);
  }

  /* =========================
     Footer
     ========================= */

  .site-footer {
    position: relative;

    min-width: 0;

    margin:
      0 calc(
        50% - 50vw
      );

    overflow: hidden;

    border-top:
      1px solid
      var(--border);

    background:
      color-mix(
        in srgb,
        var(--background) 94%,
        var(--color-primary-soft)
      );

    isolation: isolate;
  }

  .footer-atmosphere {
    position: absolute;

    z-index: -1;

    inset: 0;

    overflow: hidden;

    pointer-events: none;
  }

  .footer-glow {
    position: absolute;

    border-radius: 50%;

    filter:
      blur(20px);
  }

  .footer-glow-primary {
    width: 460px;
    height: 460px;

    left: -180px;
    bottom: -310px;

    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--color-primary) 17%,
          transparent
        ),
        transparent 70%
      );
  }

  .footer-glow-pink {
    width: 380px;
    height: 380px;

    right: -130px;
    top: -210px;

    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--color-pink) 12%,
          transparent
        ),
        transparent 70%
      );
  }

  .footer-sparkles {
    position: absolute;

    inset: 0;

    background-image:
      url(
        "/images/anime/effects/sparkles.gif"
      );

    background-size:
      600px auto;

    background-position:
      center;

    mix-blend-mode:
      screen;

    opacity: 0.025;
  }

  :global(html.dark)
  .footer-sparkles {
    opacity: 0.04;
  }

  .footer-grid {
    position: absolute;

    inset: 0;

    opacity: 0.17;

    background-image:
      linear-gradient(
        color-mix(
          in srgb,
          var(--border) 45%,
          transparent
        )
        1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(
          in srgb,
          var(--border) 45%,
          transparent
        )
        1px,
        transparent 1px
      );

    background-size:
      56px 56px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        #000 20%,
        #000 80%,
        transparent
      );

    -webkit-mask-image:
      linear-gradient(
        to bottom,
        transparent,
        #000 20%,
        #000 80%,
        transparent
      );
  }

  .footer-inner {
    width:
      min(
        calc(
          100% - 48px
        ),
        1180px
      );

    margin:
      0 auto;

    padding:
      70px 0 30px;
  }

  /* =========================
     Main content
     ========================= */

  .footer-main {
    min-width: 0;

    display: grid;

    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(360px, 0.9fr);

    align-items: start;

    gap: 72px;
  }

  .footer-main > * {
    min-width: 0;
  }

  .footer-brand {
    max-width: 540px;
  }

  .brand-mark {
    width: fit-content;

    display: inline-flex;

    align-items: center;

    gap: 13px;
  }

  .brand-symbol {
    width: 46px;
    height: 46px;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-primary) 22%,
        var(--border)
      );

    border-radius: 15px;

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-secondary),
        var(--color-pink)
      );

    color: #ffffff;

    box-shadow:
      0 10px 24px
      color-mix(
        in srgb,
        var(--color-primary) 16%,
        transparent
      );

    font-size: 20px;
    font-weight: 800;
  }

  .brand-copy {
    display: flex;

    flex-direction: column;

    gap: 2px;
  }

  .brand-copy strong {
    color:
      var(--text-primary);

    font-size: 21px;

    letter-spacing:
      -0.025em;
  }

  .brand-copy small {
    color:
      var(--text-muted);

    font-size: 8px;
    font-weight: 700;

    letter-spacing:
      0.14em;
  }

  .brand-description {
    max-width: 470px;

    margin:
      23px 0 0;

    color:
      var(--text-secondary);

    font-size: 13px;
    line-height: 1.85;
  }

  .brand-status {
    margin-top: 25px;

    display: flex;

    align-items: center;
    flex-wrap: wrap;

    gap: 9px;

    color:
      var(--text-muted);

    font-size: 8px;
    font-weight: 700;

    letter-spacing:
      0.1em;
  }

  .status-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        var(--color-cyan) 12%,
        transparent
      );
  }

  .brand-status i {
    width: 26px;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        var(--color-primary),
        transparent
      );
  }

  /* =========================
     Navigation
     ========================= */

  .footer-navigation {
    min-width: 0;

    display: grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap: 42px;
  }

  .footer-label {
    margin:
      0 0 16px;

    color:
      var(--color-primary);

    font-size: 8px;
    font-weight: 800;

    letter-spacing:
      0.15em;
  }

  .footer-links {
    display: flex;

    flex-direction: column;

    gap: 4px;
  }

  .footer-links a {
    min-width: 0;
    min-height: 36px;

    padding:
      0 8px;

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;

    border-radius: 9px;

    color:
      var(--text-secondary);

    font-size: 11px;

    transition:
      color
        var(--transition-fast),
      background-color
        var(--transition-fast),
      transform
        var(--transition-fast);
  }

  .footer-links a:hover {
    color:
      var(--color-primary);

    background:
      var(--color-primary-soft);

    transform:
      translateX(2px);
  }

  .link-arrow {
    flex-shrink: 0;

    color:
      var(--text-muted);

    opacity: 0;

    transform:
      translate(
        -3px,
        3px
      );

    transition:
      opacity
        var(--transition-fast),
      transform
        var(--transition-fast),
      color
        var(--transition-fast);
  }

  .footer-links a:hover
  .link-arrow {
    color:
      var(--color-primary);

    opacity: 1;

    transform:
      translate(0);
  }

  /* =========================
     Divider
     ========================= */

  .footer-divider {
    margin:
      52px 0 24px;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);

    align-items: center;

    gap: 14px;
  }

  .footer-divider > span {
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--border)
      );
  }

  .footer-divider > span:last-child {
    background:
      linear-gradient(
        90deg,
        var(--border),
        transparent
      );
  }

  .divider-mark {
    width: 28px;
    height: 28px;

    display: flex;

    align-items: center;
    justify-content: center;

    border:
      1px solid
      var(--border);

    border-radius: 50%;

    background:
      var(--color-surface);

    color:
      var(--color-primary);

    font-size: 10px;
  }

  /* =========================
     Bottom
     ========================= */

  .footer-bottom {
    min-width: 0;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);

    align-items: center;

    gap: 24px;
  }

  .copyright {
    min-width: 0;

    display: flex;

    align-items: center;
    flex-wrap: wrap;

    gap: 7px;

    color:
      var(--text-muted);

    font-size: 9px;
  }

  .copyright-dot {
    opacity: 0.5;
  }

  .footer-signature {
    display: flex;

    align-items: center;

    gap: 8px;

    color:
      var(--text-muted);

    font-size: 7px;
    font-weight: 700;

    letter-spacing:
      0.12em;

    white-space: nowrap;
  }

  .footer-signature i {
    width: 22px;
    height: 1px;

    background:
      var(--border-strong);
  }

  .back-top {
    min-height: 34px;

    padding:
      0 10px;

    justify-self: end;

    display: inline-flex;

    align-items: center;

    gap: 7px;

    border:
      1px solid
      var(--border);

    border-radius: 9px;

    background:
      color-mix(
        in srgb,
        var(--color-surface) 72%,
        transparent
      );

    color:
      var(--text-muted);

    font-size: 8px;
    font-weight: 700;

    letter-spacing:
      0.09em;

    transition:
      transform
        var(--transition-fast),
      color
        var(--transition-fast),
      border-color
        var(--transition-fast);
  }

  .back-top:hover {
    color:
      var(--color-primary);

    border-color:
      var(--border-strong);

    transform:
      translateY(-2px);
  }

  /* =========================
     Runtime mobile fallback
     ========================= */

  :global(html.mobile-device)
  .site-atmosphere {
    opacity: 0.66;
  }

  :global(html.mobile-device)
  .petal {
    opacity: 0.11;
  }

  :global(html.mobile-device)
  .petal-2,
  :global(html.mobile-device)
  .petal-4,
  :global(html.mobile-device)
  .petal-6 {
    display: none;
  }

  :global(html.mobile-device)
  .footer-sparkles {
    opacity: 0.015;
  }

  :global(html.mobile-device)
  .footer-inner {
    width:
      min(
        calc(
          100% - 36px
        ),
        1180px
      );

    padding:
      56px 0 26px;
  }

  :global(html.mobile-device)
  .footer-main {
    grid-template-columns:
      minmax(0, 1fr);

    gap: 42px;
  }

  :global(html.mobile-device)
  .footer-navigation {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap: 24px;
  }

  :global(html.mobile-device)
  .footer-bottom {
    grid-template-columns:
      minmax(0, 1fr)
      auto;

    gap: 18px;
  }

  :global(html.mobile-device)
  .footer-signature {
    display: none;
  }

  /* =========================
     Standard responsive
     ========================= */

  @media (
    max-width: 800px
  ) {
    .footer-main {
      grid-template-columns:
        1fr;

      gap: 42px;
    }
  }

  @media (
    max-width: 700px
  ) {
    .petal {
      opacity: 0.11;
    }

    .petal-2,
    .petal-4,
    .petal-6 {
      display: none;
    }

    .footer-inner {
      width:
        calc(
          100% - 36px
        );

      padding:
        56px 0 26px;
    }

    .footer-navigation {
      gap: 24px;
    }

    .footer-bottom {
      grid-template-columns:
        1fr auto;
    }

    .footer-signature {
      display: none;
    }
  }

  @media (
    max-width: 420px
  ) {
    .footer-navigation {
      grid-template-columns:
        1fr;
    }

    .footer-divider {
      margin-top: 42px;
    }

    .footer-bottom {
      grid-template-columns:
        1fr;
    }

    .back-top {
      justify-self: start;
    }
  }

  /* =========================
     Touch
     ========================= */

  @media (
    hover: none
  ) {
    .footer-links a:hover,
    .back-top:hover {
      transform: none;
    }

    .footer-links
    .link-arrow {
      opacity: 0.55;

      transform: none;
    }
  }

  /* =========================
     Reduced motion
     ========================= */

  @media (
    prefers-reduced-motion:
      reduce
  ) {
    .petal {
      display: none !important;

      animation: none !important;
    }

    .footer-sparkles {
      display: none;
    }

    .footer-links a,
    .link-arrow,
    .back-top {
      transition:
        none !important;

      transform:
        none !important;
    }
  }
</style>