---

---

<div
  class="desktop-pet"
  data-desktop-pet
  aria-hidden="true"
>
  <canvas
    class="desktop-pet__canvas"
    data-pet-canvas
  ></canvas>
</div>


<div
  class="pet-speech"
  data-pet-speech
  hidden
></div>


<div
  class="pet-controls"
  data-pet-controls
>
  <button
    class="pet-chat-trigger"
    data-pet-chat-trigger
    type="button"
    aria-label="和桌宠聊天"
    title="和桌宠聊天"
  >
    <span
      class="pet-chat-trigger__dot"
    ></span>

    <span>
      Chat
    </span>
  </button>


  <button
    class="pet-settings-trigger"
    data-ai-settings-trigger
    type="button"
    aria-label="AI 设置"
    title="AI 设置"
  >
    ⚙
  </button>
</div>


<form
  class="pet-prompt"
  data-pet-prompt
  hidden
>
  <textarea
    class="pet-prompt__input"
    data-chat-input
    rows="1"
    maxlength="1200"
    placeholder="和我说点什么吧…"
    aria-label="聊天内容"
  ></textarea>


  <div
    class="pet-prompt__actions"
  >
    <button
      type="button"
      class="pet-prompt__stop"
      data-chat-stop
      hidden
      aria-label="停止生成"
      title="停止生成"
    >
      ■
    </button>

    <button
      type="submit"
      class="pet-prompt__send"
      data-chat-send
      aria-label="发送"
      title="发送"
      disabled
    >
      ↑
    </button>

    <button
      type="button"
      class="pet-prompt__close"
      data-chat-close
      aria-label="关闭"
      title="关闭"
    >
      ×
    </button>
  </div>
</form>


<section
  class="pet-ai-settings"
  data-ai-settings
  hidden
  aria-label="AI 设置"
>
  <header
    class="pet-ai-settings__header"
  >
    <div>
      <strong>
        AI 设置
      </strong>

      <span
        class="pet-ai-settings__subtitle"
      >
        使用你自己的 API
      </span>
    </div>

    <button
      type="button"
      class="pet-ai-settings__close"
      data-ai-settings-close
      aria-label="关闭 AI 设置"
      title="关闭"
    >
      ×
    </button>
  </header>


  <form
    class="pet-ai-settings__form"
    data-ai-settings-form
  >
    <label
      class="pet-ai-settings__field"
    >
      <span>
        Provider
      </span>

      <select
        data-ai-provider
        aria-label="AI Provider"
      >
        <option
          value="deepseek"
        >
          DeepSeek
        </option>

        <option
          value="openai"
        >
          OpenAI
        </option>

        <option
          value="openrouter"
        >
          OpenRouter
        </option>
      </select>
    </label>


    <label
      class="pet-ai-settings__field"
    >
      <span>
        Model
      </span>

      <input
        type="text"
        data-ai-model
        autocomplete="off"
        spellcheck="false"
        placeholder="例如 deepseek-chat"
      />
    </label>


    <label
      class="pet-ai-settings__field"
    >
      <span>
        API Key
      </span>

      <div
        class="pet-ai-settings__key-row"
      >
        <input
          type="password"
          data-ai-key
          autocomplete="off"
          spellcheck="false"
          placeholder="sk-..."
        />

        <button
          type="button"
          class="pet-ai-settings__visibility"
          data-ai-key-toggle
          aria-label="显示或隐藏 API Key"
          title="显示 / 隐藏"
        >
          ◉
        </button>
      </div>
    </label>


    <p
      class="pet-ai-settings__note"
    >
      API Key 仅保存在当前浏览器会话中。
      页面请求时临时发送给 fjksp.cn，
      服务器后续不会保存它。
    </p>


    <div
      class="pet-ai-settings__status"
      data-ai-settings-status
    ></div>


    <div
      class="pet-ai-settings__actions"
    >
      <button
        type="button"
        class="pet-ai-settings__clear"
        data-ai-settings-clear
      >
        清除
      </button>

      <button
        type="submit"
        class="pet-ai-settings__save"
      >
        保存
      </button>
    </div>
  </form>
</section>


<script>
  import {
    PetDataLoader,
  } from "../../lib/pet/PetDataLoader.js";

  import {
    AnimationLibrary,
  } from "../../lib/pet/AnimationLibrary.js";

  import {
    AnimationCache,
  } from "../../lib/pet/AnimationCache.js";

  import {
    PetRenderer,
  } from "../../lib/pet/PetRenderer.js";

  import {
    PetAnimator,
  } from "../../lib/pet/PetAnimator.js";

  import {
    PetAudioManager,
  } from "../../lib/pet/PetAudioManager.js";

  import {
    PetStates,
  } from "../../lib/pet/PetStates.js";

  import {
    PetStateMachine,
  } from "../../lib/pet/PetStateMachine.js";

  import {
    PetActionSelector,
  } from "../../lib/pet/PetActionSelector.js";

  import {
    PetHitTest,
  } from "../../lib/pet/PetHitTest.js";

  import {
    PetInteractionController,
  } from "../../lib/pet/PetInteractionController.js";

  import {
    AiConfigStore,
  } from "../../lib/chat/AiConfigStore.js";

  import {
    HttpChatClient,
  } from "../../lib/chat/HttpChatClient.js";

  import {
    ChatController,
  } from "../../lib/chat/ChatController.js";


  async function initDesktopPet() {

    const root =
      document.querySelector(
        "[data-desktop-pet]"
      );

    const canvas =
      root?.querySelector(
        "[data-pet-canvas]"
      );

    const speech =
      document.querySelector(
        "[data-pet-speech]"
      );

    const controls =
      document.querySelector(
        "[data-pet-controls]"
      );

    const chatTrigger =
      document.querySelector(
        "[data-pet-chat-trigger]"
      );

    const settingsTrigger =
      document.querySelector(
        "[data-ai-settings-trigger]"
      );

    const prompt =
      document.querySelector(
        "[data-pet-prompt]"
      );

    const input =
      document.querySelector(
        "[data-chat-input]"
      );

    const sendButton =
      document.querySelector(
        "[data-chat-send]"
      );

    const stopButton =
      document.querySelector(
        "[data-chat-stop]"
      );

    const closeButton =
      document.querySelector(
        "[data-chat-close]"
      );

    const settings =
      document.querySelector(
        "[data-ai-settings]"
      );

    const settingsForm =
      document.querySelector(
        "[data-ai-settings-form]"
      );

    const settingsClose =
      document.querySelector(
        "[data-ai-settings-close]"
      );

    const settingsClear =
      document.querySelector(
        "[data-ai-settings-clear]"
      );

    const settingsStatus =
      document.querySelector(
        "[data-ai-settings-status]"
      );

    const providerSelect =
      document.querySelector(
        "[data-ai-provider]"
      );

    const modelInput =
      document.querySelector(
        "[data-ai-model]"
      );

    const apiKeyInput =
      document.querySelector(
        "[data-ai-key]"
      );

    const apiKeyToggle =
      document.querySelector(
        "[data-ai-key-toggle]"
      );


    if (
      !root ||
      !(canvas instanceof HTMLCanvasElement) ||
      !(speech instanceof HTMLElement) ||
      !(controls instanceof HTMLElement) ||
      !(chatTrigger instanceof HTMLButtonElement) ||
      !(settingsTrigger instanceof HTMLButtonElement) ||
      !(prompt instanceof HTMLFormElement) ||
      !(input instanceof HTMLTextAreaElement) ||
      !(sendButton instanceof HTMLButtonElement) ||
      !(stopButton instanceof HTMLButtonElement) ||
      !(closeButton instanceof HTMLButtonElement) ||
      !(settings instanceof HTMLElement) ||
      !(settingsForm instanceof HTMLFormElement) ||
      !(settingsClose instanceof HTMLButtonElement) ||
      !(settingsClear instanceof HTMLButtonElement) ||
      !(settingsStatus instanceof HTMLElement) ||
      !(providerSelect instanceof HTMLSelectElement) ||
      !(modelInput instanceof HTMLInputElement) ||
      !(apiKeyInput instanceof HTMLInputElement) ||
      !(apiKeyToggle instanceof HTMLButtonElement)
    ) {
      return;
    }


    if (
      root.dataset.initialized ===
      "true"
    ) {
      return;
    }


    root.dataset.initialized =
      "true";


    try {

      /*
       * =====================================================
       * Pet Runtime
       * =====================================================
       */

      const petBasePath =
        "/pets/dsh";


      const loader =
        new PetDataLoader(
          petBasePath
        );


      const {
        manifest,
        actions,
      } =
        await loader.load();


      const library =
        new AnimationLibrary(
          actions
        );


      const cache =
        new AnimationCache(
          petBasePath
        );


      const renderer =
        new PetRenderer(
          canvas
        );


      const audioManager =
        new PetAudioManager(
          petBasePath
        );


      const animator =
        new PetAnimator({
          renderer,
          library,
          cache,
          audioManager,
        });


      const actionSelector =
        new PetActionSelector({
          library,
        });


      /*
       * =====================================================
       * Realtime Resource Preload
       * =====================================================
       *
       * 用户可直接感知延迟的状态：
       *
       * DRAGGING
       * INTERACT
       * THINKING
       * SPEAKING
       *
       * 在开放交互前全部完成 WebP 缓存。
       */


      const preloadStateActions =
        async (
          state,
          label
        ) => {

          const candidates =
            actionSelector
              .getCandidates({
                state,
              });


          const availableActions =
            candidates
              .map(
                (action) =>
                  library.get(
                    action.id
                  )
              )
              .filter(Boolean);


          const results =
            await Promise.allSettled(
              availableActions.map(
                (action) =>
                  cache.load(
                    action
                  )
              )
            );


          const loaded =
            results
              .filter(
                (result) =>
                  result.status ===
                  "fulfilled"
              )
              .length;


          const failed =
            results.length -
            loaded;


          console.log(
            `[FJK Pet] ${label} preload: ${loaded}/${results.length}`
          );


          if (
            failed > 0
          ) {

            console.warn(
              `[FJK Pet] ${label} preload failed: ${failed}`
            );
          }


          return {
            state,
            label,
            candidates,
            availableActions,
            loaded,
            failed,
            total:
              results.length,
          };
        };


      /*
       * -----------------------------------------------------
       * DRAGGING
       * -----------------------------------------------------
       */

      const dragActionId =
        "被鼠标拖拽悬空反馈";


      const dragAction =
        library.get(
          dragActionId
        );


      if (
        !dragAction
      ) {

        throw new Error(
          `Missing required drag action: ${dragActionId}`
        );
      }


      await cache.load(
        dragAction
      );


      console.log(
        "[FJK Pet] drag action ready"
      );


      /*
       * -----------------------------------------------------
       * INTERACT
       * -----------------------------------------------------
       */

      const interactPreload =
        await preloadStateActions(
          PetStates.INTERACT,
          "interact"
        );


      /*
       * -----------------------------------------------------
       * THINKING + SPEAKING
       * -----------------------------------------------------
       *
       * 用户发送消息后立即 THINKING；
       * 收到首个 token 后立即 SPEAKING。
       *
       * 两组动作并发预热。
       */

      const [
        thinkingPreload,
        speakingPreload,
      ] =
        await Promise.all([
          preloadStateActions(
            PetStates.THINKING,
            "thinking"
          ),

          preloadStateActions(
            PetStates.SPEAKING,
            "speaking"
          ),
        ]);


      const interactActions =
        interactPreload.candidates;


      const realtimePreloadFailed =
        interactPreload.failed +
        thinkingPreload.failed +
        speakingPreload.failed;


      if (
        realtimePreloadFailed >
        0
      ) {

        console.warn(
          `[FJK Pet] realtime preload incomplete: ${realtimePreloadFailed} failed`
        );
      }


      console.log(
        "[FJK Pet] realtime actions ready",
        {
          dragging:
            dragActionId,

          interact:
            interactPreload.loaded,

          thinking:
            thinkingPreload.loaded,

          speaking:
            speakingPreload.loaded,
        }
      );


      /*
       * =====================================================
       * Background IDLE Preload
       * =====================================================
       *
       * IDLE 动作池较大，只后台预热常用动作。
       */

      const idlePreloadIds =
        [
          "待机呼吸休闲",
          "东张西望",
          "哈欠连天",
          "超大伸懒腰",
          "悠闲哼歌",
          "三球抛接",
          "原地专心玩魔方",
          "原地小憩沉眠",
        ];


      const preloadIdleActions =
        async () => {

          const idleActions =
            idlePreloadIds
              .map(
                (id) =>
                  library.get(id)
              )
              .filter(Boolean);


          const results =
            await Promise.allSettled(
              idleActions.map(
                (action) =>
                  cache.load(
                    action
                  )
              )
            );


          const loaded =
            results
              .filter(
                (result) =>
                  result.status ===
                  "fulfilled"
              )
              .length;


          const failed =
            results.length -
            loaded;


          console.log(
            `[FJK Pet] idle preload: ${loaded}/${results.length}`
          );


          if (
            failed > 0
          ) {

            console.warn(
              `[FJK Pet] idle preload failed: ${failed}`
            );
          }
        };


      if (
        "requestIdleCallback"
        in window
      ) {

        window.requestIdleCallback(
          () => {

            preloadIdleActions();

          },
          {
            timeout:
              1500,
          }
        );

      } else {

        window.setTimeout(
          () => {

            preloadIdleActions();

          },
          300
        );
      }


      /*
       * =====================================================
       * State Machine
       * =====================================================
       */

      const stateMachine =
        new PetStateMachine({
          animator,
          actionSelector,
        });


      animator.onError =
        (error) => {

          console.error(
            "[FJK Pet Animator]",
            error
          );
        };


      stateMachine.onStateError =
        (error) => {

          console.error(
            "[FJK Pet State]",
            error
          );
        };


      stateMachine.onStateChange =
        ({
          from,
          to,
          reason,
          actionId,
          tags,
        }) => {

          console.log(
            "[FJK Pet State]",
            {
              from,
              to,
              reason,
              actionId,
              tags,
            }
          );
        };


      /*
       * 启动 IDLE。
       */

      await stateMachine.setState(
        PetStates.IDLE,
        {
          reason:
            "blog-ready",
        }
      );


      const hitTest =
        new PetHitTest({
          canvas,

          alphaThreshold:
            25,
        });


      /*
       * =====================================================
       * AI Configuration
       * =====================================================
       */

      const aiConfigStore =
        new AiConfigStore();


      const clamp =
        (
          value,
          min,
          max
        ) => {

          return Math.min(
            Math.max(
              value,
              min
            ),
            max
          );
        };


      const setSpeech =
        (
          content
        ) => {

          const text =
            String(
              content ??
              ""
            ).trim();


          speech.textContent =
            text;


          speech.hidden =
            !text;


          if (
            !text
          ) {

            speech.scrollTop =
              0;
          }


          if (
            text
          ) {

            requestAnimationFrame(
              syncCompanionPosition
            );
          }
        };


      /*
       * =====================================================
       * Position
       * =====================================================
       */

      const positionPrompt =
        (
          petRect
        ) => {

          if (
            prompt.hidden
          ) {
            return;
          }


          const promptRect =
            prompt
              .getBoundingClientRect();


          const margin =
            10;

          const gap =
            16;


          let left;

          let top;


          if (
            window.innerWidth <=
            700
          ) {

            left =
              (
                window.innerWidth -
                promptRect.width
              ) /
              2;


            top =
              window.innerHeight -
              promptRect.height -
              Math.max(
                12,
                window.innerHeight *
                0.03
              );

          } else {

            left =
              petRect.left +
              petRect.width /
              2 -
              promptRect.width /
              2;


            top =
              petRect.bottom +
              gap;


            if (
              top +
              promptRect.height >
              window.innerHeight -
              margin
            ) {

              top =
                petRect.top -
                promptRect.height -
                gap;
            }
          }


          left =
            clamp(
              left,
              margin,
              window.innerWidth -
              promptRect.width -
              margin
            );


          top =
            clamp(
              top,
              margin,
              window.innerHeight -
              promptRect.height -
              margin
            );


          prompt.style.left =
            `${left}px`;


          prompt.style.top =
            `${top}px`;
        };


      const positionControls =
        (
          petRect
        ) => {

          const rect =
            controls
              .getBoundingClientRect();


          const margin =
            8;

          const gap =
            10;


          const petCenterX =
            petRect.left +
            petRect.width /
            2;


          let left;


          if (
            petCenterX >
            window.innerWidth /
            2
          ) {

            left =
              petRect.left -
              rect.width -
              gap;

          } else {

            left =
              petRect.right +
              gap;
          }


          let top =
            petRect.top +
            petRect.height *
            0.58;


          left =
            clamp(
              left,
              margin,
              window.innerWidth -
              rect.width -
              margin
            );


          top =
            clamp(
              top,
              margin,
              window.innerHeight -
              rect.height -
              margin
            );


          controls.style.left =
            `${left}px`;


          controls.style.top =
            `${top}px`;
        };


      const positionSpeech =
        (
          petRect
        ) => {

          if (
            speech.hidden
          ) {
            return;
          }


          const bubbleRect =
            speech
              .getBoundingClientRect();


          const margin =
            10;

          const gap =
            14;


          let left =
            petRect.left +
            petRect.width /
            2 -
            bubbleRect.width /
            2;


          let top =
            petRect.top -
            bubbleRect.height -
            gap;


          if (
            top <
            margin
          ) {

            const roomRight =
              window.innerWidth -
              petRect.right;


            if (
              roomRight >=
              bubbleRect.width +
              gap
            ) {

              left =
                petRect.right +
                gap;

            } else {

              left =
                petRect.left -
                bubbleRect.width -
                gap;
            }


            top =
              petRect.top +
              petRect.height *
              0.1;
          }


          left =
            clamp(
              left,
              margin,
              window.innerWidth -
              bubbleRect.width -
              margin
            );


          top =
            clamp(
              top,
              margin,
              window.innerHeight -
              bubbleRect.height -
              margin
            );


          speech.style.left =
            `${left}px`;


          speech.style.top =
            `${top}px`;
        };


      const positionSettings =
        (
          petRect
        ) => {

          if (
            settings.hidden
          ) {
            return;
          }


          const rect =
            settings
              .getBoundingClientRect();


          const margin =
            10;

          const gap =
            18;


          let left =
            petRect.left +
            petRect.width /
            2 -
            rect.width /
            2;


          let top =
            petRect.top -
            rect.height -
            gap;


          if (
            window.innerWidth <=
            700
          ) {

            left =
              (
                window.innerWidth -
                rect.width
              ) /
              2;


            top =
              Math.max(
                12,
                (
                  window.innerHeight -
                  rect.height
                ) /
                2
              );

          } else if (
            top <
            margin
          ) {

            top =
              petRect.bottom +
              gap;
          }


          left =
            clamp(
              left,
              margin,
              window.innerWidth -
              rect.width -
              margin
            );


          top =
            clamp(
              top,
              margin,
              window.innerHeight -
              rect.height -
              margin
            );


          settings.style.left =
            `${left}px`;


          settings.style.top =
            `${top}px`;
        };


      function syncCompanionPosition() {

        const petRect =
          root
            .getBoundingClientRect();


        positionSpeech(
          petRect
        );


        positionPrompt(
          petRect
        );


        positionControls(
          petRect
        );


        positionSettings(
          petRect
        );
      }


      /*
       * =====================================================
       * Interaction
       * =====================================================
       */

      const interactionController =
        new PetInteractionController({
          root,
          canvas,
          stateMachine,
          hitTest,

          dragThreshold:
            6,

          viewportPadding:
            4,

          storageKey:
            "fjk-blog-pet-position-v1",
        });


      interactionController.onInteraction =
        (
          event
        ) => {

          root.dataset.interaction =
            event.type;


          if (
            event.type ===
            "drag-start"
          ) {

            root.dataset.dragging =
              "true";

          } else if (
            event.type ===
              "drag-end" ||
            event.type ===
              "pointer-cancel"
          ) {

            delete root.dataset.dragging;
          }


          if (
            event.type ===
              "drag-move" ||
            event.type ===
              "drag-end" ||
            event.type ===
              "viewport-resize"
          ) {

            requestAnimationFrame(
              syncCompanionPosition
            );
          }
        };


      interactionController.mount();


      /*
       * =====================================================
       * Settings
       * =====================================================
       */

      const updateConfigIndicator =
        () => {

          const configured =
            aiConfigStore
              .isConfigured();


          settingsTrigger.dataset.configured =
            configured
              ? "true"
              : "false";


          settingsTrigger.title =
            configured
              ? "AI 已配置"
              : "配置自己的 AI";


          return configured;
        };


      const fillSettings =
        () => {

          const config =
            aiConfigStore.get();


          if (
            config
          ) {

            providerSelect.value =
              config.provider;


            modelInput.value =
              config.model;


            apiKeyInput.value =
              config.apiKey;


            return;
          }


          providerSelect.value =
            "deepseek";


          modelInput.value =
            aiConfigStore
              .getDefaultModel(
                "deepseek"
              );


          apiKeyInput.value =
            "";
        };


      const openSettings =
        () => {

          fillSettings();


          settingsStatus.textContent =
            "";


          settings.hidden =
            false;


          prompt.hidden =
            true;


          chatTrigger
            .classList
            .remove(
              "is-open"
            );


          requestAnimationFrame(
            () => {

              syncCompanionPosition();


              providerSelect.focus();
            }
          );
        };


      const closeSettings =
        () => {

          settings.hidden =
            true;
        };


      providerSelect.addEventListener(
        "change",
        () => {

          const defaultModel =
            aiConfigStore
              .getDefaultModel(
                providerSelect.value
              );


          if (
            defaultModel
          ) {

            modelInput.value =
              defaultModel;

          } else {

            modelInput.value =
              "";
          }
        }
      );


      apiKeyToggle.addEventListener(
        "click",
        () => {

          const visible =
            apiKeyInput.type ===
            "text";


          apiKeyInput.type =
            visible
              ? "password"
              : "text";
        }
      );


      settingsTrigger.addEventListener(
        "click",
        () => {

          if (
            settings.hidden
          ) {

            openSettings();

          } else {

            closeSettings();
          }
        }
      );


      settingsClose.addEventListener(
        "click",
        closeSettings
      );


      settingsClear.addEventListener(
        "click",
        () => {

          aiConfigStore.clear();


          fillSettings();


          updateConfigIndicator();


          settingsStatus.textContent =
            "本次会话中的 AI 配置已清除。";


          setSpeech(
            "AI 配置已清除。"
          );
        }
      );


      settingsForm.addEventListener(
        "submit",
        (
          event
        ) => {

          event.preventDefault();


          const provider =
            providerSelect.value;


          const model =
            modelInput.value
              .trim();


          const apiKey =
            apiKeyInput.value
              .trim();


          if (
            !provider ||
            !model ||
            !apiKey
          ) {

            settingsStatus.textContent =
              "请完整填写 Provider、Model 和 API Key。";


            return;
          }


          try {

            aiConfigStore.save({
              provider,
              model,
              apiKey,
            });


            updateConfigIndicator();


            settingsStatus.textContent =
              "已保存。";


            closeSettings();


            setSpeech(
              "AI 配置已保存，本次浏览器会话中有效。"
            );


            openPrompt();

          } catch (error) {

            console.error(
              "[FJK AI Config]",
              error
            );


            settingsStatus.textContent =
              "配置保存失败。";
          }
        }
      );


      /*
       * =====================================================
       * HTTP Chat
       * =====================================================
       */

      const httpClient =
        new HttpChatClient({
          endpoint:
            "/api/chat",

          getConfig:
            () =>
              aiConfigStore.get(),
        });


      const chatController =
        new ChatController({
          client:
            httpClient,

          stateMachine,
        });


      chatController.onMessagesChange =
        () => {};


      chatController.onGeneratingChange =
        (
          generating
        ) => {

          input.disabled =
            generating;


          stopButton.hidden =
            !generating;


          sendButton.disabled =
            generating ||
            input.value
              .trim()
              .length === 0;


          prompt.dataset.generating =
            generating
              ? "true"
              : "false";
        };


      chatController.onBubbleChange =
        (
          content
        ) => {

          setSpeech(
            content
          );
        };


      chatController.onError =
        (
          error
        ) => {

          console.error(
            "[FJK Chat]",
            error
          );
        };


      /*
       * =====================================================
       * Prompt
       * =====================================================
       */

      function openPrompt() {

        if (
          !aiConfigStore
            .isConfigured()
        ) {

          setSpeech(
            "请先配置自己的 AI API。"
          );


          openSettings();


          return;
        }


        settings.hidden =
          true;


        prompt.hidden =
          false;


        chatTrigger
          .classList
          .add(
            "is-open"
          );


        requestAnimationFrame(
          () => {

            syncCompanionPosition();


            input.focus();
          }
        );
      }


      const closePrompt =
        () => {

          prompt.hidden =
            true;


          chatTrigger
            .classList
            .remove(
              "is-open"
            );
        };


      chatTrigger.addEventListener(
        "click",
        () => {

          if (
            !aiConfigStore
              .isConfigured()
          ) {

            openSettings();


            return;
          }


          if (
            prompt.hidden
          ) {

            openPrompt();

          } else {

            closePrompt();
          }
        }
      );


      closeButton.addEventListener(
        "click",
        closePrompt
      );


      stopButton.addEventListener(
        "click",
        () => {

          chatController.stop();
        }
      );


      /*
       * =====================================================
       * Input
       * =====================================================
       */

      const resizeInput =
        () => {

          input.style.height =
            "auto";


          const maxHeight =
            82;


          input.style.height =
            `${Math.min(
              input.scrollHeight,
              maxHeight
            )}px`;


          requestAnimationFrame(
            syncCompanionPosition
          );
        };


      input.addEventListener(
        "input",
        () => {

          sendButton.disabled =
            chatController.generating ||
            input.value
              .trim()
              .length === 0;


          resizeInput();
        }
      );


      input.addEventListener(
        "keydown",
        (
          event
        ) => {

          if (
            event.key ===
              "Enter" &&
            !event.shiftKey
          ) {

            event.preventDefault();


            if (
              !chatController.generating
            ) {

              prompt.requestSubmit();
            }
          }
        }
      );


      prompt.addEventListener(
        "submit",
        async (
          event
        ) => {

          event.preventDefault();


          if (
            !aiConfigStore
              .isConfigured()
          ) {

            setSpeech(
              "请先配置自己的 AI API。"
            );


            openSettings();


            return;
          }


          const content =
            input.value
              .trim();


          if (
            !content ||
            chatController.generating
          ) {
            return;
          }


          input.value =
            "";


          input.style.height =
            "auto";


          sendButton.disabled =
            true;


          await chatController.send(
            content
          );
        }
      );


      /*
       * =====================================================
       * Responsive
       * =====================================================
       */

      window.addEventListener(
        "resize",
        () => {

          requestAnimationFrame(
            syncCompanionPosition
          );
        }
      );


      window.visualViewport
        ?.addEventListener(
          "resize",
          () => {

            requestAnimationFrame(
              syncCompanionPosition
            );
          }
        );


      /*
       * =====================================================
       * Development Helpers
       * =====================================================
       */

      const listActions =
        () => {

          const ids =
            library.getIds();


          console.table(
            ids.map(
              (
                id,
                index
              ) => ({
                index:
                  index + 1,

                id,
              })
            )
          );


          return ids;
        };


      const listCatalog =
        () => {

          const catalogActions =
            actionSelector
              .getAvailableActions();


          console.table(
            catalogActions.map(
              (action) => ({
                id:
                  action.id,

                states:
                  action.states.join(
                    ", "
                  ),

                tags:
                  action.tags.join(
                    ", "
                  ),

                weight:
                  action.weight,
              })
            )
          );


          return catalogActions;
        };


      const playAction =
        async (
          actionId
        ) => {

          return stateMachine
            .playAction(
              actionId,
              {
                state:
                  PetStates.SPECIAL,

                loop:
                  false,

                reason:
                  "dev-play-action",
              }
            );
        };


      const playState =
        async (
          state,
          tags = []
        ) => {

          const normalizedState =
            String(
              state ??
              ""
            )
              .trim()
              .toUpperCase();


          if (
            !PetStates[
              normalizedState
            ]
          ) {

            throw new Error(
              `Unknown pet state: ${state}`
            );
          }


          return stateMachine
            .setState(
              PetStates[
                normalizedState
              ],
              {
                force:
                  true,

                tags:
                  Array.isArray(
                    tags
                  )
                    ? tags
                    : [
                        tags,
                      ],

                reason:
                  "dev-play-state",
              }
            );
        };


      const getCurrentPetState =
        () => ({
          state:
            stateMachine.currentState,

          previousState:
            stateMachine.previousState,

          action:
            stateMachine.currentAction?.id ??
            null,

          previousAction:
            stateMachine.previousAction?.id ??
            null,

          tags:
            stateMachine.currentAction?.tags ??
            [],
        });


      /*
       * 检查实时动作是否全部缓存。
       */

      const getRealtimeCacheStatus =
        () => {

          const createStatus =
            (
              preload
            ) => {

              return preload
                .candidates
                .map(
                  (action) => ({
                    state:
                      preload.state,

                    id:
                      action.id,

                    cached:
                      cache.has(
                        action.id
                      ),
                  })
                );
            };


          const rows =
            [
              {
                state:
                  PetStates.DRAGGING,

                id:
                  dragActionId,

                cached:
                  cache.has(
                    dragActionId
                  ),
              },

              ...createStatus(
                interactPreload
              ),

              ...createStatus(
                thinkingPreload
              ),

              ...createStatus(
                speakingPreload
              ),
            ];


          console.table(
            rows
          );


          return rows;
        };


      /*
       * =====================================================
       * Init
       * =====================================================
       */

      updateConfigIndicator();


      window.fjkPet = {
        petBasePath,
        loader,
        manifest,
        library,
        cache,

        renderer,
        audioManager,
        animator,
        actionSelector,
        stateMachine,

        hitTest,
        interactionController,

        aiConfigStore,
        httpClient,
        chatController,

        openPrompt,
        closePrompt,
        openSettings,
        closeSettings,
        syncCompanionPosition,

        listActions,
        listCatalog,
        playAction,
        playState,
        getCurrentPetState,

        getRealtimeCacheStatus,
      };


      root.dataset.ready =
        "true";


      requestAnimationFrame(
        syncCompanionPosition
      );


      console.log(
        "[FJK Pet] ready"
      );


      console.log(
        `[FJK Pet] resource: ${petBasePath}`
      );


      console.log(
        `[FJK Pet] loaded animations: ${library.size}`
      );


      console.log(
        `[FJK Pet] catalog available: ${
          actionSelector
            .getAvailableActions()
            .length
        }`
      );


      console.log(
        `[FJK Pet] realtime cache: drag=1, interact=${interactPreload.loaded}, thinking=${thinkingPreload.loaded}, speaking=${speakingPreload.loaded}`
      );


      console.log(
        "[FJK AI] BYOK configuration ready"
      );

    } catch (error) {

      console.error(
        "[FJK Pet] initialization failed",
        error
      );


      root.remove();

      speech.remove();

      controls.remove();

      prompt.remove();

      settings.remove();
    }
  }


  initDesktopPet();
</script>


